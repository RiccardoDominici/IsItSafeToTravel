// Fill the canonical country count into the per-language copy. The literal
// "240+" claims drifted from the real count (248) — 2026-08 SEO audit; all
// strings now carry a {countryCount} placeholder resolved from live data.
const countryCount = String(countries.length);
const c = JSON.parse(
  JSON.stringify(copy[lang]),
  (_key, value) => (typeof value === 'string' ? value.replaceAll('{countryCount}', countryCount) : value),
) as CiteCopy;
const canonicalUrl = `https://isitsafetotravel.org/${lang}/${r.cite}/`;

const breadcrumbItems = [
  { name: t('nav.home'), url: `https://isitsafetotravel.org/${lang}/` },
  { name: c.title, url: canonicalUrl },
];

const faqItems = [
  { question: c.faqQ1, answer: c.faqA1 },
  { question: c.faqQ2, answer: c.faqA2 },
  { question: c.faqQ3, answer: c.faqA3 },
  { question: c.faqQ4, answer: c.faqA4 },
];

const jsonLd = buildCitePageJsonLd(c.title, c.description, canonicalUrl, lang, breadcrumbItems, faqItems);

// Simple {token} interpolation shared by the SSR no-JS fallback below. The client
// script implements the same regex independently (it receives raw templates via
// the JSON island, not this function).
function interpolate(tmpl: string, vars: Record<string, string>): string {
  return tmpl.replace(/\{(\w+)\}/g, (_match, key: string) => (key in vars ? vars[key] : `{${key}}`));
}

// SSR fallback: interpolate every citation format for the first (alphabetical)
// country using the snapshot date, so crawlers and no-JS users see complete,
// valid citation strings. The <select> below marks this same country `selected`
// so the visible dropdown matches what's already rendered here.
const firstCountry = countries[0];
const firstIso = firstCountry?.iso3.toLowerCase() ?? '';
const firstName = firstCountry ? getLocalizedCountryName(firstCountry, lang) : '';
const firstScore = firstCountry ? firstCountry.score.toFixed(1) : '';
const firstUrl = `https://isitsafetotravel.org/${lang}/${r.country}/${firstIso}/`;

const initialVars: Record<string, string> = {
  name: firstName,
  score: firstScore,
  url: firstUrl,
  date: snapshotDate,
  year: snapshotYear,
  iso: firstIso,
};

const initialPlain = interpolate(c.plainTemplate, initialVars);
const initialHtml = interpolate(c.htmlTemplate, initialVars);
const initialMarkdown = interpolate(c.markdownTemplate, initialVars);
const initialApa = interpolate(c.apaTemplate, initialVars);
const initialMla = interpolate(c.mlaTemplate, initialVars);
const initialBibtex = interpolate(c.bibtexTemplate, initialVars);
const initialBadgeHtml = interpolate(c.badgeHtmlTemplate, initialVars);

// Templates handed to the client as data (not code) — the client script parses
// this JSON and interpolates it itself, so there is no hand-written escaped JS
// duplicating the tricky BibTeX/HTML strings above.
const tmplIsland = {
  plainTemplate: c.plainTemplate,
  markdownTemplate: c.markdownTemplate,
  htmlTemplate: c.htmlTemplate,
  apaTemplate: c.apaTemplate,
  mlaTemplate: c.mlaTemplate,
  bibtexTemplate: c.bibtexTemplate,
  badgeHtmlTemplate: c.badgeHtmlTemplate,
  globalPlainTemplate: c.globalPlainTemplate,
  globalMarkdownTemplate: c.globalMarkdownTemplate,
  globalHtmlTemplate: c.globalHtmlTemplate,
  globalApaTemplate,
  globalMlaTemplate,
  globalBibtexTemplate,
};

const outputFieldClass = 'w-full px-4 py-3 pr-20 rounded-lg border border-sand-300 dark:border-sand-600 bg-white dark:bg-sand-800 text-sand-800 dark:text-sand-100 font-mono text-xs';
const copyBtnClass = 'absolute top-2 right-2 px-3 py-1 text-xs font-medium rounded bg-terracotta-500 text-white hover:bg-terracotta-600 transition-colors';
const linkClass = 'text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline';
const ctaLinkClass = 'inline-flex items-center gap-1 text-sm font-medium text-terracotta-600 dark:text-terracotta-400 hover:underline';
---

<Base lang={lang} title={c.title} description={c.description} jsonLd={jsonLd}>
  <div class="max-w-4xl mx-auto px-4 py-8 space-y-8">
    <Breadcrumb lang={lang} items={[
      { label: t('nav.home'), href: `/${lang}/` },
      { label: c.title, href: '' },
    ]} />

    <header class="text-center space-y-4">
      <h1 class="text-3xl md:text-4xl font-heading font-bold text-sand-800 dark:text-sand-100">
        {c.title}
      </h1>
      <p class="text-base text-sand-600 dark:text-sand-400 max-w-2xl mx-auto">
        {c.intro}
      </p>
    </header>

    <!-- What you're citing -->
    <section>
      <h2 class="text-xl font-heading font-semibold text-sand-800 dark:text-sand-100 mb-3">{c.whatHeading}</h2>
      <p class="text-sand-700 dark:text-sand-300 leading-relaxed mb-2">{c.whatText}</p>
      <p class="text-sm text-sand-500 dark:text-sand-400">
        <a href={`/${lang}/${r.methodology}/`} class={linkClass}>{t('nav.methodology')}</a>
        {' · '}
        <a href={`/${lang}/${r.sources}/`} class={linkClass}>{t('nav.sources')}</a>
        {' · '}
        <a href={`/${lang}/${r.api}/`} class={linkClass}>API</a>
      </p>
    </section>

    <div class="max-w-xl mx-auto space-y-6">
      <!-- Control bar -->
      <section>
        <label for="cite-country" class="block text-sm font-medium text-sand-700 dark:text-sand-300 mb-2">
          {t('badge.select_country')}
        </label>
        <select
          id="cite-country"
          data-country-route={r.country}
          class="w-full px-4 py-3 rounded-lg border border-sand-300 dark:border-sand-600 bg-white dark:bg-sand-800 text-sand-800 dark:text-sand-100 focus:ring-2 focus:ring-terracotta-400"
        >
          <option value="__global__">{c.globalOption}</option>
          {countries.map((country, idx) => {
            const iso = country.iso3.toLowerCase();
            const name = getLocalizedCountryName(country, lang);
            return (
              <option value={iso} data-name={name} data-score={country.score.toFixed(1)} data-iso={iso} selected={idx === 0}>
                {name} ({country.score.toFixed(1)}/10)
              </option>
            );
          })}
        </select>
        <p class="mt-2 text-xs text-sand-500 dark:text-sand-400">{c.accessedNote}</p>
      </section>

      <!-- Visual badge preview (light; hidden when the whole dataset is selected) -->
      <section id="cite-badge-wrap">
        <h2 class="text-sm font-medium text-sand-700 dark:text-sand-300 mb-2">{t('badge.preview')}</h2>
        <div class="rounded-lg border border-sand-200 dark:border-sand-700 bg-sand-50 dark:bg-sand-900 p-6 flex items-center justify-center">
          <img id="cite-badge-preview" src={`/badge/${firstIso}.svg`} alt="Safety Badge Preview" width="300" height="80" />
        </div>
      </section>

      <!-- How to cite -->
      <section>
        <h2 class="text-xl font-heading font-semibold text-sand-800 dark:text-sand-100 mb-4">{c.howHeading}</h2>
        <div class="space-y-5">
          <div>
            <h3 class="text-sm font-medium text-sand-700 dark:text-sand-300 mb-2">{c.fmtPlain}</h3>
            <div class="relative">
              <textarea id="cite-plain" readonly rows="2" class={outputFieldClass}>{initialPlain}</textarea>
              <button type="button" data-copy="cite-plain" data-copied-label={t('badge.copied')} class={copyBtnClass}>{t('badge.copy')}</button>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-sand-700 dark:text-sand-300 mb-2">{c.fmtHtml}</h3>
            <div class="relative">
              <textarea id="cite-html" readonly rows="3" class={outputFieldClass}>{initialHtml}</textarea>
              <button type="button" data-copy="cite-html" data-copied-label={t('badge.copied')} class={copyBtnClass}>{t('badge.copy')}</button>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-sand-700 dark:text-sand-300 mb-2">{c.fmtMarkdown}</h3>
            <div class="relative">
              <textarea id="cite-md" readonly rows="2" class={outputFieldClass}>{initialMarkdown}</textarea>
              <button type="button" data-copy="cite-md" data-copied-label={t('badge.copied')} class={copyBtnClass}>{t('badge.copy')}</button>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-sand-700 dark:text-sand-300 mb-2">{c.fmtApa}</h3>
            <div class="relative">
              <textarea id="cite-apa" readonly rows="3" class={outputFieldClass}>{initialApa}</textarea>
              <button type="button" data-copy="cite-apa" data-copied-label={t('badge.copied')} class={copyBtnClass}>{t('badge.copy')}</button>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-sand-700 dark:text-sand-300 mb-2">{c.fmtMla}</h3>
            <div class="relative">
              <textarea id="cite-mla" readonly rows="2" class={outputFieldClass}>{initialMla}</textarea>
              <button type="button" data-copy="cite-mla" data-copied-label={t('badge.copied')} class={copyBtnClass}>{t('badge.copy')}</button>
            </div>
          </div>

          <div>
            <h3 class="text-sm font-medium text-sand-700 dark:text-sand-300 mb-2">{c.fmtBibtex}</h3>
            <div class="relative">
              <textarea id="cite-bibtex" readonly rows="7" class={outputFieldClass}>{initialBibtex}</textarea>
              <button type="button" data-copy="cite-bibtex" data-copied-label={t('badge.copied')} class={copyBtnClass}>{t('badge.copy')}</button>
            </div>
          </div>

          <div id="cite-badge-html-wrap">
            <h3 class="text-sm font-medium text-sand-700 dark:text-sand-300 mb-2">{c.fmtBadge}</h3>
            <div class="relative">
              <textarea id="cite-badge-html" readonly rows="3" class={outputFieldClass}>{initialBadgeHtml}</textarea>
              <button type="button" data-copy="cite-badge-html" data-copied-label={t('badge.copied')} class={copyBtnClass}>{t('badge.copy')}</button>
            </div>
            <a href={`/${lang}/${r['embed-badge']}/`} class={`${ctaLinkClass} mt-3`}>
              {c.badgeCta}
            </a>
          </div>
        </div>
      </section>
    </div>

    <!-- FAQ (visible mirror of the FAQPage JSON-LD) -->
    <section>
      <h2 class="text-xl font-heading font-semibold text-sand-800 dark:text-sand-100 mb-4">{c.faqHeading}</h2>
      <div class="space-y-4">
        <div>
          <h3 class="font-semibold text-sand-800 dark:text-sand-100 mb-1">{c.faqQ1}</h3>
          <p class="text-sand-700 dark:text-sand-300 leading-relaxed">
            {c.faqA1Lead}
            {' '}
            <a href={`/${lang}/${r.feedback}/`} class={linkClass}>{c.faqA1Commercial}</a>
          </p>
        </div>
        <div>
          <h3 class="font-semibold text-sand-800 dark:text-sand-100 mb-1">{c.faqQ2}</h3>
          <p class="text-sand-700 dark:text-sand-300 leading-relaxed">{c.faqA2}</p>
        </div>
        <div>
          <h3 class="font-semibold text-sand-800 dark:text-sand-100 mb-1">{c.faqQ3}</h3>
          <p class="text-sand-700 dark:text-sand-300 leading-relaxed">{c.faqA3}</p>
        </div>
        <div>
          <h3 class="font-semibold text-sand-800 dark:text-sand-100 mb-1">{c.faqQ4}</h3>
          <p class="text-sand-700 dark:text-sand-300 leading-relaxed">{c.faqA4}</p>
        </div>
      </div>
    </section>

    <!-- License & attribution -->
    <section>
      <h2 class="text-xl font-heading font-semibold text-sand-800 dark:text-sand-100 mb-3">{c.licenseHeading}</h2>
      <p class="text-sand-700 dark:text-sand-300 leading-relaxed mb-2">
        {c.licenseText}
        {' '}
        <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener noreferrer" class={linkClass}>CC BY-NC 4.0</a>
      </p>
      <p class="text-sand-700 dark:text-sand-300 leading-relaxed">
        {c.attributionText}
        {' '}
        <a href={`/${lang}/${r.legal}/`} class={linkClass}>{t('footer.legal')}</a>
      </p>
    </section>

    <!-- Closing CTA row -->
    <div class="flex flex-wrap gap-x-6 gap-y-2 justify-center pt-2">
      <a href={`/${lang}/${r.api}/`} class={ctaLinkClass}>{c.ctaApiLabel}</a>
      <a href={`/${lang}/${r['embed-badge']}/`} class={ctaLinkClass}>{c.badgeCta}</a>
    </div>
  </div>
</Base>

<script type="application/json" id="cite-tmpl" set:html={JSON.stringify(tmplIsland)} />

<script>
  const tmplEl = document.getElementById('cite-tmpl');
  const tmpl: Record<string, string> = tmplEl ? JSON.parse(tmplEl.textContent || '{}') : {};

  const select = document.getElementById('cite-country') as HTMLSelectElement | null;
  const badgeWrap = document.getElementById('cite-badge-wrap');
  const badgePreview = document.getElementById('cite-badge-preview') as HTMLImageElement | null;
  const badgeHtmlWrap = document.getElementById('cite-badge-html-wrap');

  function interpolate(str: string, vars: Record<string, string>): string {
    return str.replace(/\{(\w+)\}/g, (_match, key: string) => (key in vars ? vars[key] : `{${key}}`));
  }

  function setOutput(id: string, value: string) {
    const el = document.getElementById(id) as HTMLTextAreaElement | null;
    if (el) el.value = value;
  }

  function updateCite() {
    if (!select) return;
    const isGlobal = select.value === '__global__';
    const option = select.selectedOptions[0];
    const iso = isGlobal ? 'global' : select.value;
    const name = isGlobal ? '' : option?.dataset.name || '';
    const score = isGlobal ? '' : option?.dataset.score || '';
    const docLang = document.documentElement.lang || 'en';
    const countryRoute = select.dataset.countryRoute || 'country';
    const url = isGlobal
      ? 'https://isitsafetotravel.org/'
      : `https://isitsafetotravel.org/${docLang}/${countryRoute}/${iso}/`;
    const date = new Date().toISOString().slice(0, 10);
    const year = String(new Date().getFullYear());

    const vars: Record<string, string> = { name, score, url, date, year, iso };

    // Whole-dataset citations use their own templates (no subject substitution).
    setOutput('cite-plain', interpolate((isGlobal ? tmpl.globalPlainTemplate : tmpl.plainTemplate) || '', vars));
    setOutput('cite-html', interpolate((isGlobal ? tmpl.globalHtmlTemplate : tmpl.htmlTemplate) || '', vars));
    setOutput('cite-md', interpolate((isGlobal ? tmpl.globalMarkdownTemplate : tmpl.markdownTemplate) || '', vars));
    setOutput('cite-apa', interpolate((isGlobal ? tmpl.globalApaTemplate : tmpl.apaTemplate) || '', vars));
    setOutput('cite-mla', interpolate((isGlobal ? tmpl.globalMlaTemplate : tmpl.mlaTemplate) || '', vars));
    setOutput('cite-bibtex', interpolate((isGlobal ? tmpl.globalBibtexTemplate : tmpl.bibtexTemplate) || '', vars));

    if (badgeWrap) (badgeWrap as HTMLElement).hidden = isGlobal;
    if (badgeHtmlWrap) (badgeHtmlWrap as HTMLElement).hidden = isGlobal;
    if (!isGlobal) {
      if (badgePreview) badgePreview.src = `/badge/${iso}.svg`;
      setOutput('cite-badge-html', interpolate(tmpl.badgeHtmlTemplate || '', vars));
    }
  }

  // Deep-link: #c=<iso3> pre-selects a country if it exists in the list;
  // an unknown/absent hash silently falls back to the default selection.
  if (select) {
    const hashIso = location.hash.replace('#c=', '').toLowerCase();
    if (hashIso && Array.from(select.options).some((o) => o.value === hashIso)) {
      select.value = hashIso;
    }
    select.addEventListener('change', updateCite);
  }

  updateCite();

  // Copy buttons (reuses embed-badge's [data-copy] pattern).
  document.querySelectorAll('[data-copy]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const targetId = (btn as HTMLElement).dataset.copy!;
      const textarea = document.getElementById(targetId) as HTMLTextAreaElement | null;
      if (!textarea) return;
      try {
        await navigator.clipboard.writeText(textarea.value);
        const original = btn.textContent;
        btn.textContent = (btn as HTMLElement).dataset.copiedLabel || 'Copied!';
        setTimeout(() => { btn.textContent = original; }, 2000);
      } catch {
        textarea.select();
      }
    });
  });
</script>
