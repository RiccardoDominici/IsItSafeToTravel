---
import type { Lang } from '../i18n/ui';
import { routes } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { loadLatestScores, getLocalizedCountryName } from '../lib/scores';
import { getLastmodMap } from '../lib/lastmod';
import { buildCitePageJsonLd } from '../lib/seo';
import Base from '../layouts/Base.astro';
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
const countries = loadLatestScores().sort((a, b) =>
  getLocalizedCountryName(a, lang).localeCompare(getLocalizedCountryName(b, lang)),
);
const snapshotDate = getLastmodMap().snapshotDate;
const parsedSnapshotYear = new Date(`${snapshotDate}T00:00:00Z`).getFullYear();
const snapshotYear = String(Number.isNaN(parsedSnapshotYear) ? new Date().getFullYear() : parsedSnapshotYear);

// Academic citation styles (APA/MLA/BibTeX) are English-language standards and the
// dataset name is the English "IsItSafeToTravel" — these three templates (plus the
// badge HTML snippet) are intentionally IDENTICAL across all 7 languages; only
// {name}/{url}/{date}/{year}/{iso} vary. Defined once and referenced per-language
// below so the copy Record<Lang,...> still carries the field for every locale.
const apaTemplate = 'IsItSafeToTravel. ({year}). {name} travel safety score [Data set]. IsItSafeToTravel.org. Retrieved {date}, from {url}';
const mlaTemplate = '"{name} Travel Safety Score." IsItSafeToTravel.org, {url}. Accessed {date}.';
// BibTeX field values are double-braced ({{...}}) to protect capitalization, a
// common BibTeX/BibLaTeX convention. \\url renders as a single backslash + "url"
// (a literal LaTeX \url{} command) at runtime.
const bibtexTemplate = `@misc{isafe_{iso}_{year},
  title  = {{{name} Travel Safety Score}},
  author = {{IsItSafeToTravel.org}},
  year   = {{{year}}},
  howpublished = {\\url{{url}}},
  note   = {Data set, updated daily. Accessed {date}}
}`;
const badgeHtmlTemplate = '<a href="{url}"><img src="https://isitsafetotravel.org/badge/{iso}.svg" alt="{name} Safety Score" width="300" height="80"></a>';

// Whole-dataset ("global") citations get their own templates instead of reusing the
// per-country ones with a substituted subject — composing "{name} travel-safety score"
// with a subject that already contains the word "scores" reads as a duplicated phrase
// in every language. Academic formats stay shared English, like their per-country twins.
const globalApaTemplate = 'IsItSafeToTravel. ({year}). Global travel safety scores [Data set]. IsItSafeToTravel.org. Retrieved {date}, from {url}';
const globalMlaTemplate = '"Global Travel Safety Scores." IsItSafeToTravel.org, {url}. Accessed {date}.';
const globalBibtexTemplate = `@misc{isafe_global_{year},
  title  = {{Global Travel Safety Scores}},
  author = {{IsItSafeToTravel.org}},
  year   = {{{year}}},
  howpublished = {\\url{{url}}},
  note   = {Data set, updated daily. Accessed {date}}
}`;

// Page copy is inlined per-language (same pattern as ApiDocs.astro / RegionsIndex)
// to avoid threading ~35 more keys through the large i18n/ui.ts table. A shared
// component reads its copy once, so there is no duplication cost.
