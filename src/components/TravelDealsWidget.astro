---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { TRAVELPAYOUTS_MARKER } from '../config/affiliate';

interface Props {
  lang: Lang;
  destinationIata?: string;
  destinationCityName?: string;
  countryName?: string;
  mode?: 'country' | 'home';
}

const { lang, destinationIata, destinationCityName, countryName, mode = 'home' } = Astro.props;
const t = useTranslations(lang);

// Aviasales only supports a fixed set of locales: en, en-us, en-gb, ru, de, es, fr, pl.
// For unsupported site langs (it, pt, zh) we fall back to English — better a known
// language than letting Aviasales pick whatever (was defaulting to Russian).
const aviasalesLocaleMap: Record<Lang, string> = {
  en: 'en',
  de: 'de',
  es: 'es',
  fr: 'fr',
  it: 'en',
  pt: 'en',
  zh: 'en',
};
const aviasalesLocale = aviasalesLocaleMap[lang];

const departDate = new Date();
departDate.setDate(departDate.getDate() + 30);
const defaultDepartDate = departDate.toISOString().split('T')[0];

const heading = mode === 'country' && countryName
  ? t('deals.widget.cta_country').replace('{name}', countryName)
  : t('deals.widget.cta_home');

const formId = `td-${Math.random().toString(36).slice(2, 8)}`;

// On home mode there's no specific destination, so the form is just a CTA — opens
// Aviasales home where the user picks their own search. On country mode the form
// pre-fills destination_iata + depart_date so the search results page opens directly.
const action = mode === 'country'
  ? 'https://search.aviasales.com/flights/'
  : 'https://www.aviasales.com/';
---

<form
  id={formId}
  action={action}
  method="GET"
  target="_blank"
  rel="noopener noreferrer sponsored"
  class="flex items-center gap-2 sm:gap-3 px-3 py-2 sm:px-4 sm:py-2.5 rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-900 text-sm"
>
  <input type="hidden" name="marker" value={TRAVELPAYOUTS_MARKER} />
  <input type="hidden" name="locale" value={aviasalesLocale} />

  {mode === 'country' && (
    <>
      <input type="hidden" name="adults" value="1" />
      <input type="hidden" name="depart_date" value={defaultDepartDate} />
      {destinationIata && <input type="hidden" name="destination_iata" value={destinationIata} />}
    </>
  )}

  <svg class="w-4 h-4 shrink-0 text-terracotta-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>
  </svg>

  <span class="flex-1 min-w-0 truncate text-sand-800 dark:text-sand-100 font-medium">
    {heading}{destinationCityName && destinationIata ? <span class="text-sand-500 dark:text-sand-400 font-normal"> · {destinationCityName} ({destinationIata})</span> : null}
  </span>

  <button
    type="submit"
    class="shrink-0 inline-flex items-center gap-1 bg-terracotta-500 hover:bg-terracotta-600 text-white font-medium rounded-md px-3 py-1.5 transition-colors"
  >
    <span>{t('deals.widget.search_btn')}</span>
    <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14M13 5l7 7-7 7"/>
    </svg>
  </button>
</form>
