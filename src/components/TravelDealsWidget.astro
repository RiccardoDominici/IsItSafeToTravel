---
/**
 * TravelDealsWidget — Aviasales-powered flight search box.
 *
 * Submits a plain GET form directly to https://search.aviasales.com/flights/
 * with the Travelpayouts marker, locale, destination, departure date and
 * adult count. No JavaScript needed; the browser builds the query string
 * from the form's hidden + visible inputs.
 *
 * Tracking is handled sitewide by the tp-em.com script in Base.astro, so
 * this widget just needs the marker in the URL.
 */
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { TRAVELPAYOUTS_MARKER } from '../config/affiliate';

interface Props {
  lang: Lang;
  destinationIata?: string;
  destinationCityName?: string;
  countryName?: string;
  mode?: 'country' | 'home';
}

const { lang, destinationIata, destinationCityName, countryName, mode = 'home' } = Astro.props;
const t = useTranslations(lang);

// Aviasales locale codes — most match ISO codes but English uses 'en-us'
// and Chinese uses 'zh-cn'.
const aviasalesLocale = lang === 'en' ? 'en-us' : lang === 'zh' ? 'zh-cn' : lang;

// Default departure: today + 30 days, formatted YYYY-MM-DD
const departDate = new Date();
departDate.setDate(departDate.getDate() + 30);
const defaultDepartDate = departDate.toISOString().split('T')[0];

// Heading: country mode shows "Find safe flights to {country}"; home mode generic
const heading = mode === 'country' && countryName
  ? t('deals.widget.cta_country').replace('{name}', countryName)
  : t('deals.widget.cta_home');

// Unique form id to avoid clashes if the widget appears more than once on a page
const formId = `td-form-${Math.random().toString(36).slice(2, 8)}`;
---

<section class="bg-sand-50 dark:bg-sand-800 rounded-2xl shadow-md p-6 my-8">
  <div class="text-center mb-4">
    <h3 class="text-xl md:text-2xl font-heading font-bold text-sand-800 dark:text-sand-100">
      {heading}
    </h3>
    <p class="text-xs text-sand-500 dark:text-sand-400 mt-1">
      {t('deals.widget.title')} · Powered by Aviasales / Travelpayouts
    </p>
  </div>

  <form
    id={formId}
    action="https://search.aviasales.com/flights/"
    method="GET"
    target="_blank"
    rel="noopener noreferrer sponsored"
    class="flex flex-col md:flex-row md:items-end gap-3 md:gap-2"
  >
    <input type="hidden" name="marker" value={TRAVELPAYOUTS_MARKER} />
    <input type="hidden" name="locale" value={aviasalesLocale} />
    <input type="hidden" name="adults" value="1" />

    {/* Destination field */}
    <div class="flex-1 min-w-0">
      <label class="block text-xs font-medium text-sand-600 dark:text-sand-300 mb-1" for={`${formId}-dest`}>
        {t('deals.widget.destination')}
      </label>
      {destinationIata ? (
        <>
          <input type="hidden" name="destination_iata" value={destinationIata} />
          <div
            id={`${formId}-dest`}
            class="w-full rounded-lg border border-sand-200 dark:border-sand-600 bg-white dark:bg-sand-900 px-3 py-2 text-sand-800 dark:text-sand-100 font-medium"
          >
            {destinationCityName ?? destinationIata} <span class="text-sand-400 dark:text-sand-500 text-sm">({destinationIata})</span>
          </div>
        </>
      ) : (
        <>
          <input
            id={`${formId}-dest`}
            type="text"
            name="destination_iata"
            placeholder="ROM, NYC, TYO…"
            maxlength="3"
            pattern="[A-Za-z]{3}"
            required
            class="w-full uppercase rounded-lg border border-sand-200 dark:border-sand-600 bg-white dark:bg-sand-900 px-3 py-2 text-sand-800 dark:text-sand-100 focus:outline-none focus:ring-2 focus:ring-terracotta-400"
          />
          <p class="text-[11px] text-sand-400 dark:text-sand-500 mt-1">
            3-letter IATA city code
          </p>
        </>
      )}
    </div>

    {/* Departure date */}
    <div class="md:w-44">
      <label class="block text-xs font-medium text-sand-600 dark:text-sand-300 mb-1" for={`${formId}-depart`}>
        {t('deals.widget.departure')}
      </label>
      <input
        id={`${formId}-depart`}
        type="date"
        name="depart_date"
        required
        value={defaultDepartDate}
        class="w-full rounded-lg border border-sand-200 dark:border-sand-600 bg-white dark:bg-sand-900 px-3 py-2 text-sand-800 dark:text-sand-100 focus:outline-none focus:ring-2 focus:ring-terracotta-400"
      />
    </div>

    {/* Return date (optional) */}
    <div class="md:w-44">
      <label class="block text-xs font-medium text-sand-600 dark:text-sand-300 mb-1" for={`${formId}-return`}>
        {t('deals.widget.return')}
      </label>
      <input
        id={`${formId}-return`}
        type="date"
        name="return_date"
        class="w-full rounded-lg border border-sand-200 dark:border-sand-600 bg-white dark:bg-sand-900 px-3 py-2 text-sand-800 dark:text-sand-100 focus:outline-none focus:ring-2 focus:ring-terracotta-400"
      />
    </div>

    {/* Passengers — fixed to 1 adult for MVP */}
    <div class="md:w-28">
      <label class="block text-xs font-medium text-sand-600 dark:text-sand-300 mb-1">
        &nbsp;
      </label>
      <div class="rounded-lg border border-sand-200 dark:border-sand-600 bg-white dark:bg-sand-900 px-3 py-2 text-sand-600 dark:text-sand-300 text-sm">
        {t('deals.widget.passengers')}
      </div>
    </div>

    <button
      type="submit"
      class="bg-terracotta-500 hover:bg-terracotta-600 text-white font-semibold rounded-lg px-6 py-3 transition-colors md:self-end"
    >
      {t('deals.widget.search_btn')}
    </button>
  </form>
</section>
