---
import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  destinationIata?: string;
  destinationCityName?: string;
  countryName?: string;
  mode?: 'country' | 'home';
}

// Props are accepted for backward compat with country/home pages but the widget
// content is fully driven by dashboard params (locale=en, city_id=2, etc.) — the
// per-page destination prefill from the previous custom form is no longer wired.
// Reason for the swap: the custom form pointed at search.aviasales.com/flights/
// which geo-redirects EU users to aviasales.ru ignoring the locale URL param.
// The dashboard widget renders its own UI server-side and handles attribution
// via the marker baked into the script URL.
const _ = Astro.props;
---

<div
  class="my-2 px-3 py-2 sm:px-4 sm:py-3 rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-900"
>
  <script
    is:inline
    async
    src="https://tpwidg.com/content?currency=USD&trs=526093&shmarker=725669&locale=en&city_id=2&category=4&amount=3&powered_by=true&campaign_id=137&promo_id=4497"
    charset="utf-8"
  ></script>
</div>
