---
import type { PillarName } from '../pipeline/types';
import type { Lang } from '../i18n/ui';
import type { IndexRow } from '../lib/travel-safety-index-data';
import { routes } from '../i18n/ui';
import { getLocalizedCountryName } from '../lib/scores';
import { getBandVerdictCopy } from '../lib/band-copy';
import { badgeColors } from '../lib/colors';

interface Props {
  row: IndexRow;
  lang: Lang;
}

const { row, lang } = Astro.props;
const { rank, country, region, delta } = row;
const r = routes[lang];
const countryUrl = `/${lang}/${r.country}/${country.iso3.toLowerCase()}/`;
const { riskLabel } = getBandVerdictCopy(country.score, lang);

// Small text-xs chip, so it needs the full 4.5:1 -- the plain gradient +
// readableTextColor combo has a dead zone (score ~4.7-4.9, and again ~8.7-10)
// where neither white nor dark text reaches it; badgeColors() darkens the
// background just enough to guarantee AA there (2026-09 contrast fix).
const { bg: badgeBg, fg: badgeFg } = badgeColors(country.score);

const PILLAR_ORDER: PillarName[] = ['conflict', 'crime', 'health', 'governance', 'environment'];
const pillarValues = PILLAR_ORDER.map((name) => {
  const pillar = country.pillars.find((p) => p.name === name);
  // Same 0-1 -> 1-10 transform used everywhere else on the site for pillar
  // display (SafetyMap.astro's tooltip, src/lib/dataset-csv.ts).
  return pillar ? (pillar.score * 9 + 1).toFixed(1) : '–';
});

function deltaClasses(d: number): string {
  if (d > 0) return 'text-emerald-700 dark:text-emerald-400';
  if (d < 0) return 'text-red-700 dark:text-red-400';
  return 'text-sand-600 dark:text-sand-400';
}
---

<tr data-region={region} data-score={country.score} class="border-b border-sand-200 dark:border-sand-700 hover:bg-sand-100/60 dark:hover:bg-sand-800/60">
  <td class="py-2 pr-3 text-sand-600 dark:text-sand-400 font-semibold tabular-nums whitespace-nowrap">{rank}</td>
  <td class="py-2 pr-4 font-medium text-sand-800 dark:text-sand-100 whitespace-nowrap">
    <a href={countryUrl} class="hover:text-terracotta-500 dark:hover:text-terracotta-400 hover:underline">
      {getLocalizedCountryName(country, lang)}
    </a>
  </td>
  <td class="py-2 pr-4 whitespace-nowrap">
    <span
      class="inline-flex items-center justify-center min-w-[3rem] px-2 py-0.5 rounded-full text-xs font-bold tabular-nums"
      style={`background-color:${badgeBg};color:${badgeFg}`}
    >
      {country.score.toFixed(1)}
    </span>
  </td>
  <td class="py-2 pr-4 text-sand-600 dark:text-sand-300 whitespace-nowrap capitalize">{riskLabel}</td>
  <td class="py-2 pr-4 text-sand-600 dark:text-sand-300 text-right tabular-nums">{pillarValues[0]}</td>
  <td class="py-2 pr-4 text-sand-600 dark:text-sand-300 text-right tabular-nums">{pillarValues[1]}</td>
  <td class="py-2 pr-4 text-sand-600 dark:text-sand-300 text-right tabular-nums">{pillarValues[2]}</td>
  <td class="py-2 pr-4 text-sand-600 dark:text-sand-300 text-right tabular-nums">{pillarValues[3]}</td>
  <td class="py-2 pr-4 text-sand-600 dark:text-sand-300 text-right tabular-nums">{pillarValues[4]}</td>
  <td class="py-2 pr-2 text-right whitespace-nowrap tabular-nums">
    {delta === null ? (
      <span class="text-sand-600 dark:text-sand-400">–</span>
    ) : Math.abs(delta) < 0.005 ? (
      // Rounds to "0.00" at the 2-decimal display precision below — show it as
      // flat, not a colored +/- arrow (a delta of e.g. -0.001 would otherwise
      // render as a red "▼ -0.00", which reads as a decline that isn't there).
      <span class="text-sand-600 dark:text-sand-400">0.00</span>
    ) : (
      <span class={`inline-flex items-center gap-0.5 font-semibold ${deltaClasses(delta)}`}>
        <span aria-hidden="true">{delta > 0 ? '▲' : '▼'}</span>
        {delta > 0 ? '+' : ''}{delta.toFixed(2)}
      </span>
    )}
  </td>
</tr>
