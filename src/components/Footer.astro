---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { routes } from '../i18n/ui';
import { buildAffiliateUrl } from '../config/affiliate';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
const regionsLabel = ({ en: 'Regions', it: 'Regioni', es: 'Regiones', fr: 'Régions', pt: 'Regiões', zh: '地区', de: 'Regionen' } as Record<Lang, string>)[lang];
const apiLabel = ({ en: 'Data & API', it: 'Dati e API', es: 'Datos y API', fr: 'Données et API', pt: 'Dados e API', zh: '数据与 API', de: 'Daten & API' } as Record<Lang, string>)[lang];
const citeLabel = ({ en: 'Cite this data', it: 'Cita questi dati', es: 'Citar datos', fr: 'Citer les données', pt: 'Citar dados', zh: '引用数据', de: 'Daten zitieren' } as Record<Lang, string>)[lang];
// /news/ and /global-safety/ had exactly 1 inlink each (the homepage teaser widget only) —
// absent from header AND footer, so no page but the homepage links back to them (2026-09
// audit, IL-1). Labels follow the same component-local per-locale pattern as regionsLabel
// above (no dedicated short-label i18n key exists yet); route slugs come from routes[lang].
const newsLabel = ({ en: 'News', it: 'Notizie', es: 'Noticias', fr: 'Actualités', pt: 'Notícias', zh: '新闻', de: 'Nachrichten' } as Record<Lang, string>)[lang];
const globalSafetyLabel = ({ en: 'Global Safety', it: 'Sicurezza Globale', es: 'Seguridad Global', fr: 'Sécurité Mondiale', pt: 'Segurança Global', zh: '全球安全', de: 'Globale Sicherheit' } as Record<Lang, string>)[lang];
const currentYear = new Date().getFullYear();
const affiliateUrl = buildAffiliateUrl();
---

<footer class="bg-sand-100 dark:bg-sand-800 border-t border-sand-200 dark:border-sand-700 mt-auto">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Disclaimer -->
    <p class="text-sm text-sand-600 dark:text-sand-300 mb-6 max-w-3xl">
      {t('footer.disclaimer')}
    </p>

    <!-- Links -->
    <div class="flex flex-wrap gap-6 mb-6">
      <a
        href={`/${lang}/${r['safest-countries']}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {t('hub.safest_countries.title' as any)}
      </a>
      <a
        href={`/${lang}/${r['most-dangerous-countries']}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {t('hub.dangerous_countries.title' as any)}
      </a>
      <a
        href={`/${lang}/${r['regions']}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {regionsLabel}
      </a>
      <a
        href={`/${lang}/${r['global-safety']}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {globalSafetyLabel}
      </a>
      <a
        href={`/${lang}/${r['news']}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {newsLabel}
      </a>
      <a
        href={`/${lang}/${r['embed-badge']}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {t('badge.title' as any)}
      </a>
      <a
        href={`/${lang}/${r.methodology}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {t('footer.methodology')}
      </a>
      <a
        href={`/${lang}/${r.about}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {t('footer.about')}
      </a>
      <a
        href={`/${lang}/${r.legal}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {t('footer.legal')}
      </a>
      <button
        type="button"
        id="cookie-prefs-link"
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {t('cookie.prefs')}
      </button>
      <a
        href={`/${lang}/${r.feedback}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {t('footer.feedback')}
      </a>
      <a
        href={`/${lang}/${r.sources}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {t('footer.sources')}
      </a>
      <a
        href={`/${lang}/${r['api']}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {apiLabel}
      </a>
      <a
        href={`/${lang}/${r.cite}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {citeLabel}
      </a>
      <a
        href={affiliateUrl}
        target="_blank"
        rel="noopener noreferrer sponsored"
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
      >
        {t('donate.travelpayouts_btn' as any)}
      </a>
    </div>

    <!-- Copyright -->
    <p class="text-xs text-sand-600 dark:text-sand-300">
      &copy; {currentYear} IsItSafeToTravel. All rights reserved.
    </p>
  </div>
</footer>

<script>
  function initCookiePrefsLink() {
    const btn = document.getElementById('cookie-prefs-link');
    if (!btn || (btn as HTMLElement).dataset.jsInit === '1') return;
    (btn as HTMLElement).dataset.jsInit = '1';
    btn.addEventListener('click', () => {
      if (typeof (window as any).__reopenCookieBanner === 'function') {
        (window as any).__reopenCookieBanner();
      }
    });
  }

  initCookiePrefsLink();
  document.addEventListener('astro:after-swap', initCookiePrefsLink);
</script>
