---
import type { Lang } from '../i18n/ui';
import { routes } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import Base from '../layouts/Base.astro';
import Breadcrumb from './Breadcrumb.astro';
import SafetyMap from './SafetyMap.astro';
import IndexTableRow from './IndexTableRow.astro';
import { getTravelSafetyIndexData } from '../lib/travel-safety-index-data';
import { travelSafetyIndexCopy } from '../i18n/travel-safety-index-copy';
import { getLocalizedCountryName } from '../lib/scores';
import { getEnglishCountryPhrase } from '../i18n/country-grammar';
import { SOURCE_COUNT_DISPLAY } from '../lib/site-stats';
import { buildTravelSafetyIndexJsonLd } from '../lib/seo';
import type { Region } from '../lib/regions';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
const c = travelSafetyIndexCopy[lang];
const data = getTravelSafetyIndexData();

// The year comes from the SNAPSHOT date, never the build/system clock (per
// spec: title/H1/URL must track the data, not the day the site happened to
// be built).
const snapshotDateObj = new Date(`${data.date}T00:00:00Z`);
const year = snapshotDateObj.getUTCFullYear();

const dateLocaleMap: Record<Lang, string> = {
  en: 'en-US', it: 'it-IT', es: 'es-ES', fr: 'fr-FR', pt: 'pt-BR', zh: 'zh-CN', de: 'de-DE',
};
const dateFormatted = snapshotDateObj.toLocaleDateString(dateLocaleMap[lang], {
  year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});

// English needs "the" for ~15 plural/union country names in subject position
// ("the United States scores…") — same helper HubPageLayout's buildBlurb uses.
function subjectName(country: typeof data.safest): string {
  const bare = getLocalizedCountryName(country, lang);
  return lang === 'en' ? getEnglishCountryPhrase(country.iso3, bare) : bare;
}

const vars: Record<string, string> = {
  countryCount: String(data.countryCount),
  includedCount: String(data.includedCount),
  excludedCount: String(data.excludedCount),
  sourceCount: SOURCE_COUNT_DISPLAY,
  date: dateFormatted,
  safest: subjectName(data.safest),
  safestScore: data.safest.score.toFixed(1),
  leastSafe: subjectName(data.leastSafe),
  leastSafeScore: data.leastSafe.score.toFixed(1),
};

/** Same {token} interpolation as seo.ts's getCountryFaqData. */
function fill(tpl: string, extra: Record<string, string> = vars): string {
  return tpl.replace(/\{(\w+)\}/g, (m, key: string) => (key in extra ? extra[key] : m));
}

const title = c.title(year);
const description = fill(c.description);
const h1 = c.h1(year);
const canonicalUrl = `https://isitsafetotravel.org/${lang}/${r['travel-safety-index']}/`;

const crumbs = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: title, href: '' },
];

// Top 50 for the ItemList JSON-LD node (per spec — the visible table below
// shows the full ranking, this is just the structured-data summary of it).
const itemListEntries = data.rows.slice(0, 50).map((row) => ({
  name: getLocalizedCountryName(row.country, lang),
  url: `https://isitsafetotravel.org/${lang}/${r.country}/${row.country.iso3.toLowerCase()}/`,
}));

const faqItems = [
  { question: c.faqWhatQ, answer: fill(c.faqWhatA) },
  { question: c.faqUpdateQ, answer: fill(c.faqUpdateA) },
  { question: c.faqSafestQ, answer: fill(c.faqSafestA) },
  { question: c.faqGpiQ, answer: c.faqGpiA },
  { question: c.faqUseQ, answer: c.faqUseA },
  { question: c.faqExcludedQ, answer: fill(c.faqExcludedA) },
];

const jsonLd = buildTravelSafetyIndexJsonLd(title, description, canonicalUrl, lang, data.date, itemListEntries, faqItems);

const REGION_ORDER: Region[] = ['europe', 'asia', 'africa', 'americas', 'oceania', 'middle_east'];

const regionBtnBase = 'px-2.5 py-1 rounded-full text-xs font-medium border transition-colors cursor-pointer';
const regionBtnActive = 'bg-terracotta-500 text-white border-terracotta-500';
const regionBtnInactive = 'bg-transparent text-sand-600 dark:text-sand-300 border-sand-300 dark:border-sand-600 hover:bg-sand-200 dark:hover:bg-sand-700';

const downloadLinkClass = 'flex items-center justify-between gap-2 rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-800 px-4 py-3 text-sm font-medium text-sand-700 dark:text-sand-200 hover:border-terracotta-400 dark:hover:border-terracotta-500 transition-colors';
const linkClass = 'text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline';
---

<Base lang={lang} title={title} description={description} jsonLd={jsonLd} ogImage="/og/default.png">
  <div class="max-w-6xl mx-auto px-4 py-8 space-y-10">
    <Breadcrumb lang={lang} items={crumbs} />

    <header class="text-center space-y-4 max-w-3xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-heading font-bold text-sand-800 dark:text-sand-100">
        {h1}
      </h1>
      <p class="text-base text-sand-700 dark:text-sand-300 leading-relaxed">
        {fill(c.summary1)}
      </p>
      <p class="text-base text-sand-700 dark:text-sand-300 leading-relaxed">
        {fill(c.summary2)}
      </p>
    </header>

    <!-- World map (same SafetyMap component the homepage uses, unforked) -->
    <section>
      <h2 class="text-lg font-heading font-bold text-sand-800 dark:text-sand-100 mb-3 text-center">
        {c.mapHeading}
      </h2>
      <div class="rounded-xl border border-sand-200 dark:border-sand-700 overflow-hidden h-[420px] sm:h-[500px] md:h-[600px]">
        <SafetyMap lang={lang} />
      </div>
    </section>

    <!-- Full ranking -->
    <section>
      <h2 class="text-lg font-heading font-bold text-sand-800 dark:text-sand-100 mb-2">
        {c.tableHeading(year)}
      </h2>
      <p class="text-sm text-sand-600 dark:text-sand-400 mb-4 max-w-3xl">
        {fill(c.tableIntro)}
      </p>

      <!-- Progressive-enhancement controls: plain <button>s, inert without JS.
           The table below is the complete, unfiltered ranking either way. -->
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2 mb-3">
        <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label={c.regionFilterLabel}>
          <span class="text-xs font-medium text-sand-600 dark:text-sand-400 mr-1">{c.regionFilterLabel}:</span>
          <button type="button" class={`tsi-region-btn ${regionBtnBase} ${regionBtnActive}`} data-region="all" aria-pressed="true">
            {c.regionAll}
          </button>
          {REGION_ORDER.map((region) => (
            <button type="button" class={`tsi-region-btn ${regionBtnBase} ${regionBtnInactive}`} data-region={region} aria-pressed="false">
              {c.regionNames[region]}
            </button>
          ))}
        </div>
        <div class="flex flex-wrap items-center gap-1.5" role="group" aria-label={c.sortLabel}>
          <span class="text-xs font-medium text-sand-600 dark:text-sand-400 mr-1">{c.sortLabel}:</span>
          <button type="button" id="tsi-sort-safest" class={`${regionBtnBase} ${regionBtnActive}`} aria-pressed="true">
            {c.sortSafestFirst}
          </button>
          <button type="button" id="tsi-sort-riskiest" class={`${regionBtnBase} ${regionBtnInactive}`} aria-pressed="false">
            {c.sortRiskiestFirst}
          </button>
        </div>
      </div>

      <div class="overflow-x-auto rounded-lg border border-sand-200 dark:border-sand-700">
        <table id="tsi-table" class="w-full min-w-[860px] text-sm border-collapse">
          <caption class="sr-only">{c.tableCaption(year)}</caption>
          <thead>
            <tr class="border-b-2 border-sand-300 dark:border-sand-600 text-xs uppercase tracking-wide text-sand-600 dark:text-sand-400 bg-sand-100 dark:bg-sand-800/60">
              <th scope="col" class="py-2 pl-3 pr-3 text-left">{c.thRank}</th>
              <th scope="col" class="py-2 pr-4 text-left">{c.thCountry}</th>
              <th scope="col" class="py-2 pr-4 text-left">{c.thScore}</th>
              <th scope="col" class="py-2 pr-4 text-left">{c.thBand}</th>
              <th scope="col" class="py-2 pr-4 text-right">{c.thConflict}</th>
              <th scope="col" class="py-2 pr-4 text-right">{c.thCrime}</th>
              <th scope="col" class="py-2 pr-4 text-right">{c.thHealth}</th>
              <th scope="col" class="py-2 pr-4 text-right">{c.thGovernance}</th>
              <th scope="col" class="py-2 pr-4 text-right">{c.thEnvironment}</th>
              <th scope="col" class="py-2 pr-3 text-right">{c.thTrend}</th>
            </tr>
          </thead>
          <tbody id="tsi-table-body">
            {data.rows.map((row) => (
              <IndexTableRow row={row} lang={lang} />
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- How the index is built -->
    <section class="max-w-3xl mx-auto">
      <h2 class="text-lg font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">
        {c.howBuiltHeading}
      </h2>
      <p class="text-base text-sand-700 dark:text-sand-300 leading-relaxed">
        {fill(c.howBuiltText)}
        {' '}
        <a href={`/${lang}/${r.methodology}/`} class={linkClass}>{c.howBuiltLinkText}</a>
      </p>
    </section>

    <!-- Download & cite -->
    <section class="max-w-3xl mx-auto">
      <h2 class="text-lg font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">
        {c.downloadHeading}
      </h2>
      <p class="text-base text-sand-700 dark:text-sand-300 leading-relaxed mb-4">
        {c.downloadIntro}
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-4">
        <a href="/scores.json" class={downloadLinkClass}>
          <span>{c.downloadJsonLabel}</span>
          <span class="text-xs text-sand-400 font-mono" aria-hidden="true">.json</span>
        </a>
        <a href="/scores.csv" class={downloadLinkClass}>
          <span>{c.downloadCsvLabel}</span>
          <span class="text-xs text-sand-400 font-mono" aria-hidden="true">.csv</span>
        </a>
        <a href={`/${lang}/${r.api}/`} class={downloadLinkClass}>
          <span>{c.downloadApiLabel}</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href={`/${lang}/${r.cite}/`} class={downloadLinkClass}>
          <span>{c.downloadCiteLabel}</span>
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <p class="text-sm text-sand-600 dark:text-sand-400">
        {c.licenseNote}
        {' '}
        <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener noreferrer" class={linkClass}>CC BY-NC 4.0</a>
      </p>
    </section>

    <!-- FAQ (visible mirror of the FAQPage JSON-LD) -->
    <section class="max-w-3xl mx-auto">
      <h2 class="text-lg font-heading font-bold text-sand-800 dark:text-sand-100 mb-4">
        {c.faqHeading}
      </h2>
      <div class="space-y-4">
        {faqItems.map((qa) => (
          <div>
            <h3 class="font-semibold text-sand-800 dark:text-sand-100 mb-1">{qa.question}</h3>
            <p class="text-sand-700 dark:text-sand-300 leading-relaxed">{qa.answer}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- See also (avoids cannibalizing /safest-countries/: different intent) -->
    <section class="max-w-3xl mx-auto pt-6 border-t border-sand-200 dark:border-sand-700">
      <h2 class="text-lg font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">
        {c.seeAlsoHeading}
      </h2>
      <p class="text-sand-700 dark:text-sand-300 leading-relaxed">
        {c.seeAlsoSafestNote}
        {' '}
        {/* Reuses the safest-countries hub's own established title verbatim
            (same string HubPageLayout's own cross-links use) rather than a
            new paraphrase — one fewer translation to keep in sync, and it
            inherits that page's own (deliberately untouched) heading style. */}
        <a href={`/${lang}/${r['safest-countries']}/`} class={linkClass}>{t('hub.safest_countries.title' as any)}</a>
      </p>
    </section>
  </div>
</Base>

<script>
  // Region filter + score-order toggle for the ranking table. Pure progressive
  // enhancement: every row is already rendered server-side in safest-first
  // order, so a visitor with JS disabled gets the complete, correct table —
  // these controls only add convenience on top.
  function initTravelSafetyIndexControls() {
    const table = document.getElementById('tsi-table') as HTMLTableElement | null;
    if (!table || table.dataset.tsiInit === 'true') return;
    table.dataset.tsiInit = 'true';

    const tbody = document.getElementById('tsi-table-body');
    if (!tbody) return;

    const regionButtons = Array.from(document.querySelectorAll<HTMLButtonElement>('.tsi-region-btn'));
    const sortSafestBtn = document.getElementById('tsi-sort-safest') as HTMLButtonElement | null;
    const sortRiskiestBtn = document.getElementById('tsi-sort-riskiest') as HTMLButtonElement | null;

    const ACTIVE = ['bg-terracotta-500', 'text-white', 'border-terracotta-500'];
    const INACTIVE = ['bg-transparent', 'text-sand-600', 'dark:text-sand-300', 'border-sand-300', 'dark:border-sand-600'];

    function setActive(btn: HTMLButtonElement, active: boolean) {
      btn.setAttribute('aria-pressed', String(active));
      ACTIVE.forEach((cls) => btn.classList.toggle(cls, active));
      INACTIVE.forEach((cls) => btn.classList.toggle(cls, !active));
    }

    let currentRegion = 'all';
    function applyRegionFilter() {
      tbody!.querySelectorAll('tr').forEach((tr) => {
        const row = tr as HTMLTableRowElement;
        row.hidden = currentRegion !== 'all' && row.dataset.region !== currentRegion;
      });
    }

    regionButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        currentRegion = btn.dataset.region || 'all';
        regionButtons.forEach((b) => setActive(b, b === btn));
        applyRegionFilter();
      });
    });

    let reversed = false;
    function setSort(reverse: boolean) {
      if (reverse === reversed) return;
      reversed = reverse;
      const rows = Array.from(tbody!.querySelectorAll('tr'));
      rows.reverse().forEach((row) => tbody!.appendChild(row));
      if (sortSafestBtn) setActive(sortSafestBtn, !reverse);
      if (sortRiskiestBtn) setActive(sortRiskiestBtn, reverse);
    }

    sortSafestBtn?.addEventListener('click', () => setSort(false));
    sortRiskiestBtn?.addEventListener('click', () => setSort(true));
  }

  initTravelSafetyIndexControls();
  document.addEventListener('astro:after-swap', initTravelSafetyIndexControls);
</script>
