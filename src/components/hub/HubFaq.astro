---
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import type { HubFaqItem } from '../../lib/hub-faq';

interface Props {
  lang: Lang;
  faqData: HubFaqItem[];
}

const { lang, faqData } = Astro.props;
const t = useTranslations(lang);
---

<section id="faq" class="pt-8 border-t border-sand-200 dark:border-sand-700">
  <h2 class="text-xl md:text-2xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-5">
    {t('country.faq_title' as any)}
  </h2>
  <div class="space-y-3">
    {faqData.map((qa) => (
      <details class="border border-sand-200 dark:border-sand-700 rounded-lg">
        <summary class="px-4 py-3 cursor-pointer font-medium text-sand-800 dark:text-sand-100 hover:bg-sand-50 dark:hover:bg-sand-800 rounded-lg select-none">
          {qa.question}
        </summary>
        <div class="px-4 pb-4 pt-1 text-sm text-sand-700 dark:text-sand-300">
          <p>{qa.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>
