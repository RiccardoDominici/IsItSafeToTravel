---
import type { PillarName, ScoredCountry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { routes } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../Breadcrumb.astro';
import CountryRankRow from './CountryRankRow.astro';
import HubFaq from './HubFaq.astro';
import { getHubFaq, type HubType } from '../../lib/hub-faq';
import { buildFaqPageJsonLd, WEBSITE_ID, localeMap } from '../../lib/seo';
import { getLastmodMap } from '../../lib/lastmod';
import { getBiggestMovers } from '../../lib/hub-data';
import { getLocalizedCountryName } from '../../lib/scores';
import { faqPillarLabels, advisoryLevelWords } from '../../lib/country-faq-copy';
import { hubBlurbTemplates } from '../../i18n/hub-blurbs';
import { getEnglishCountryPhrase } from '../../i18n/country-grammar';
import { getRegion, type Region } from '../../lib/regions';
import { SOURCE_COUNT_DISPLAY } from '../../lib/site-stats';
import { selectPillarExtremes } from '../../lib/pillar-extremes';
import {
  regionHeadings,
  buildRegionIntro,
  citeThisRanking,
  soloFemaleGuidance,
  familyRankingExplainer,
} from '../../i18n/hub-enrichment-copy';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  intro: string;
  jsonLd: Record<string, unknown>;
  countries: ScoredCountry[];
  /** When set, renders a visible FAQ section and merges a FAQPage node into the JSON-LD @graph. */
  hubType?: HubType;
  showDelta?: boolean;
  deltas?: Map<string, number>;
  breadcrumbItems?: Array<{ label: string; href: string }>;
}

const { lang, title, description, intro, jsonLd, countries, hubType, showDelta = false, deltas, breadcrumbItems } = Astro.props;

// JSON-LD @graph: ItemList (the ranking itself, passed in as `jsonLd`) plus a
// CollectionPage node and, when this hub has a FAQ, a FAQPage node.
//
// S6 (2026-09 SEO audit): ranking hub pages (safest/most-dangerous/regions/...)
// never had a WebPage/CollectionPage node or a dateModified, unlike /news/
// (the site's other listing page, which pairs CollectionPage+WebPage with its
// ItemList). Added unconditionally — not just inside the FAQ branch — so
// region pages (which have no hubType/FAQ) get it too. isPartOf/mainEntity
// connect it into the site graph (S1): part of the WebSite, primary entity is
// the ItemList right next to it in the same @graph.
const faqData = hubType ? getHubFaq(hubType, lang) : null;
const { '@context': _ctxItemList, ...itemListRest } = jsonLd;
const hubUrl = typeof jsonLd.url === 'string' ? jsonLd.url : '';
const itemListNode = { ...itemListRest, '@id': `${hubUrl}#itemlist` };
const collectionPageNode = {
  '@type': ['CollectionPage', 'WebPage'],
  '@id': `${hubUrl}#collectionpage`,
  name: title,
  description,
  url: hubUrl,
  inLanguage: localeMap[lang],
  dateModified: getLastmodMap().snapshotDate,
  isPartOf: { '@id': WEBSITE_ID },
  mainEntity: { '@id': `${hubUrl}#itemlist` },
};
const graphNodes: Record<string, unknown>[] = [itemListNode, collectionPageNode];
if (faqData) {
  const { '@context': _ctxFaq, ...faqPageNode } = buildFaqPageJsonLd(faqData);
  graphNodes.push(faqPageNode);
}
const finalJsonLd = {
  '@context': 'https://schema.org',
  '@graph': graphNodes,
};
const t = useTranslations(lang);
const r = routes[lang];
const dateLocaleMap: Record<Lang, string> = {
  en: 'en-US',
  it: 'it-IT',
  es: 'es-ES',
  fr: 'fr-FR',
  pt: 'pt-BR',
  zh: 'zh-CN',
  de: 'de-DE',
};
const dateStr = new Date().toLocaleDateString(dateLocaleMap[lang], { year: 'numeric', month: 'long', day: 'numeric' });

const defaultBreadcrumb = [
  { label: t('nav.home'), href: `/${lang}/` },
  { label: t('nav.rankings' as any) || 'Rankings', href: `/${lang}/${r['safest-countries'] || 'safest-countries'}/` },
  { label: title, href: '' },
];
const crumbs = breadcrumbItems || defaultBreadcrumb;

// ---- Hub enrichment (2026-08 SEO audit, extended 2026-09) ----
// 'safest countries 2026' is the one head query where this page type is
// SERP-aligned, but the hubs were ~400 words of bare rank/name/score against
// 2,000+ word competitors. Originally only the two head-term hubs (full 1-10
// ranking, directly GPI-comparable) got a data blurb, a biggest-movers block
// and a "how we differ from GPI" section. The 2026-09 follow-up (SXO-03 / C6)
// extends the per-country BLURB to the other 5 hubs too — the movers block and
// GPI note stay head-term-only below (isHeadTermHub), since sitewide "movers"
// and "vs GPI" framing only make sense for a plain score ranking, not for an
// advisory-, weighted-subset- or trend-based one. Every blurb is generated
// from data already in the build, no manual editorial at 248-country scale.
const HEAD_TERM_HUBS: HubType[] = ['safest-countries', 'most-dangerous-countries'];
const isHeadTermHub = hubType !== undefined && HEAD_TERM_HUBS.includes(hubType);
const enrich = hubType !== undefined;
const BLURB_COUNT = 20;

function pillarScore(country: ScoredCountry, name: PillarName): number {
  return (country.pillars.find((p) => p.name === name)?.score ?? 0) * 10;
}

/**
 * One-line, per-country data blurb. The head-term hubs (safest/most-dangerous)
 * name the country's strongest/weakest eligible pillar; the other 5 hubs name
 * the specific pillars THAT hub actually weighs (see hub-data.ts), or — for
 * the two trend hubs — the 7-day delta the page already computed.
 */
function buildBlurb(country: ScoredCountry): string {
  const labels = faqPillarLabels[lang];
  // English needs "the" for the ~15 plural/union country names in this
  // subject-position blurb ("the United States scores 8/10", not "United
  // States scores 8/10") — same fix as getCountryFaqData in seo.ts.
  const bareName = getLocalizedCountryName(country, lang);
  const name = lang === 'en' ? getEnglishCountryPhrase(country.iso3, bareName) : bareName;
  const score = country.score.toFixed(1);
  let text: string;
  // countries-to-avoid already names the advisory count in its own sentence —
  // skip the generic advisory-consensus appendage below to avoid saying it twice.
  let skipAdvisoryAppend = false;

  if (isHeadTermHub) {
    // Sort-based pick (pillar-extremes.ts), not an ad-hoc max/min loop: under a
    // tie (every pillar collapsed to the same prior), a `>`/`<` comparison
    // loop never advances past the first element, so strongest and weakest
    // resolve to the literal same pillar object -- the exact self-contradiction
    // bug fixed elsewhere as C2 (2026-09-25 audit). Unreachable in practice
    // here (safest/most-dangerous only blurb their top 20 by extreme score,
    // and a near-tied pillar profile regresses to the mid-scale prior, never
    // the extremes) but fixed for consistency with every other picker.
    // Only `strongest` feeds the sentence now -- `weakest` is CountryRankRow's
    // risk-driver badge on the same row, and naming it twice in EN "area to
    // watch: environment (8.3/10)" + badge "Weakest: environment 8.3/10" read
    // as duplicated content (2026-09-26 follow-up).
    const { strongest } = selectPillarExtremes(country.pillars);
    text = (t('hub.blurb' as any) as string)
      .replace('{name}', name)
      .replace('{score}', score)
      .replace('{strongest}', labels[strongest.name])
      .replace('{strongestScore}', (strongest.score * 10).toFixed(1));
  } else if (hubType === 'safest-for-families') {
    // Weighted health 35% + governance 35% + crime 20% + overall 10% (hub-data.ts) — name the two heaviest.
    text = hubBlurbTemplates['safest-for-families'][lang]
      .replace('{name}', name)
      .replace('{score}', score)
      .replace('{healthScore}', pillarScore(country, 'health').toFixed(1))
      .replace('{crimeScore}', pillarScore(country, 'crime').toFixed(1));
  } else if (hubType === 'safest-for-solo-travelers') {
    // Weighted crime 40% + governance 40% + overall 20% (hub-data.ts).
    text = hubBlurbTemplates['safest-for-solo-travelers'][lang]
      .replace('{name}', name)
      .replace('{score}', score)
      .replace('{crimeScore}', pillarScore(country, 'crime').toFixed(1))
      .replace('{governanceScore}', pillarScore(country, 'governance').toFixed(1));
  } else if (hubType === 'countries-to-avoid') {
    // Membership itself is advisory-driven (majority Level 4, hub-data.ts) —
    // say so. No weakest-pillar clause here any more: CountryRankRow already
    // shows it as this row's risk-driver badge, and repeating it in the blurb
    // read as duplicated content (2026-09-26 follow-up).
    const advisories = Object.values(country.advisories ?? {});
    const total = advisories.length;
    const level4Count = advisories.filter((a) => Number((a as { level: number | string })?.level) === 4).length;
    text = hubBlurbTemplates['countries-to-avoid'][lang]
      .replace('{name}', name)
      .replace('{score}', score)
      .replace('{n}', String(level4Count))
      .replace('{total}', String(total));
    skipAdvisoryAppend = true;
  } else if (hubType === 'improving-safety' || hubType === 'declining-safety') {
    // Reuse the 7-day delta the page already computed (passed via the deltas prop) instead of re-deriving a pillar driver.
    const delta = Math.abs(deltas?.get(country.iso3) ?? 0);
    text = hubBlurbTemplates[hubType][lang]
      .replace('{name}', name)
      .replace('{score}', score)
      .replace('{delta}', delta.toFixed(2));
  } else {
    return '';
  }

  // Advisory consensus: modal level across present advisories, ties resolve to
  // the more cautious level (same heuristic as the country-page FAQ Q3).
  if (!skipAdvisoryAppend) {
    const levels = Object.values(country.advisories ?? {})
      .map((a) => Number((a as { level: number | string }).level))
      .filter((l) => Number.isFinite(l) && l >= 1 && l <= 4);
    if (levels.length > 0) {
      const counts = [0, 0, 0, 0, 0];
      for (const l of levels) counts[l]++;
      let modal = 1;
      for (let l = 1; l <= 4; l++) if (counts[l] >= counts[modal]) modal = l;
      text += ' ' + (t('hub.blurb_advisories' as any) as string)
        .replace('{n}', String(levels.length))
        .replace('{level}', advisoryLevelWords[lang][modal - 1]);
    }
  }
  return text;
}

const blurbs = enrich
  ? new Map(countries.slice(0, BLURB_COUNT).map((c) => [c.iso3, buildBlurb(c)]))
  : null;
const movers = isHeadTermHub ? getBiggestMovers(5) : [];

// countries-to-avoid only: group by region with sub-headings (2026-09 audit,
// SXO-03) — the SERP for this query is dominated by editorial results grouped
// by region (Sahel, Middle East…), unlike the other hubs' flat rank order.
// Rank numbers stay GLOBAL (position in the full avoid-list) even inside a
// region group, since "how bad, worldwide" is the meaningful number here.
//
// Headings and intro sentence use regionHeadings/buildRegionIntro
// (hub-enrichment-copy.ts), NOT the hub.region.*.title ui.ts keys — those say
// "Safest Countries in Europe (2026)" (the title of the separate /regions/
// hubs) and reusing them here produced a heading that contradicted the very
// list it introduced (2026-09-26 fix).
const REGION_TYPES: Region[] = ['europe', 'asia', 'africa', 'americas', 'oceania', 'middle_east'];

/** Most common weakest-pillar across a region group — a real aggregate, not a per-country claim, so isNearTie countries are safe to include. */
function dominantDriver(group: ScoredCountry[]): PillarName {
  const counts = new Map<PillarName, number>();
  for (const c of group) {
    const name = selectPillarExtremes(c.pillars).weakest.name;
    counts.set(name, (counts.get(name) ?? 0) + 1);
  }
  let best: PillarName = 'crime';
  let bestCount = -1;
  for (const [name, count] of counts) {
    if (count > bestCount) { best = name; bestCount = count; }
  }
  return best;
}

const groupByRegion = hubType === 'countries-to-avoid';
const globalRank = new Map(countries.map((c, i) => [c.iso3, i + 1]));
const regionGroups = groupByRegion
  ? REGION_TYPES.map((type) => {
      const groupCountries = countries.filter((c) => getRegion(c.iso3) === type);
      return {
        type,
        heading: regionHeadings[type][lang],
        intro: groupCountries.length > 0 ? buildRegionIntro(lang, type, groupCountries.length, dominantDriver(groupCountries)) : '',
        countries: groupCountries,
      };
    }).filter((g) => g.countries.length > 0)
  : [];

// Hub page cross-links. Tagged with the HubType they point to and filtered
// against the current page's hubType so a hub never lists itself under "See
// Also" (2026-09-26 follow-up) -- region pages pass no hubType, so nothing is
// filtered there and all 7 still show.
const ALL_HUB_LINKS = [
  { key: 'hub.safest_countries.title', route: r['safest-countries'] || 'safest-countries', type: 'safest-countries' },
  { key: 'hub.dangerous_countries.title', route: r['most-dangerous-countries'] || 'most-dangerous-countries', type: 'most-dangerous-countries' },
  { key: 'hub.solo_travelers.title', route: r['safest-for-solo-travelers'] || 'safest-for-solo-travelers', type: 'safest-for-solo-travelers' },
  { key: 'hub.families.title', route: r['safest-for-families'] || 'safest-for-families', type: 'safest-for-families' },
  { key: 'hub.countries_to_avoid.title', route: r['countries-to-avoid'] || 'countries-to-avoid', type: 'countries-to-avoid' },
  { key: 'hub.improving.title', route: r['improving-safety'] || 'improving-safety', type: 'improving-safety' },
  { key: 'hub.declining.title', route: r['declining-safety'] || 'declining-safety', type: 'declining-safety' },
] as const satisfies Array<{ key: string; route: string; type: HubType }>;
const hubLinks = ALL_HUB_LINKS.filter((l) => l.type !== hubType);
---

<Base lang={lang} title={title} description={description} jsonLd={finalJsonLd} ogImage="/og/default.png">
  <div class="max-w-4xl mx-auto px-4 py-8 space-y-8">
    <Breadcrumb lang={lang} items={crumbs} />

    <header class="text-center space-y-4">
      <h1 class="text-3xl md:text-4xl font-heading font-bold text-sand-800 dark:text-sand-100">
        {title}
      </h1>
      <p class="text-sm text-sand-500 dark:text-sand-400">
        {dateStr} — {t('hub.updated_daily' as any)?.replace('{count}', SOURCE_COUNT_DISPLAY) || `Rankings updated daily from ${SOURCE_COUNT_DISPLAY} data sources`}
      </p>
      {/* SXO-07: a visible, secondary "cite this ranking" link right by the H1 -- the
          journalist/risk-manager persona looks for this before reading the list. */}
      <a
        href={`/${lang}/${r.cite}/`}
        class="inline-block text-xs text-sand-400 dark:text-sand-500 hover:text-terracotta-500 dark:hover:text-terracotta-400 underline underline-offset-2 transition-colors"
      >
        {citeThisRanking[lang]}
      </a>
    </header>

    <p class="text-base text-sand-700 dark:text-sand-300 max-w-2xl mx-auto text-center leading-relaxed">
      {intro}
    </p>

    {/* safest-for-solo-travelers only (SXO-02): honest scope note -- searchers
        overwhelmingly mean solo FEMALE travel, and there is no dedicated
        dataset for it, so this explains what the ranking can and can't say
        instead of a silent rename. */}
    {hubType === 'safest-for-solo-travelers' && (
      <section class="max-w-2xl mx-auto rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-800 px-5 py-5">
        <h2 class="text-lg font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">
          {soloFemaleGuidance[lang].title}
        </h2>
        {soloFemaleGuidance[lang].paragraphs.map((p) => {
          const [before, after] = p.split('{methodology_link}');
          return (
            <p class="text-sm text-sand-700 dark:text-sand-300 leading-relaxed mb-3 last:mb-0">
              {before}{after !== undefined && (
                <a href={`/${lang}/${r.methodology}/`} class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">
                  {t('about.methodology_link_text' as any)}
                </a>
              )}{after}
            </p>
          );
        })}
      </section>
    )}

    {/* safest-for-families only (SXO-03): 2-3 sentences grounding the ranking
        in getSafestForFamilies's real weights (hub-data.ts), not a relabeled
        overall ranking. */}
    {hubType === 'safest-for-families' && (
      <section class="max-w-2xl mx-auto">
        <p class="text-sm text-sand-700 dark:text-sand-300 leading-relaxed text-center">
          {(() => {
            const [before, after] = familyRankingExplainer[lang].split('{methodology_link}');
            return (
              <>
                {before}
                <a href={`/${lang}/${r.methodology}/`} class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">
                  {t('about.methodology_link_text' as any)}
                </a>
                {after}
              </>
            );
          })()}
        </p>
      </section>
    )}

    {/* Biggest movers (head-term hubs only; self-hides on quiet weeks) */}
    {movers.length > 0 && (
      <section class="rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-800 px-4 py-4">
        <h2 class="text-base font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">
          {t('hub.movers_title' as any)}
        </h2>
        <ul class="flex flex-wrap gap-x-5 gap-y-2 list-none p-0 m-0">
          {movers.map(({ country, delta }) => (
            <li>
              <a
                href={`/${lang}/${r.country}/${country.iso3.toLowerCase()}/`}
                class="inline-flex items-center gap-1.5 text-sm text-sand-700 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors"
              >
                <span>{getLocalizedCountryName(country, lang)}</span>
                <span class={`text-xs font-semibold ${delta > 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}`}>
                  {delta > 0 ? '+' : ''}{delta.toFixed(2)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {groupByRegion ? (
      <div class="space-y-6">
        {regionGroups.map((group) => (
          <section>
            <h2 class="text-lg font-heading font-bold text-sand-800 dark:text-sand-100 mb-1">
              {group.heading}
            </h2>
            {group.intro && (
              <p class="text-sm text-sand-500 dark:text-sand-400 mb-2">
                {group.intro}
              </p>
            )}
            <ol class="space-y-2 list-none p-0 m-0">
              {group.countries.map((country) => (
                <CountryRankRow
                  rank={globalRank.get(country.iso3) ?? 0}
                  country={country}
                  lang={lang}
                  showDelta={showDelta}
                  delta={deltas?.get(country.iso3) ?? 0}
                  blurb={blurbs?.get(country.iso3)}
                />
              ))}
            </ol>
          </section>
        ))}
      </div>
    ) : (
      <ol class="space-y-2 list-none p-0 m-0">
        {countries.map((country, i) => (
          <CountryRankRow
            rank={i + 1}
            country={country}
            lang={lang}
            showDelta={showDelta}
            delta={deltas?.get(country.iso3) ?? 0}
            blurb={blurbs?.get(country.iso3)}
          />
        ))}
      </ol>
    )}

    {/* How this ranking differs from the GPI (head-term hubs only) */}
    {isHeadTermHub && (
      <section class="max-w-2xl mx-auto">
        <h2 class="text-lg font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">
          {t('hub.methodology_note_title' as any)}
        </h2>
        <p class="text-base text-sand-700 dark:text-sand-300 leading-relaxed">
          {(t('hub.methodology_note' as any) as string).split('{methodology_link}')[0]}<a
            href={`/${lang}/${r.methodology}/`}
            class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline"
          >{t('about.methodology_link_text' as any)}</a>{(t('hub.methodology_note' as any) as string).split('{methodology_link}')[1]}
        </p>
      </section>
    )}

    {/* FAQ (visible counterpart of the FAQPage JSON-LD node) */}
    {faqData && <HubFaq lang={lang} faqData={faqData} />}

    {/* See Also cross-links */}
    <section class="pt-8 border-t border-sand-200 dark:border-sand-700">
      <h2 class="text-lg font-heading font-bold text-sand-800 dark:text-sand-100 mb-4">
        {t('hub.see_also' as any) || 'See Also'}
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">
        {hubLinks.map(({ key, route }) => (
          <a
            href={`/${lang}/${route}/`}
            class="text-sm text-sand-600 dark:text-sand-300 hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-800 px-4 py-3 hover:border-terracotta-400 dark:hover:border-terracotta-500"
          >
            {t(key as any) || key}
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>
