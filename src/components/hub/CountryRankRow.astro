---
import type { ScoredCountry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { routes } from '../../i18n/ui';
import { getLocalizedCountryName } from '../../lib/scores';
import { selectPillarExtremes } from '../../lib/pillar-extremes';
import { faqPillarLabels } from '../../lib/country-faq-copy';
import { riskDriverBadge } from '../../i18n/hub-enrichment-copy';

interface Props {
  rank: number;
  country: ScoredCountry;
  lang: Lang;
  showDelta?: boolean;
  delta?: number;
  /** Optional one-line data blurb rendered under the row (top entries on head-term hubs). */
  blurb?: string;
}

const { rank, country, lang, showDelta = false, delta = 0, blurb } = Astro.props;
const r = routes[lang];
const countryUrl = `/${lang}/${r.country}/${country.iso3.toLowerCase()}/`;

// Risk-driver chip (2026-09-26, SXO-07): the pillar pulling the score down
// most, on every row of every ranking hub -- not just the top BLURB_COUNT
// entries that get a full prose blurb from the parent. Self-contained (reads
// only the `country` prop already passed in) so it drops cleanly into every
// hub that renders this row. Suppressed on isNearTie countries (all-prior,
// near-zero-data territories, e.g. Bouvet Island): naming an arbitrary
// "weakest" pillar when all five are statistically indistinguishable would
// repeat the exact contradiction class already fixed elsewhere (2026-09-25
// audit C2, see pillar-extremes.ts).
const extremes = selectPillarExtremes(country.pillars);
const riskDriverText = extremes.isNearTie
  ? ''
  : riskDriverBadge[lang]
      .replace('{pillar}', faqPillarLabels[lang][extremes.weakest.name])
      .replace('{score}', (extremes.weakest.score * 10).toFixed(1));

function getScoreBadgeClasses(rawScore: number): string {
  const score = Number(rawScore.toFixed(1)); // band on the displayed 1-decimal value
  if (score >= 7) return 'bg-sky-100 text-sky-800 dark:bg-sky-900/30 dark:text-sky-300';
  if (score >= 5) return 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300';
  return 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300';
}

function getDeltaClasses(d: number): string {
  if (d > 0) return 'text-emerald-700 dark:text-emerald-400';
  if (d < 0) return 'text-red-700 dark:text-red-400';
  return 'text-sand-600 dark:text-sand-400';
}
---

<li class="list-none">
<a
  href={countryUrl}
  class="block rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-800 px-4 py-3 hover:border-terracotta-400 dark:hover:border-terracotta-500 transition-colors"
>
  <span class="flex items-center gap-3">
    <span class="text-sm font-bold text-sand-600 dark:text-sand-400 w-8 text-right shrink-0">
      {rank}
    </span>
    {/* Real (non-decorative) separator text: without it the rank/name/score spans have no
        whitespace between them in the compiled HTML, so both the raw anchor text search
        engines read and the accessible name screen readers announce run together as
        "45France7.9" instead of "45 · France · 7.9" (2026-09 audit, IL-2). */}
    <span class="text-sand-600 dark:text-sand-400 shrink-0">&middot;</span>
    <span class="text-sm font-medium text-sand-800 dark:text-sand-100 truncate flex-1">
      {getLocalizedCountryName(country, lang)}
    </span>
    {showDelta && delta !== 0 && (
      <span class={`text-xs font-semibold shrink-0 ${getDeltaClasses(delta)}`}>
        {delta > 0 ? '+' : ''}{delta.toFixed(2)}
      </span>
    )}
    <span class="text-sand-600 dark:text-sand-400 shrink-0">&middot;</span>
    <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold whitespace-nowrap shrink-0 ${getScoreBadgeClasses(country.score)}`}>
      {country.score.toFixed(1)}
    </span>
  </span>
  {(riskDriverText || blurb) && (
    <span class="flex flex-wrap items-center gap-x-2 gap-y-1 mt-1.5 pl-11">
      {riskDriverText && (
        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[11px] font-medium bg-sand-100 dark:bg-sand-700/60 text-sand-600 dark:text-sand-300 shrink-0">
          {riskDriverText}
        </span>
      )}
      {blurb && (
        <span class="text-xs leading-relaxed text-sand-600 dark:text-sand-400">
          {blurb}
        </span>
      )}
    </span>
  )}
</a>
</li>
