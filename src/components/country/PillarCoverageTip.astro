---
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<span class="pillar-coverage-tip relative">
  <button
    type="button"
    class="pillar-coverage-tip-trigger text-amber-600 dark:text-amber-400 hover:text-amber-700 dark:hover:text-amber-300 cursor-help focus:outline-none focus:ring-1 focus:ring-amber-500 rounded-sm"
    aria-label={text}
    aria-expanded="false"
    aria-haspopup="true"
  >*</button>
  <span
    class="pillar-coverage-tip-content invisible opacity-0 absolute z-30 right-0 bottom-full mb-1.5 w-56 max-w-[80vw] text-xs leading-snug text-left font-normal normal-case bg-sand-900 dark:bg-sand-100 text-sand-100 dark:text-sand-900 rounded-md shadow-lg p-2.5 transition-opacity duration-150"
    role="tooltip"
  >
    {text}
    <span
      class="absolute top-full right-2 -mt-px border-[5px] border-transparent border-t-sand-900 dark:border-t-sand-100"
      aria-hidden="true"
    ></span>
  </span>
</span>

<style>
  .pillar-coverage-tip:hover > .pillar-coverage-tip-content,
  .pillar-coverage-tip:focus-within > .pillar-coverage-tip-content,
  .pillar-coverage-tip-content.is-open {
    visibility: visible;
    opacity: 1;
  }
</style>

