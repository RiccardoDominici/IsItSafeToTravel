---
import type { ScoredCountry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { routes } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { getComparisonSubject } from '../../i18n/country-grammar';
import { getLocalizedCountryName } from '../../lib/scores';
import { comparisonPillarCells, comparisonRows, roundDistanceKm, selectComparison } from '../../lib/comparisons';
import countryCoords from '../../data/country-coords.json';
import countryProximity from '../../data/country-proximity.json';
import { officialScore } from '../../lib/score-status';
import { communityCopy } from '../../i18n/community-copy';
import { pillarPresentationCopy } from '../../i18n/pillar-presentation-copy';
import { greyCopy, greyHasNoData } from '../../i18n/grey-copy';

// One comparison section for the country page, rows nearest first (never by score):
// every land neighbour, the sovereign state of a territory, and, when those give fewer
// than 3 rows, the nearest scored places across the sea within 1,000 km. Across-sea rows
// carry their shortest coast-or-border distance ("about 80 km away"). Places without an
// official score stay in the table with "Partial data" ("No data yet" when they have no advisory
// and no source, as in the hero). A pillar with nothing measured behind it
// (isEstimatedPillar, the regional prior) reads "No data", as in the pillar bars. Selection rules
// live in src/lib/comparisons.ts; distances come from src/data/country-proximity.json.

interface Props {
  country: ScoredCountry;
  allCountries: ScoredCountry[];
  lang: Lang;
}

const { country, allCountries, lang } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
const pc = pillarPresentationCopy[lang];

function getScoreColor(rawScore: number): string {
  const score = Number(rawScore.toFixed(1)); // band on the displayed 1-decimal value
  if (score >= 7) return 'text-emerald-700 dark:text-emerald-400';
  if (score >= 5) return 'text-amber-700 dark:text-amber-400';
  return 'text-red-700 dark:text-red-400';
}

const selection = selectComparison(country, allCountries, { proximity: countryProximity, coords: countryCoords });
const tableRows = comparisonRows(country, selection);
const hasSeaRows = selection.others.some((row) => row.relation === 'sea');

// "about 80 km away", with the number grouped the locale's way (9,300 / 9.300 / 9 300).
const kmFormat = new Intl.NumberFormat(lang);
const distanceLabel = (km: number): string =>
  t('country.compare_distance').replace('{km}', kmFormat.format(roundDistanceKm(km)));

// Neighbours-only wording, unless across-sea rows are shown. The country phrase is
// built per locale so the article, preposition or verb agreement is correct.
const subject = getComparisonSubject(lang, country.iso3, getLocalizedCountryName(country, lang));
const headingTemplate = hasSeaRows
  ? t('country.compare_title_nearby')
  : t('country.compare_title');
const heading = headingTemplate.replace('{name}', subject.phrase).replace('{copula}', subject.copula);

// Pillar order matching ScoredCountry.pillars standard order
const pillarKeys = ['conflict', 'crime', 'health', 'governance', 'environment'] as const;
---

{tableRows.length > 1 && (
  <section class="py-6 px-4 max-w-2xl mx-auto">
    <h2 class="text-xl md:text-2xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-5">
      {heading}
    </h2>
    <div class="overflow-x-auto">
      <table class="w-full text-sm border-collapse">
        <thead>
          <tr class="border-b border-sand-300 dark:border-sand-600">
            <th class="text-left py-2 pr-3 text-sand-600 dark:text-sand-400 font-medium">{t('country.compare_country')}</th>
            <th class="text-left py-2 pr-3 text-sand-600 dark:text-sand-400 font-medium">{t('country.compare_score')}</th>
            {pillarKeys.map((key) => (
              <th class="text-left py-2 pr-3 text-sand-600 dark:text-sand-400 font-medium whitespace-nowrap">{t(`country.pillar.${key}` as any)}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {tableRows.map(({ country: c, relation, km }) => {
            const isCurrentCountry = relation === 'self';
            const rowClass = isCurrentCountry ? 'bg-terracotta-50 dark:bg-terracotta-900/20' : '';
            // An estimated pillar (nothing measured, the regional prior) shows "No data", as in the pillar bars.
            const pillarCells = comparisonPillarCells(c, pillarKeys);
            // Formula v10 grey place (no official score), the subject or a land neighbour: no number at all.
            const rowScore = officialScore(c);
            return (
              <tr class:list={['border-b border-sand-200 dark:border-sand-700', rowClass]}>
                <td class="py-2 pr-3 font-medium text-sand-800 dark:text-sand-100">
                  <a href={`/${lang}/${r.country}/${c.iso3.toLowerCase()}/`} class="hover:text-terracotta-500 dark:hover:text-terracotta-400">
                    {getLocalizedCountryName(c, lang)}
                  </a>
                  {relation === 'sea' && (
                    <span class="ml-2 align-middle rounded-full border border-sand-300 dark:border-sand-600 px-2 py-0.5 text-xs font-normal text-sand-600 dark:text-sand-400 whitespace-nowrap">
                      {distanceLabel(km)}
                    </span>
                  )}
                </td>
                {rowScore === null ? (
                  <>
                    {/* Same wording as the hero: "No data yet" when there is no advisory and no source at all (audit I27). */}
                    <td class="py-2 pr-3 text-xs font-medium text-sand-600 dark:text-sand-400 whitespace-nowrap" data-grey-label={greyHasNoData(c) ? 'no-data' : 'partial'}>
                      {greyHasNoData(c) ? greyCopy[lang].noDataTitle : communityCopy[lang].partialDataTitle}
                    </td>
                    {pillarKeys.map(() => (
                      <td class="py-2 pr-3 text-sand-500 dark:text-sand-500" aria-hidden="true">–</td>
                    ))}
                  </>
                ) : (
                  <>
                    <td class:list={['py-2 pr-3 font-bold', getScoreColor(rowScore)]}>
                      {rowScore.toFixed(1)}
                    </td>
                    {pillarCells.map(({ name, score10 }) =>
                      score10 === null ? (
                        <td class="py-2 pr-3 text-xs text-sand-600 dark:text-sand-400 whitespace-nowrap" data-pillar={name} data-pillar-estimated="true" title={pc.estimateNote}>
                          {pc.noData}
                        </td>
                      ) : (
                        <td class:list={['py-2 pr-3', getScoreColor(score10)]} data-pillar={name}>
                          {score10.toFixed(1)}
                        </td>
                      ),
                    )}
                  </>
                )}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>
)}
