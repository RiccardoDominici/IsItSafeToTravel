---
import type { ScoredCountry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { scoreToColor, readableTextColor } from '../../lib/colors';
import { getLocalizedCountryName } from '../../lib/scores';
import { getH1CountryPhrase } from '../../i18n/country-grammar';
import { getBand } from '../../lib/bands';
import type { BandKey } from '../../pipeline/news/types';
import { getBandVerdictCopy } from '../../lib/band-copy';
import { LOW_CONFIDENCE_THRESHOLD } from '../../lib/confidence';

interface Props {
  country: ScoredCountry;
  lang: Lang;
  scoreDelta?: { delta: number; period: string } | null;
}

const { country, lang, scoreDelta } = Astro.props;
const t = useTranslations(lang);

const bgColor = scoreToColor(country.score);
// WCAG: the moderate band's yellow fails contrast with white text — pick dark
// text on light backgrounds, keep white on danger/safe colors.
const fgColor = readableTextColor(bgColor);

// `badge` uses the same tinted-pill classes as the site's other status badges
// ("Updated daily", freshness, score chips) so the verdict stays inside the
// palette instead of a pastel card + emoji. Presentation only (CSS), kept
// local -- the copy itself comes from band-copy.ts so this pill can never
// disagree with the FAQ/answer-first/meta-description verdict for the same
// band (2026-09-25 audit, I4: this used to be a locally-owned 5-key text
// table that had drifted from the 3-tier wording used everywhere else).
const badgeStyles: Record<BandKey, string> = {
  excellent: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300',
  good: 'bg-lime-100 text-lime-800 dark:bg-lime-900/30 dark:text-lime-300',
  moderate: 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300',
  high_caution: 'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300',
  danger: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300',
};

// getBand() rounds to the same 1-decimal value the hero displays internally,
// so the verdict never disagrees with the shown number at band boundaries
// (e.g. 5.9975 -> "6.0").
const band = getBand(country.score);
const verdictText = getBandVerdictCopy(country.score, lang).badge;
const badgeClass = badgeStyles[band];

const formattedDate = new Intl.DateTimeFormat(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(country.lastUpdated));
const completenessPercent = Math.round(country.dataCompleteness * 100);
---

<section class="text-center py-8 md:py-12 px-4">
  {/* Question-form H1 + verdict directly under it: SERP competitors all restate
      the query as H1, and our yes/no verdict used to sit ~60% down the page in
      a small italic line (2026-08 SXO audit, HIGH). */}
  <h1 class="text-3xl md:text-4xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-4">
    {/* {name} needs an article/preposition/case in it/pt/de (and "the" in en)
        that the bare localized name doesn't carry — see country-grammar.ts. */}
    {t('country.h1_question').replace('{name}', getH1CountryPhrase(lang, country.iso3, getLocalizedCountryName(country, lang)))}
  </h1>

  {/* Block wrapper: the pill itself is inline-flex, so without this it would
      share the line with the (also inline-flex) score card and drift off-center. */}
  <div class="flex justify-center mb-6">
    <p class={`inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-base md:text-lg font-semibold ${badgeClass}`}>
      <svg class="w-2.5 h-2.5 shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="8"/></svg>
      <span>{verdictText}</span>
    </p>
  </div>

  <div
    class="inline-flex flex-col items-center justify-center rounded-2xl px-8 py-6 shadow-lg"
    style={`background-color: ${bgColor}; color: ${fgColor};`}
  >
    <span class="text-6xl md:text-8xl font-heading font-bold leading-none">
      {country.scoreDisplay}
    </span>
    {/* No opacity fade here (was opacity-90): this text is normal-weight and
        under 24px, so it needs the full 4.5:1, not the 3:1 large-text
        exemption the big number above gets. At mid-gradient scores the best
        available text color already sits close to the 4.5:1 floor (jpn's 8.2
        measured 5.13:1 before any fade) -- any alpha blend risks dropping
        below AA (2026-09 contrast fix). */}
    <span class="text-lg md:text-xl font-medium mt-1">
      {country.score.toFixed(1)} {t('country.out_of')}
    </span>
  </div>

  <p class="mt-4 text-lg font-medium text-sand-600 dark:text-sand-400">
    {t('country.score_label')}
  </p>

  {country.confidence < LOW_CONFIDENCE_THRESHOLD && (
    <p class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-amber-100 dark:bg-amber-900/30 px-3 py-1 text-xs font-medium text-amber-800 dark:text-amber-300">
      <span aria-hidden="true">&#9888;&#65039;</span> {t('country.limited_data')}
    </p>
  )}

  {/* Rounded display is 1 decimal, so a raw delta below 0.05 always reads as
      "+0.0" (or "-0.0") — a badge that shows no visible number while still
      claiming a direction via its color/arrow (2026-09-25 audit, V4: Mexico's
      IT page showed a green up-arrow "+0.0"). Gate on the raw delta so the
      badge only ever appears when the displayed digit is non-zero. */}
  {scoreDelta && Math.abs(scoreDelta.delta) >= 0.05 && (
    <p class={`mt-2 inline-flex items-center gap-1 text-sm font-medium ${scoreDelta.delta > 0 ? 'text-emerald-700 dark:text-emerald-400' : 'text-red-700 dark:text-red-400'}`}>
      {scoreDelta.delta > 0 ? (
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor"><path d="M8 4l4 6H4l4-6z"/></svg>
      ) : (
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor"><path d="M8 12l-4-6h8l-4 6z"/></svg>
      )}
      <span>
        {scoreDelta.delta > 0 ? '+' : ''}{scoreDelta.delta.toFixed(1)} {t('country.score_delta_label')}
      </span>
    </p>
  )}

  <div class="mt-3 flex flex-col sm:flex-row items-center justify-center gap-2 text-sm text-sand-600 dark:text-sand-400">
    <span>{t('country.last_updated').replace('{date}', formattedDate)}</span>
    <span class="hidden sm:inline" aria-hidden="true">&middot;</span>
    <span>{t('country.data_completeness').replace('{percent}', String(completenessPercent))}</span>
  </div>
</section>
