---
import type { ScoredCountry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { scoreToColor } from '../../lib/colors';
import { getLocalizedCountryName } from '../../lib/scores';

interface Props {
  country: ScoredCountry;
  lang: Lang;
  scoreDelta?: { delta: number; period: string } | null;
}

const { country, lang, scoreDelta } = Astro.props;
const t = useTranslations(lang);

const bgColor = scoreToColor(country.score);

// Travel verdict based on score. `badge` uses the same tinted-pill classes as
// the site's other status badges ("Updated daily", freshness, score chips) so
// the verdict stays inside the palette instead of a pastel card + emoji.
const verdicts: Record<string, { text: Partial<Record<Lang, string>>; badge: string }> = {
  excellent: {
    text: { en: 'Yes, safe to travel', it: 'S\u00ec, sicuro per viaggiare', es: 'S\u00ed, seguro para viajar', fr: 'Oui, s\u00fbr pour voyager', pt: 'Sim, seguro para viajar', zh: '\u662f\uff0c\u53ef\u4ee5\u5b89\u5168\u51fa\u884c', de: 'Ja, sicher zu bereisen' },
    badge: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300',
  },
  good: {
    text: { en: 'Generally safe', it: 'Generalmente sicuro', es: 'Generalmente seguro', fr: 'G\u00e9n\u00e9ralement s\u00fbr', pt: 'Geralmente seguro', zh: '\u603b\u4f53\u5b89\u5168', de: 'Allgemein sicher' },
    badge: 'bg-lime-100 text-lime-800 dark:bg-lime-900/30 dark:text-lime-300',
  },
  caution: {
    text: { en: 'Exercise caution', it: 'Prestare attenzione', es: 'Tener precauci\u00f3n', fr: 'Faire preuve de prudence', pt: 'Tenha cautela', zh: '\u8bf7\u4fdd\u6301\u8c28\u614e', de: 'Vorsicht geboten' },
    badge: 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300',
  },
  risky: {
    text: { en: 'Only for experienced travelers', it: 'Solo per viaggiatori esperti', es: 'Solo para viajeros expertos', fr: 'Uniquement pour voyageurs exp\u00e9riment\u00e9s', pt: 'Apenas para viajantes experientes', zh: '\u4ec5\u9650\u7ecf\u9a8c\u4e30\u5bcc\u7684\u65c5\u884c\u8005', de: 'Nur f\u00fcr erfahrene Reisende' },
    badge: 'bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300',
  },
  danger: {
    text: { en: 'Not recommended', it: 'Non raccomandato', es: 'No recomendado', fr: 'Non recommand\u00e9', pt: 'N\u00e3o recomendado', zh: '\u4e0d\u63a8\u8350', de: 'Nicht empfohlen' },
    badge: 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300',
  },
};

// Band on the same 1-decimal value the hero displays, so the verdict never
// disagrees with the shown number at band boundaries (e.g. 5.9975 → "6.0").
const score = Number(country.score.toFixed(1));
const verdictKey = score >= 8 ? 'excellent' : score >= 7 ? 'good' : score >= 6 ? 'caution' : score >= 5 ? 'risky' : 'danger';
const verdict = verdicts[verdictKey];

const formattedDate = new Intl.DateTimeFormat(lang, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(new Date(country.lastUpdated));
const completenessPercent = Math.round(country.dataCompleteness * 100);
---

<section class="text-center py-8 md:py-12 px-4">
  {/* Question-form H1 + verdict directly under it: SERP competitors all restate
      the query as H1, and our yes/no verdict used to sit ~60% down the page in
      a small italic line (2026-08 SXO audit, HIGH). */}
  <h1 class="text-3xl md:text-4xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-4">
    {t('country.h1_question').replace('{name}', getLocalizedCountryName(country, lang))}
  </h1>

  {/* Block wrapper: the pill itself is inline-flex, so without this it would
      share the line with the (also inline-flex) score card and drift off-center. */}
  <div class="flex justify-center mb-6">
    <p class={`inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-base md:text-lg font-semibold ${verdict.badge}`}>
      <svg class="w-2.5 h-2.5 shrink-0" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><circle cx="8" cy="8" r="8"/></svg>
      <span>{verdict.text[lang] ?? verdict.text.en}</span>
    </p>
  </div>

  <div
    class="inline-flex flex-col items-center justify-center rounded-2xl px-8 py-6 shadow-lg"
    style={`background-color: ${bgColor}; color: #fff;`}
  >
    <span class="text-6xl md:text-8xl font-heading font-bold leading-none">
      {country.scoreDisplay}
    </span>
    <span class="text-lg md:text-xl font-medium mt-1 opacity-90">
      {country.score.toFixed(1)} {t('country.out_of')}
    </span>
  </div>

  <p class="mt-4 text-lg font-medium text-sand-600 dark:text-sand-400">
    {t('country.score_label')}
  </p>

  {country.confidence < 0.4 && (
    <p class="mt-2 inline-flex items-center gap-1.5 rounded-full bg-amber-100 dark:bg-amber-900/30 px-3 py-1 text-xs font-medium text-amber-800 dark:text-amber-300">
      <span aria-hidden="true">&#9888;&#65039;</span> {t('country.limited_data')}
    </p>
  )}

  {scoreDelta && scoreDelta.delta !== 0 && (
    <p class={`mt-2 inline-flex items-center gap-1 text-sm font-medium ${scoreDelta.delta > 0 ? 'text-emerald-600 dark:text-emerald-400' : 'text-red-600 dark:text-red-400'}`}>
      {scoreDelta.delta > 0 ? (
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor"><path d="M8 4l4 6H4l4-6z"/></svg>
      ) : (
        <svg class="w-4 h-4" viewBox="0 0 16 16" fill="currentColor"><path d="M8 12l-4-6h8l-4 6z"/></svg>
      )}
      <span>
        {scoreDelta.delta > 0 ? '+' : ''}{scoreDelta.delta.toFixed(1)} {t('country.score_delta_label')}
      </span>
    </p>
  )}

  <div class="mt-3 flex flex-col sm:flex-row items-center justify-center gap-2 text-sm text-sand-500 dark:text-sand-400">
    <span>{t('country.last_updated').replace('{date}', formattedDate)}</span>
    <span class="hidden sm:inline" aria-hidden="true">&middot;</span>
    <span>{t('country.data_completeness').replace('{percent}', String(completenessPercent))}</span>
  </div>
</section>
