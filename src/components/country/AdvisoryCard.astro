---
import type { AdvisoryInfo } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { readableTextColor } from '../../lib/colors';

// `restoredFrom` is being added to the pipeline's AdvisoryInfo type by a
// concurrent workstream (fetchers/advisories.ts already writes it there when a
// scraper fails and the previous successful fetch is reused). Extending the
// type locally, rather than editing src/pipeline/types.ts, avoids touching a
// file another branch owns in this same fix round; once that branch's change
// lands, this local extension becomes redundant but harmless.
type AdvisoryInfoWithRestored = AdvisoryInfo & { restoredFrom?: string };

interface Props {
  advisory: AdvisoryInfoWithRestored;
  sourceName: string;
  sourceKey: string;
  lang: Lang;
}

const { advisory, sourceName, sourceKey, lang } = Astro.props;
const t = useTranslations(lang);

// Advisory level color mapping
function getAdvisoryColor(advisory: AdvisoryInfo, source: string): string {
  if (source === 'uk') {
    // UK FCDO text-based levels
    const text = String(advisory.level).toLowerCase();
    if (text.includes('no travel')) return '#ef4444';
    if (text.includes('essential')) return '#f97316';
    if (text.includes('some parts')) return '#eab308';
    return '#22c55e';
  }
  // All other sources use numeric 1-4 scale
  const level = Number(advisory.level);
  if (level === 1) return '#22c55e';
  if (level === 2) return '#eab308';
  if (level === 3) return '#f97316';
  if (level === 4) return '#ef4444';
  return '#9ca3af';
}

const borderColor = getAdvisoryColor(advisory, sourceKey);
// The level pill previously hardcoded white text: fine on the red/orange
// levels but #22c55e (level 1, green) only measures 2.28:1 with white (WCAG
// AA needs 4.5:1 for this text-xs size) — same fix LevelBadge.astro already
// applies for the gov-advisories pages (2026-09 contrast fix).
const badgeFg = readableTextColor(borderColor);

// Sources that don't expose a real advisory date have no updatedAt — show nothing
// rather than a fabricated "updated today".
const updatedMs = advisory.updatedAt ? new Date(advisory.updatedAt).getTime() : NaN;
const formattedDate = Number.isFinite(updatedMs)
  ? new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short', day: 'numeric' }).format(updatedMs)
  : null;

const levelText = t('country.advisory.level').replace('{level}', String(advisory.level));
const updatedText = formattedDate ? t('country.advisory.updated').replace('{date}', formattedDate) : null;

// "Last successfully checked" — shown only when the pipeline fell back to a
// previously-cached fetch (advisory.restoredFrom set) because today's scrape
// failed. No key for this exists in i18n/ui.ts yet (new copy, not eligible for
// a ui.ts edit in this fix round), so it's a small component-local table,
// matching the established pattern (CitePage.astro, RegionsIndex.astro).
const restoredLabel: Record<Lang, string> = {
  en: 'Last successfully checked: {date}',
  it: 'Ultimo controllo riuscito: {date}',
  es: 'Última comprobación correcta: {date}',
  fr: 'Dernière vérification réussie : {date}',
  pt: 'Última verificação bem-sucedida: {date}',
  zh: '上次成功核查：{date}',
  de: 'Zuletzt erfolgreich geprüft: {date}',
};
const restoredMs = advisory.restoredFrom ? new Date(advisory.restoredFrom).getTime() : NaN;
const restoredText = Number.isFinite(restoredMs)
  ? restoredLabel[lang].replace('{date}', new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short', day: 'numeric' }).format(restoredMs))
  : null;

// Truncate advisory text to 200 characters
const summaryText = advisory.text.length > 200
  ? advisory.text.slice(0, 200).trimEnd() + '...'
  : advisory.text;
---

<div
  class="rounded-lg border border-sand-200 dark:border-sand-700 p-4 bg-white dark:bg-sand-800"
  style={`border-left: 4px solid ${borderColor};`}
>
  <div class="flex items-start justify-between gap-2 mb-2">
    <h3 class="font-heading font-bold text-sand-800 dark:text-sand-100">
      {sourceName}
    </h3>
    <span
      class="shrink-0 text-xs font-medium px-2 py-1 rounded-full"
      style={`background-color: ${borderColor}; color: ${badgeFg};`}
    >
      {levelText}
    </span>
  </div>

  <p class="text-sm text-sand-600 dark:text-sand-400 mb-3">
    {summaryText}
  </p>

  <div class="flex items-center justify-between text-xs text-sand-600 dark:text-sand-400">
    <span>{updatedText ?? ''}</span>
    {/* inline-flex + min-h-6: tap target was under the WCAG 2.5.8 24px minimum (audit V3). */}
    <a
      href={advisory.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center min-h-6 text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline"
    >
      {t('country.pillar_source')}
    </a>
  </div>

  {restoredText && (
    <p class="text-xs text-sand-600 dark:text-sand-400 mt-1 italic">
      {restoredText}
    </p>
  )}
</div>
