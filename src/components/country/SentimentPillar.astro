---
// Community block on the country page (formula v10, SPEC §5/§7). Wraps the vote widget (<slot/>).
//
//  - active (>= MIN_VOTE_FLOOR votes from >= MIN_ORIGIN_FLOOR known countries of origin): the
//    community rating P and, once the score engine provides them, the data score, the community
//    adjustment and the final score.
//  - insufficient (or no votes): one grey line, "Not enough votes yet", with a call to vote. No
//    number is shown before activation.
//  Never a vote count, in either state (owner's rule, 2026-10-19): no "based on N votes", no
//  "N/30 votes" progress, no count of countries of origin. The reader sees either the community
//  rating or "not enough votes yet". The general rule under the block ("once a country has 30
//  votes from at least 3 countries of origin...") stays: it is the threshold, the same for every
//  country, not this country's count. src/__tests__/page-ui-build.test.ts checks the built pages.
//  - grey country (no official score): P, when active, is shown on its own and labelled as the
//    travelers' rating; it never stands in for the official score (SPEC §5).
//
// Copy: src/i18n/community-copy.ts. Data: data/sentiment/latest.json via loadSentimentForCountry.
import type { CommunityComponent, SentimentEntry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { communityCopy, fillCommunityTemplate } from '../../i18n/community-copy';
import { formatSigned, formatTenths, roundForDisplay } from '../../lib/display-number';
import { pillarToColor } from '../../lib/colors';
import { MIN_ORIGIN_FLOOR, MIN_VOTE_FLOOR } from '../../lib/sentiment';
import { isGreyScore } from '../../lib/published-scores';
import { SENTIMENT_ADJUSTMENT_CAP } from '../../pipeline/sentiment/constants';

interface Props {
  /** data/sentiment/latest.json entry (loadSentimentForCountry); the fallback when `community` is absent. */
  sentiment: SentimentEntry | null;
  /**
   * Formula v10: the community component the score engine applied (ScoredCountry.community). When
   * present it decides what is shown (status and perceived), so the block always
   * agrees with the adjustment actually applied to the score, even if the engine rejected an entry
   * the sentiment file called active. Absent on pre-v10 snapshots.
   */
  community?: CommunityComponent | null;
  /** Final published score shown on the page; null for a grey country (no official score). */
  official: number | null;
  lang: Lang;
  /**
   * Formula v10, filled by the score engine (ScoredCountry.community.adjustment): the community adjustment applied to
   * this country's score, in score points (clamped to ±SENTIMENT_ADJUSTMENT_CAP). Omitted or null
   * = nothing is shown about the adjustment.
   */
  scoreAdjustment?: number | null;
  /** Formula v10, filled by the score engine: the data score S_data before the adjustment. */
  dataScore?: number | null;
}

const { sentiment, community = null, official, lang, scoreAdjustment = null, dataScore = null } = Astro.props;
const t = useTranslations(lang);
const copy = communityCopy[lang];

const isGrey = isGreyScore(official);
const isFiniteNumber = (x: unknown): x is number => typeof x === 'number' && Number.isFinite(x);

// One view of the community, from the engine component when the snapshot has it (v10), else from
// the sentiment file entry. Only the status and the rating: the vote and origin counts are never
// read here, so they cannot reach the page by accident.
const view: { status: 'active' | 'insufficient'; perceived: number | null } | null = community
  ? { status: community.status, perceived: community.perceived }
  : sentiment
    ? { status: sentiment.status, perceived: sentiment.perceived }
    : null;
const isActive = view !== null && view.status === 'active' && isFiniteNumber(view.perceived);

const label = t('country.pillar.sentiment');

// Active: the community rating P on the same 1-10 bar as the pillars.
const perceived = isActive ? view!.perceived : null;
const displayScore = perceived !== null ? formatTenths(perceived, lang) : null;
const barWidth = perceived !== null ? Math.max((perceived / 10) * 180, 2) : 0;
const color = perceived !== null ? pillarToColor(perceived / 10) : '';

// Score breakdown (scored countries only): shown once the engine passes the adjustment.
const showAdjustment = isActive && !isGrey && isFiniteNumber(scoreAdjustment);
const showDataScore = showAdjustment && isFiniteNumber(dataScore);
// Each figure is rounded on its own (as everywhere on the page), so 6.654 + 0.463 = 7.117 reads
// "6.7 + 0.5 = 7.1": say so instead of letting the reader think the sum is wrong.
const round1 = (x: number): number => roundForDisplay(x, 1);
const showRoundingNote =
  showDataScore && isFiniteNumber(official) && Math.abs(round1(dataScore!) + round1(scoreAdjustment!) - round1(official)) > 0.05;

// Insufficient (or nobody has voted yet): the same fixed line for every country, so it says
// nothing about how many votes there are, zero or twenty-nine.
const insufficientText = copy.insufficient;

const rulesText = isGrey
  ? copy.rulesGrey
  : fillCommunityTemplate(copy.rulesScored, {
      minVotes: MIN_VOTE_FLOOR,
      minOrigins: MIN_ORIGIN_FLOOR,
      cap: formatTenths(SENTIMENT_ADJUSTMENT_CAP, lang),
    });
---

<section
  id="community-sentiment"
  data-community-status={isActive ? 'active' : 'insufficient'}
  class="rounded-lg border border-sand-200 dark:border-sand-700 p-4 bg-white dark:bg-sand-800"
>
  {/* Heading only: a "Community" pill used to follow it, so every page read "Community
      Sentiment Community" in text and to screen readers (audit I55). */}
  <h2 class="mb-4 text-xl md:text-2xl font-heading font-bold text-sand-800 dark:text-sand-100">
    {label}
  </h2>

  {isActive ? (
    <div class="space-y-1">
      <div class="flex items-center gap-3">
        <span class="w-28 shrink-0 text-sm text-sand-600 dark:text-sand-400 text-right hyphens-auto wrap-break-word">
          {copy.ratingLabel}
        </span>
        <svg viewBox="0 0 200 24" class="flex-1 h-6" role="img" aria-label={`${copy.ratingLabel}: ${displayScore}/10`}>
          <rect x="0" y="4" width="200" height="16" rx="4" fill="currentColor" class="text-sand-200 dark:text-sand-700" />
          <rect x="0" y="4" width={barWidth} height="16" rx="4" fill={color} />
        </svg>
        <span class="w-14 shrink-0 text-sm font-medium text-sand-700 dark:text-sand-300 text-right">
          {displayScore}/10
        </span>
      </div>
      {isGrey && (
        <p class="text-xs font-medium text-sand-700 dark:text-sand-300 pt-1">{copy.notOfficialNote}</p>
      )}
      {showAdjustment && (
        <dl class="flex flex-wrap gap-x-5 gap-y-1 pt-2 text-sm text-sand-700 dark:text-sand-300">
          {showDataScore && (
            <div class="flex gap-1.5">
              <dt class="text-sand-600 dark:text-sand-400">{copy.dataScoreLabel}</dt>
              <dd class="font-medium tabular-nums">{formatTenths(dataScore!, lang)}</dd>
            </div>
          )}
          <div class="flex gap-1.5">
            <dt class="text-sand-600 dark:text-sand-400">{copy.adjustmentLabel}</dt>
            <dd class="font-medium tabular-nums">{formatSigned(scoreAdjustment!, 1, lang)}</dd>
          </div>
          {showDataScore && (
            <div class="flex gap-1.5">
              <dt class="text-sand-600 dark:text-sand-400">{copy.finalScoreLabel}</dt>
              <dd class="font-medium tabular-nums">{formatTenths(official!, lang)}/10</dd>
            </div>
          )}
        </dl>
      )}
      {showRoundingNote && (
        <p class="text-xs text-sand-600 dark:text-sand-400">{copy.roundingNote}</p>
      )}
    </div>
  ) : (
    <p
      data-community-insufficient
      class="rounded-lg border border-dashed border-sand-300 dark:border-sand-600 bg-sand-100 dark:bg-sand-900/40 px-3 py-2.5 text-sm text-sand-600 dark:text-sand-400"
    >
      {insufficientText}
    </p>
  )}

  {/* data-community-rules: the build test exempts this paragraph from the vote-count check, as
      its numbers are the activation threshold and the cap, never this country's count. */}
  <p data-community-rules class="text-xs text-sand-600 dark:text-sand-400 mt-3">
    {rulesText}
  </p>

  <div class="border-t border-sand-200 dark:border-sand-700 mt-4 pt-4">
    <slot />
  </div>
</section>
