---
// Community block on the country page (formula v10, SPEC §5/§7). Wraps the vote widget (<slot/>).
//
//  - active (>= MIN_VOTE_FLOOR votes from >= MIN_ORIGIN_FLOOR known countries of origin): the
//    community rating P, how many votes and origins it rests on and, once the score engine
//    provides them, the data score, the community adjustment and the final score.
//  - insufficient (or no votes): a grey progress line "N/30 votes, M/3 countries of origin" with a
//    call to vote. No number is shown before activation.
//  - grey country (no official score): P, when active, is shown on its own and labelled as the
//    travelers' rating; it never stands in for the official score (SPEC §5).
//
// Copy: src/i18n/community-copy.ts. Data: data/sentiment/latest.json via loadSentimentForCountry.
import type { SentimentEntry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import {
  communityCopy,
  fillCommunityTemplate,
  formatProseDecimal,
  formatSignedPoints,
} from '../../i18n/community-copy';
import { pillarToColor } from '../../lib/colors';
import { MIN_ORIGIN_FLOOR, MIN_VOTE_FLOOR } from '../../lib/sentiment';
import { isGreyScore } from '../../lib/published-scores';
import { SENTIMENT_ADJUSTMENT_CAP } from '../../pipeline/sentiment/constants';

interface Props {
  sentiment: SentimentEntry | null;
  /** Final published score shown on the page; null for a grey country (no official score). */
  official: number | null;
  lang: Lang;
  /**
   * Formula v10, filled by the score engine (not wired yet): the community adjustment applied to
   * this country's score, in score points (clamped to ±SENTIMENT_ADJUSTMENT_CAP). Omitted or null
   * = nothing is shown about the adjustment.
   */
  scoreAdjustment?: number | null;
  /** Formula v10, filled by the score engine: the data score S_data before the adjustment. */
  dataScore?: number | null;
}

const { sentiment, official, lang, scoreAdjustment = null, dataScore = null } = Astro.props;
const t = useTranslations(lang);
const copy = communityCopy[lang];

const isGrey = isGreyScore(official);
const isActive = sentiment !== null && sentiment.status === 'active';
const isFiniteNumber = (x: unknown): x is number => typeof x === 'number' && Number.isFinite(x);

const label = t('country.pillar.sentiment');

// Active: the community rating P on the same 1-10 bar as the pillars.
const perceived = isActive ? sentiment!.perceived : null;
const displayScore = perceived !== null ? perceived.toFixed(1) : null;
const barWidth = perceived !== null ? Math.max((perceived / 10) * 180, 2) : 0;
const color = perceived !== null ? pillarToColor(perceived / 10) : '';
const votesText = isActive
  ? fillCommunityTemplate(copy.votesFromOrigins, { votes: sentiment!.votes, origins: sentiment!.origins })
  : '';

// Score breakdown (scored countries only): shown once the engine passes the adjustment.
const showAdjustment = isActive && !isGrey && isFiniteNumber(scoreAdjustment);
const showDataScore = showAdjustment && isFiniteNumber(dataScore);

// Insufficient: progress towards both activation floors (0/30, 0/3 when nobody has voted yet).
// Each count is clamped at its floor: it is a progress meter, and "9/3 countries of origin" (a
// floor already met while the other is not) reads as an error; "3/3" says "done" plainly.
const insufficientText = fillCommunityTemplate(copy.insufficient, {
  votes: Math.min(sentiment?.votes ?? 0, MIN_VOTE_FLOOR),
  minVotes: MIN_VOTE_FLOOR,
  origins: Math.min(sentiment?.origins ?? 0, MIN_ORIGIN_FLOOR),
  minOrigins: MIN_ORIGIN_FLOOR,
});

const rulesText = isGrey
  ? copy.rulesGrey
  : fillCommunityTemplate(copy.rulesScored, {
      minVotes: MIN_VOTE_FLOOR,
      minOrigins: MIN_ORIGIN_FLOOR,
      cap: formatProseDecimal(lang, SENTIMENT_ADJUSTMENT_CAP),
    });
---

<section
  id="community-sentiment"
  data-community-status={isActive ? 'active' : 'insufficient'}
  class="rounded-lg border border-sand-200 dark:border-sand-700 p-4 bg-white dark:bg-sand-800"
>
  <div class="flex flex-wrap items-center gap-2 mb-4">
    <h2 class="text-xl md:text-2xl font-heading font-bold text-sand-800 dark:text-sand-100">
      {label}
    </h2>
    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-terracotta-500/10 dark:bg-terracotta-500/20 text-terracotta-600 dark:text-sand-100 ring-1 ring-terracotta-500/20 dark:ring-terracotta-500/30">
      {t('sentiment.badge')}
    </span>
  </div>

  {isActive ? (
    <div class="space-y-1">
      <div class="flex items-center gap-3">
        <span class="w-28 shrink-0 text-sm text-sand-600 dark:text-sand-400 text-right">
          {copy.ratingLabel}
        </span>
        <svg viewBox="0 0 200 24" class="flex-1 h-6" role="img" aria-label={`${copy.ratingLabel}: ${displayScore}/10`}>
          <rect x="0" y="4" width="200" height="16" rx="4" fill="currentColor" class="text-sand-200 dark:text-sand-700" />
          <rect x="0" y="4" width={barWidth} height="16" rx="4" fill={color} />
        </svg>
        <span class="w-14 shrink-0 text-sm font-medium text-sand-700 dark:text-sand-300 text-right">
          {displayScore}/10
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 pl-[calc(7rem+0.75rem)]">
        <span class="text-xs text-sand-600 dark:text-sand-400">{votesText}</span>
      </div>
      {isGrey && (
        <p class="text-xs font-medium text-sand-700 dark:text-sand-300 pt-1">{copy.notOfficialNote}</p>
      )}
      {showAdjustment && (
        <dl class="flex flex-wrap gap-x-5 gap-y-1 pt-2 text-sm text-sand-700 dark:text-sand-300">
          {showDataScore && (
            <div class="flex gap-1.5">
              <dt class="text-sand-600 dark:text-sand-400">{copy.dataScoreLabel}</dt>
              <dd class="font-medium tabular-nums">{dataScore!.toFixed(1)}</dd>
            </div>
          )}
          <div class="flex gap-1.5">
            <dt class="text-sand-600 dark:text-sand-400">{copy.adjustmentLabel}</dt>
            <dd class="font-medium tabular-nums">{formatSignedPoints(scoreAdjustment!)}</dd>
          </div>
          {showDataScore && (
            <div class="flex gap-1.5">
              <dt class="text-sand-600 dark:text-sand-400">{copy.finalScoreLabel}</dt>
              <dd class="font-medium tabular-nums">{official!.toFixed(1)}/10</dd>
            </div>
          )}
        </dl>
      )}
    </div>
  ) : (
    <p class="rounded-lg border border-dashed border-sand-300 dark:border-sand-600 bg-sand-100 dark:bg-sand-900/40 px-3 py-2.5 text-sm text-sand-600 dark:text-sand-400 tabular-nums">
      {insufficientText}
    </p>
  )}

  <p class="text-xs text-sand-600 dark:text-sand-400 mt-3">
    {rulesText}
  </p>

  <div class="border-t border-sand-200 dark:border-sand-700 mt-4 pt-4">
    <slot />
  </div>
</section>
