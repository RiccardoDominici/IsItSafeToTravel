---
import type { SentimentEntry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { pillarToColor } from '../../lib/colors';
import { MIN_VOTE_FLOOR } from '../../lib/sentiment';

interface Props {
  sentiment: SentimentEntry | null;
  official: number;
  lang: Lang;
}

const { sentiment, lang } = Astro.props;
const t = useTranslations(lang);

const hasEnough = sentiment !== null && sentiment.count >= MIN_VOTE_FLOOR;

/** Format a signed score-point delta, e.g. "+0.4", "−0.7" (never a bare hyphen). */
function formatSignedDelta(n: number): string {
  const abs = Math.abs(n).toFixed(1);
  const sign = n < 0 ? '−' : '+';
  return `${sign}${abs}`;
}

const label = t('country.pillar.sentiment');

// Inviting empty-state copy, replacing the flat "Not enough votes yet" ui.ts
// keys (2026-09-25 audit, C12/Action Plan #17): a deficiency notice reads as a
// dead end, not an invitation to vote — the voting UI right below it is the
// whole point of the section. No ui.ts edit in this fix round, so this is a
// small component-local table (CitePage.astro / RegionsIndex.astro pattern).
//
// 2026-09-26 follow-up (SXO-06): the first version said only "no votes yet" —
// it never explained WHAT a community score is or when it appears, so on a
// low-traffic page it still read like a dead end. `body` names the real
// mechanism (MIN_VOTE_FLOOR, never hardcoded) instead of a bare invitation.
const emptyStateCopy: Record<Lang, { title: string; body: string }> = {
  en: { title: 'Have you been here? Rate this destination', body: 'This turns into a community safety score once {n} people have voted — a real-world check on the data-based score above. No votes yet: add yours below to help build it.' },
  it: { title: 'Sei stato qui? Vota questa destinazione', body: 'Diventa un punteggio di sicurezza della community non appena {n} persone hanno votato — un riscontro reale sul punteggio basato sui dati qui sopra. Nessun voto ancora: aggiungi il tuo qui sotto per aiutare a costruirlo.' },
  es: { title: '¿Has estado aquí? Valora este destino', body: 'Se convierte en una puntuación de seguridad de la comunidad en cuanto {n} personas hayan votado — un contraste real con la puntuación basada en datos de arriba. Todavía no hay votos: añade el tuyo abajo para ayudar a construirla.' },
  fr: { title: 'Vous y êtes déjà allé ? Notez cette destination', body: "Cela devient un score de sécurité communautaire dès que {n} personnes ont voté — une vérification concrète du score basé sur les données ci-dessus. Aucun vote pour l'instant : ajoutez le vôtre ci-dessous pour aider à le construire." },
  pt: { title: 'Já esteve aqui? Avalie este destino', body: 'Isso se torna uma pontuação de segurança da comunidade assim que {n} pessoas tiverem votado — uma checagem real sobre a pontuação baseada em dados acima. Ainda sem votos: adicione o seu abaixo para ajudar a construí-la.' },
  zh: { title: '去过这里吗？为这个目的地打分', body: '一旦有 {n} 人投票，这里就会显示社区安全评分——作为对上方数据评分的真实世界验证。目前还没有投票：在下面投出你的一票，帮助建立这个评分。' },
  de: { title: 'Waren Sie schon hier? Bewerten Sie dieses Reiseziel', body: 'Sobald {n} Personen abgestimmt haben, wird daraus ein Community-Sicherheitswert — eine Praxis-Gegenprobe zum datenbasierten Wert oben. Noch keine Stimmen: Geben Sie unten Ihre ab, um ihn mit aufzubauen.' },
};
const emptyState = {
  title: emptyStateCopy[lang].title,
  body: emptyStateCopy[lang].body.replace('{n}', String(MIN_VOTE_FLOOR)),
};

const displayScore = hasEnough ? sentiment!.perceived.toFixed(1) : null;
const barWidth = hasEnough ? Math.max((sentiment!.perceived / 10) * 180, 2) : 0;
const color = hasEnough ? pillarToColor(sentiment!.perceived / 10) : '';
const correctionText = hasEnough
  ? t('sentiment.correction_label').replace('{delta}', formatSignedDelta(sentiment!.correction))
  : '';
const voteCountText = hasEnough
  ? t('sentiment.vote_count').replace('{count}', String(sentiment!.count))
  : '';
---

<section id="community-sentiment" class="rounded-lg border border-sand-200 dark:border-sand-700 p-4 bg-white dark:bg-sand-800">
  <div class="flex flex-wrap items-center gap-2 mb-4">
    <h2 class="text-xl md:text-2xl font-heading font-bold text-sand-800 dark:text-sand-100">
      {label}
    </h2>
    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-semibold bg-terracotta-500/10 dark:bg-terracotta-500/20 text-terracotta-600 dark:text-sand-100 ring-1 ring-terracotta-500/20 dark:ring-terracotta-500/30">
      {t('sentiment.badge')}
    </span>
  </div>

  {hasEnough ? (
    <div class="space-y-1">
      <div class="flex items-center gap-3">
        <span class="w-28 shrink-0 text-sm text-sand-600 dark:text-sand-400 text-right">
          {label}
        </span>
        <svg viewBox="0 0 200 24" class="flex-1 h-6" role="img" aria-label={`${label}: ${displayScore}/10 (${t('sentiment.badge')})`}>
          <rect x="0" y="4" width="200" height="16" rx="4" fill="currentColor" class="text-sand-200 dark:text-sand-700" />
          <rect x="0" y="4" width={barWidth} height="16" rx="4" fill={color} />
        </svg>
        <span class="w-14 shrink-0 text-sm font-medium text-sand-700 dark:text-sand-300 text-right">
          {displayScore}/10
        </span>
      </div>
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 pl-[calc(7rem+0.75rem)]">
        <span class="text-xs font-medium text-sand-600 dark:text-sand-400">{correctionText}</span>
        <span class="text-xs text-sand-500 dark:text-sand-400">{voteCountText}</span>
      </div>
    </div>
  ) : (
    <div class="space-y-1">
      <p class="text-sm font-medium text-sand-700 dark:text-sand-300">{emptyState.title}</p>
      <p class="text-xs text-sand-500 dark:text-sand-400">{emptyState.body}</p>
    </div>
  )}

  <p class="text-xs text-sand-500 dark:text-sand-400 mt-3">
    {t('sentiment.disclaimer')}
  </p>

  <div class="border-t border-sand-200 dark:border-sand-700 mt-4 pt-4">
    <slot />
  </div>
</section>
