---
// Pillar bars + per-pillar indicator tables on the country page.
//
// Formula v10 (SPEC §7 "Indicator table"): every indicator row shows the source's OWN value on the
// source's own scale ("45.7 per 100,000 people", "2.54 · GPI scale 1–5, lower is better",
// "4.1 / 10 · INFORM risk, higher is worse"), the source with its edition ("INFORM Risk 2026",
// "GPI 2026", "V-Dem v16") and the real data year. World Bank rows carry the publication-lag
// note. v9.1 printed a normalised "x.x/10" per indicator, which nobody can check at the source.
// Only indicators the current formula scores are listed (src/lib/indicator-display.ts): rows a
// pre-v10 snapshot still carries (child mortality, PM2.5, two mislabelled INFORM columns) are not.
//
// Never rendered for a grey place (formula v10 insufficient_data): its pillar values are internal.
//
// 2026-10-15 (audit I31, I34; rules in src/lib/pillar-presentation.ts):
//  - a pillar with nothing measured behind it shows "No data" in a dashed track, never the
//    regional prior as if it were a measured "5.7/10", and says an estimate stands in for it;
//  - GPI militarisation and the V-Dem public-administration / corruption rows describe the state,
//    not anything a traveller meets: they leave the per-pillar tables for a collapsed "Country
//    context" section that says why they still count in the score. The score is unchanged.
import type { PillarScore } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { routes } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { pillarToColor } from '../../lib/colors';
import { LOW_COVERAGE_FLAG_THRESHOLD } from '../../pipeline/scoring/engine';
import { getIndicatorLabel } from '../../i18n/indicator-labels';
import {
  displayedIndicators,
  formatIndicatorValue,
  indicatorSourceLabel,
  isWorldBankIndicator,
  pillarEvidenceCoverage,
} from '../../lib/indicator-display';
import { isEstimatedPillar, scoreAboveAllBars, splitContextIndicators, type IndicatorRow } from '../../lib/pillar-presentation';
import { pillarPresentationCopy } from '../../i18n/pillar-presentation-copy';
import PillarCoverageTip from './PillarCoverageTip.astro';
import IndicatorTable from './IndicatorTable.astro';

interface Props {
  pillars: PillarScore[];
  lang: Lang;
  /** The published overall score, for the "not an average of the bars" note (audit I47). */
  score?: number | null;
}

const { pillars, lang, score = null } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
const pc = pillarPresentationCopy[lang];

// Contextual methodology link (2026-09-26, Task B1 / GD-05): no country page
// linked to /methodology/ at all before this -- only Header/Footer did, which
// don't count as contextual internal links for crawl-priority purposes. Right
// under the pillar scores is the most on-topic spot: "here's what these five
// numbers mean and how they're weighted." Benefits every locale (including
// /pt/metodologia/, "Crawled - currently not indexed" per GD-05), not just pt.
const methodologyLinkLead: Record<Lang, string> = {
  en: 'See how these scores are calculated on the {methodology_link}.',
  it: 'Scopri come vengono calcolati questi punteggi nella {methodology_link}.',
  es: 'Descubre cómo se calculan estas puntuaciones en la {methodology_link}.',
  fr: 'Découvrez comment ces scores sont calculés sur la {methodology_link}.',
  pt: 'Veja como estas pontuações são calculadas na {methodology_link}.',
  zh: '了解这些评分的计算方式，请见{methodology_link}。',
  de: 'Erfahren Sie, wie diese Werte berechnet werden, auf der {methodology_link}.',
};
const [methodologyLeadBefore, methodologyLeadAfter] = methodologyLinkLead[lang].split('{methodology_link}');

const pillarKeys: Record<string, string> = {
  conflict: 'country.pillar.conflict',
  crime: 'country.pillar.crime',
  health: 'country.pillar.health',
  governance: 'country.pillar.governance',
  environment: 'country.pillar.environment',
};

const toRow = (ind: PillarScore['indicators'][number], note?: string): IndicatorRow => ({
  ind,
  label: getIndicatorLabel(ind.name, t),
  display: formatIndicatorValue(ind, lang),
  source: indicatorSourceLabel(ind, lang),
  worldBank: isWorldBankIndicator(ind),
  note,
});

// One view per pillar, in weights.json order (the snapshot's order).
const views = pillars.map((pillar) => {
  const label = t(pillarKeys[pillar.name] as any);
  const displayScore = (pillar.score * 10).toFixed(1);
  const s = Number(displayScore); // band on the displayed 1-decimal value
  const estimated = isEstimatedPillar(pillar);
  const coverage = pillarEvidenceCoverage(pillar);
  const { traveller, context } = splitContextIndicators(displayedIndicators(pillar));
  return {
    pillar,
    label,
    displayScore,
    estimated,
    riskLevel: s >= 7 ? t('country.risk_low') : s >= 4 ? t('country.risk_moderate') : t('country.risk_high'),
    coveragePercent: Math.round(coverage * 100),
    // An estimated pillar carries its own note; the low-coverage asterisk is for thin, not absent, data.
    lowCoverage: !estimated && coverage < LOW_COVERAGE_FLAG_THRESHOLD,
    rows: traveller.map((ind) => toRow(ind)),
    contextRows: context.map((ind) => toRow(ind, pc.contextCountsIn.replace('{pillar}', label))),
  };
});

// Worst measured pillar first, to draw attention to concerns; estimated pillars last (their value
// is a prior, not a finding).
const sorted = [...views].sort((a, b) => Number(a.estimated) - Number(b.estimated) || a.pillar.score - b.pillar.score);
const contextRows = views.flatMap((v) => v.contextRows);

// The overall score above every bar reads as an error unless the page says why (audit I47).
const showScoreAboveBars = scoreAboveAllBars(score, pillars);
const [aboveBarsBefore, aboveBarsAfter] = pc.scoreAboveBarsNote.split('{link}');
---

<section id="pillars" class="py-6 px-4 max-w-2xl mx-auto">
  <h2 class="text-xl md:text-2xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-4">
    {t('country.pillars_title')}
  </h2>

  <div class="space-y-3">
    {sorted.map((v) => (
      <div class="flex items-center gap-3" data-pillar={v.pillar.name} data-pillar-estimated={v.estimated ? 'true' : undefined}>
        <span class="w-28 shrink-0 text-sm text-sand-600 dark:text-sand-400 text-right hyphens-auto wrap-break-word">
          {v.label}
        </span>
        {v.estimated ? (
          <>
            {/* Same 24px row as a bar, so the measured bars stay aligned; no fill, no number. */}
            <span class="flex-1 h-6 flex items-center">
              <span class="w-full h-4 rounded border border-dashed border-sand-400 dark:border-sand-500 flex items-center justify-center text-[11px] leading-none text-sand-600 dark:text-sand-400">
                {pc.noData}
              </span>
            </span>
            <span class="w-14 shrink-0 text-sm font-medium text-sand-700 dark:text-sand-300 text-right">
              <PillarCoverageTip text={pc.estimateNote} />
            </span>
          </>
        ) : (
          <>
            <svg viewBox="0 0 200 24" class="flex-1 h-6" role="img" aria-label={`${v.label}: ${v.displayScore}/10`}>
              <rect x="0" y="4" width="200" height="16" rx="4" fill="currentColor" class="text-sand-200 dark:text-sand-700" />
              <rect x="0" y="4" width={Math.max(v.pillar.score * 180, 2)} height="16" rx="4" fill={pillarToColor(v.pillar.score)} />
            </svg>
            <span class="w-14 shrink-0 text-sm font-medium text-sand-700 dark:text-sand-300 text-right">
              {v.displayScore}/10{v.lowCoverage && (
                <PillarCoverageTip text={pc.lowCoverageNote} />
              )}
            </span>
          </>
        )}
      </div>
    ))}
  </div>

  {showScoreAboveBars && (
    <p class="mt-3 text-xs leading-relaxed text-sand-600 dark:text-sand-400" data-note="score-above-bars">
      {aboveBarsBefore}<a href={`/${lang}/${r.methodology}/`} class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">{pc.scoreAboveBarsLinkText}</a>{aboveBarsAfter}
    </p>
  )}

  <details class="mt-4">
    <summary class="text-sm text-sand-600 dark:text-sand-400 cursor-pointer select-none hover:text-sand-800 dark:hover:text-sand-200">
      {t('country.pillars_detail_toggle')}
    </summary>

    <div class="mt-4">
      {sorted.map((v) => (
        <div class="mb-6">
          <h3 class="text-sm font-semibold text-sand-700 dark:text-sand-200 mb-2">
            {v.label}
            <span class="ml-2 font-normal text-sand-600 dark:text-sand-400">
              {v.estimated ? (
                <>{pc.noData} · {t('country.pillar_coverage')}: {v.coveragePercent}%</>
              ) : (
                <>
                  {v.displayScore}/10{v.lowCoverage && (
                    <PillarCoverageTip text={pc.lowCoverageNote} />
                  )} · {v.riskLevel} · {t('country.pillar_coverage')}: {v.coveragePercent}%
                </>
              )}
            </span>
          </h3>

          {v.estimated && (
            <p class="text-xs leading-snug text-sand-600 dark:text-sand-400">{pc.estimateNote}</p>
          )}
          {v.rows.length > 0 && <IndicatorTable rows={v.rows} lang={lang} />}
        </div>
      ))}
    </div>
  </details>

  {contextRows.length > 0 && (
    <details class="mt-3" id="country-context">
      <summary class="text-sm text-sand-600 dark:text-sand-400 cursor-pointer select-none hover:text-sand-800 dark:hover:text-sand-200">
        {pc.contextSummary}
      </summary>
      <div class="mt-3">
        <p class="mb-3 text-xs leading-relaxed text-sand-600 dark:text-sand-400">{pc.contextIntro}</p>
        <IndicatorTable rows={contextRows} lang={lang} />
      </div>
    </details>
  )}

  <p class="mt-3 text-xs text-sand-600 dark:text-sand-400">
    {t('country.update_cadence')}
  </p>
  <p class="mt-1 text-xs text-sand-600 dark:text-sand-400">
    {methodologyLeadBefore}<a href={`/${lang}/${r.methodology}/`} class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">{t('about.methodology_link_text' as any)}</a>{methodologyLeadAfter}
  </p>
</section>
