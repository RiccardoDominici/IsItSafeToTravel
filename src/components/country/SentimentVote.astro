---
// Phase 39 (39-06): 5-level calibration vote widget — the interactive half of the
// Sentiment surface (lives inside SentimentPillar's <slot/>, composed by 39-08).
// No-framework, progressive-enhancement pattern matching src/pages/en/feedback/index.astro
// (define:vars + fetch POST + hidden/classList state-swap) and the localStorage precedent in
// src/components/DarkModeToggle.astro (direct get/set, re-init on astro:after-swap).
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';

interface Props {
  iso3: string;
  officialScore: number;
  countryName?: string;
  lang: Lang;
}

const { iso3, countryName = '', lang } = Astro.props;
const t = useTranslations(lang);

// Astro exposes PUBLIC_-prefixed env vars to the client bundle at build time (RESEARCH A3).
// D-12: absent -> no Turnstile widget rendered, POST still works (verification skipped server-side).
const turnstileSitekey = import.meta.env.PUBLIC_TURNSTILE_SITEKEY;

const question = t('sentiment.question').replace('{country}', countryName);
---

<div class="sentiment-vote">
  <form id="sentiment-vote-form" novalidate>
    <fieldset class="space-y-2">
      <legend class="text-base font-heading font-semibold text-sand-800 dark:text-sand-100 mb-3">{question}</legend>

      <label class="sentiment-vote-option flex items-center gap-3 min-h-[44px] px-3 py-2.5 rounded-lg border transition-colors cursor-pointer text-sm text-sand-700 dark:text-sand-200 border-sand-200 dark:border-sand-700 hover:border-sand-300 hover:bg-sand-50 dark:hover:border-sand-600 dark:hover:bg-sand-700/50 has-[:checked]:border-terracotta-500 has-[:checked]:bg-terracotta-500/10 dark:has-[:checked]:bg-terracotta-500/20 has-[:checked]:text-sand-900 dark:has-[:checked]:text-sand-50 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-terracotta-500 has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-white dark:has-[:focus-visible]:ring-offset-sand-800">
        <input type="radio" name="calibration" value="-2" class="peer sr-only" />
        <span aria-hidden="true" class="w-5 h-5 shrink-0 rounded-full border-2 border-sand-300 dark:border-sand-600 bg-white dark:bg-sand-900 transition-all duration-150 peer-checked:border-terracotta-500 peer-checked:bg-terracotta-500 peer-checked:ring-2 peer-checked:ring-inset peer-checked:ring-white dark:peer-checked:ring-sand-900"></span>
        <span class="font-medium">{t('sentiment.level_way_high')}</span>
      </label>
      <label class="sentiment-vote-option flex items-center gap-3 min-h-[44px] px-3 py-2.5 rounded-lg border transition-colors cursor-pointer text-sm text-sand-700 dark:text-sand-200 border-sand-200 dark:border-sand-700 hover:border-sand-300 hover:bg-sand-50 dark:hover:border-sand-600 dark:hover:bg-sand-700/50 has-[:checked]:border-terracotta-500 has-[:checked]:bg-terracotta-500/10 dark:has-[:checked]:bg-terracotta-500/20 has-[:checked]:text-sand-900 dark:has-[:checked]:text-sand-50 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-terracotta-500 has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-white dark:has-[:focus-visible]:ring-offset-sand-800">
        <input type="radio" name="calibration" value="-1" class="peer sr-only" />
        <span aria-hidden="true" class="w-5 h-5 shrink-0 rounded-full border-2 border-sand-300 dark:border-sand-600 bg-white dark:bg-sand-900 transition-all duration-150 peer-checked:border-terracotta-500 peer-checked:bg-terracotta-500 peer-checked:ring-2 peer-checked:ring-inset peer-checked:ring-white dark:peer-checked:ring-sand-900"></span>
        <span class="font-medium">{t('sentiment.level_high')}</span>
      </label>
      <label class="sentiment-vote-option flex items-center gap-3 min-h-[44px] px-3 py-2.5 rounded-lg border transition-colors cursor-pointer text-sm text-sand-700 dark:text-sand-200 border-sand-200 dark:border-sand-700 hover:border-sand-300 hover:bg-sand-50 dark:hover:border-sand-600 dark:hover:bg-sand-700/50 has-[:checked]:border-terracotta-500 has-[:checked]:bg-terracotta-500/10 dark:has-[:checked]:bg-terracotta-500/20 has-[:checked]:text-sand-900 dark:has-[:checked]:text-sand-50 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-terracotta-500 has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-white dark:has-[:focus-visible]:ring-offset-sand-800">
        <input type="radio" name="calibration" value="0" class="peer sr-only" />
        <span aria-hidden="true" class="w-5 h-5 shrink-0 rounded-full border-2 border-sand-300 dark:border-sand-600 bg-white dark:bg-sand-900 transition-all duration-150 peer-checked:border-terracotta-500 peer-checked:bg-terracotta-500 peer-checked:ring-2 peer-checked:ring-inset peer-checked:ring-white dark:peer-checked:ring-sand-900"></span>
        <span class="font-medium">{t('sentiment.level_right')}</span>
      </label>
      <label class="sentiment-vote-option flex items-center gap-3 min-h-[44px] px-3 py-2.5 rounded-lg border transition-colors cursor-pointer text-sm text-sand-700 dark:text-sand-200 border-sand-200 dark:border-sand-700 hover:border-sand-300 hover:bg-sand-50 dark:hover:border-sand-600 dark:hover:bg-sand-700/50 has-[:checked]:border-terracotta-500 has-[:checked]:bg-terracotta-500/10 dark:has-[:checked]:bg-terracotta-500/20 has-[:checked]:text-sand-900 dark:has-[:checked]:text-sand-50 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-terracotta-500 has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-white dark:has-[:focus-visible]:ring-offset-sand-800">
        <input type="radio" name="calibration" value="1" class="peer sr-only" />
        <span aria-hidden="true" class="w-5 h-5 shrink-0 rounded-full border-2 border-sand-300 dark:border-sand-600 bg-white dark:bg-sand-900 transition-all duration-150 peer-checked:border-terracotta-500 peer-checked:bg-terracotta-500 peer-checked:ring-2 peer-checked:ring-inset peer-checked:ring-white dark:peer-checked:ring-sand-900"></span>
        <span class="font-medium">{t('sentiment.level_low')}</span>
      </label>
      <label class="sentiment-vote-option flex items-center gap-3 min-h-[44px] px-3 py-2.5 rounded-lg border transition-colors cursor-pointer text-sm text-sand-700 dark:text-sand-200 border-sand-200 dark:border-sand-700 hover:border-sand-300 hover:bg-sand-50 dark:hover:border-sand-600 dark:hover:bg-sand-700/50 has-[:checked]:border-terracotta-500 has-[:checked]:bg-terracotta-500/10 dark:has-[:checked]:bg-terracotta-500/20 has-[:checked]:text-sand-900 dark:has-[:checked]:text-sand-50 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-terracotta-500 has-[:focus-visible]:ring-offset-2 has-[:focus-visible]:ring-offset-white dark:has-[:focus-visible]:ring-offset-sand-800">
        <input type="radio" name="calibration" value="2" class="peer sr-only" />
        <span aria-hidden="true" class="w-5 h-5 shrink-0 rounded-full border-2 border-sand-300 dark:border-sand-600 bg-white dark:bg-sand-900 transition-all duration-150 peer-checked:border-terracotta-500 peer-checked:bg-terracotta-500 peer-checked:ring-2 peer-checked:ring-inset peer-checked:ring-white dark:peer-checked:ring-sand-900"></span>
        <span class="font-medium">{t('sentiment.level_way_low')}</span>
      </label>
    </fieldset>

    {turnstileSitekey && (
      <div class="cf-turnstile mt-3" data-sitekey={turnstileSitekey}></div>
    )}

    <!-- JS-gated (D-18): stays hidden until the inline script reveals it on init, so a
         no-JS visitor never sees a half-working submit control (silent degradation). -->
    <button
      type="submit"
      id="sentiment-vote-submit"
      disabled
      class="hidden w-full sm:w-auto mt-4 inline-flex items-center justify-center gap-2 rounded-xl px-5 py-2.5 min-h-[44px] font-heading font-semibold text-white bg-terracotta-500 shadow-sm transition-colors hover:bg-terracotta-600 hover:shadow-md disabled:bg-sand-200 dark:disabled:bg-sand-700 disabled:text-sand-500 dark:disabled:text-sand-400 disabled:shadow-none disabled:cursor-not-allowed"
    >
      <span>{t('sentiment.submit')}</span>
      <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4 shrink-0"><path d="M3 10a1 1 0 0 1 1-1h9.586l-3.293-3.293a1 1 0 1 1 1.414-1.414l5 5a1 1 0 0 1 0 1.414l-5 5a1 1 0 0 1-1.414-1.414L13.586 11H4a1 1 0 0 1-1-1Z"/></svg>
    </button>
  </form>

  <div aria-live="polite">
    <div id="sentiment-vote-thanks" class="hidden mt-4 rounded-lg border border-terracotta-500/30 bg-terracotta-500/10 dark:bg-terracotta-500/15 p-4">
      <div class="flex items-start gap-2.5">
        <svg aria-hidden="true" viewBox="0 0 20 20" fill="currentColor" class="w-5 h-5 shrink-0 mt-0.5 text-terracotta-600 dark:text-terracotta-400"><path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0l-3.5-3.5a1 1 0 1 1 1.4-1.4l2.8 2.79 6.8-6.79a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/></svg>
        <div>
          <p class="text-sm font-semibold text-sand-800 dark:text-sand-100">{t('sentiment.thanks_title')}</p>
          <p class="text-sm text-sand-600 dark:text-sand-400">{t('sentiment.thanks_body')}</p>
        </div>
      </div>
    </div>
    <!-- Muted, informational only — deliberately no alert-role semantics (would steal
         focus / conflict with silent degradation, per UI-SPEC Accessibility + T-39-22). -->
    <p id="sentiment-vote-error" class="hidden mt-3 text-xs text-sand-500 dark:text-sand-400">
      {t('sentiment.error')}
    </p>
  </div>
</div>

{turnstileSitekey && (
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
)}

<script define:vars={{ iso3 }}>
  function initSentimentVote() {
    const form = document.getElementById('sentiment-vote-form');
    const submitBtn = document.getElementById('sentiment-vote-submit');
    const thanksEl = document.getElementById('sentiment-vote-thanks');
    const errorEl = document.getElementById('sentiment-vote-error');
    if (!form || !submitBtn || !thanksEl || !errorEl) return;

    const storageKey = 'sentiment-voted-' + iso3;
    // UTC day stamp, matching the server's UTC day-bucketed dedupe window.
    const todayUtc = new Date().toISOString().slice(0, 10);
    const radios = form.querySelectorAll('input[name="calibration"]');

    function showThanks() {
      form.classList.add('hidden');
      thanksEl.classList.remove('hidden');
      errorEl.classList.add('hidden');
    }

    // Soft dedupe (D-17), one vote per UTC day: a same-day returning voter sees thank-you,
    // not the prompt; from the next day the form is offered again. Legacy permanent '1'
    // markers never equal a date, so past voters regain the form under the daily policy.
    // Client-only — not authoritative (server salted-hash dedupe is the source of truth).
    let alreadyVoted = false;
    try {
      alreadyVoted = localStorage.getItem(storageKey) === todayUtc;
    } catch {
      alreadyVoted = false;
    }
    if (alreadyVoted) {
      showThanks();
      return;
    }

    // Reveal the submit control only once JS has run (D-18).
    submitBtn.classList.remove('hidden');

    radios.forEach((radio) => {
      radio.addEventListener('change', () => {
        submitBtn.disabled = false;
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const checked = form.querySelector('input[name="calibration"]:checked');
      if (!checked) return;

      const delta = Number(checked.value);
      const tokenInput = form.querySelector('input[name="cf-turnstile-response"]');
      const token = tokenInput ? tokenInput.value : undefined;

      submitBtn.disabled = true;
      errorEl.classList.add('hidden');

      try {
        const res = await fetch('/api/vote', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ iso3, delta, token }),
        });

        if (res.ok) {
          try {
            localStorage.setItem(storageKey, todayUtc);
          } catch {
            // localStorage unavailable — soft dedupe just won't persist; not fatal.
          }
          showThanks();
        } else {
          // Muted, non-blocking error — options remain selectable (silent degradation, D-18).
          errorEl.classList.remove('hidden');
          submitBtn.disabled = false;
        }
      } catch {
        errorEl.classList.remove('hidden');
        submitBtn.disabled = false;
      }
    });
  }

  initSentimentVote();
  document.addEventListener('astro:after-swap', initSentimentVote);
</script>
