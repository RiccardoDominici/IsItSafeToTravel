---
import type { ScoredCountry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { routes } from '../../i18n/ui';
import { getRegion } from '../../lib/regions';
import { getLocalizedCountryName } from '../../lib/scores';
import { formatTenths, roundForDisplay } from '../../lib/display-number';
import { selectComparison, selectRelated } from '../../lib/comparisons';
import countryCoords from '../../data/country-coords.json';
import countryProximity from '../../data/country-proximity.json';

interface Props {
  country: ScoredCountry;
  allCountries: ScoredCountry[];
  lang: Lang;
}

const { country, allCountries, lang } = Astro.props;

const titles: Record<Lang, { heading: string; region: string; similar: string; seeAll: string }> = {
  en: { heading: 'Related Countries', region: 'In the same region', similar: 'Countries with a similar risk profile', seeAll: 'See all countries in this region' },
  it: { heading: 'Paesi correlati', region: 'Nella stessa regione', similar: 'Paesi con un profilo di rischio simile', seeAll: 'Vedi tutti i paesi della regione' },
  es: { heading: 'Países relacionados', region: 'En la misma región', similar: 'Países con un perfil de riesgo similar', seeAll: 'Ver todos los países de la región' },
  fr: { heading: 'Pays similaires', region: 'Dans la même région', similar: 'Pays au profil de risque similaire', seeAll: 'Voir tous les pays de la région' },
  pt: { heading: 'Países relacionados', region: 'Na mesma região', similar: 'Países com um perfil de risco semelhante', seeAll: 'Ver todos os países da região' },
  zh: { heading: '相关国家', region: '同一地区', similar: '风险特征相似的国家', seeAll: '查看该地区的所有国家' },
  de: { heading: 'Verwandte Länder', region: 'In derselben Region', similar: 'Länder mit ähnlichem Risikoprofil', seeAll: 'Alle Länder dieser Region ansehen' },
};

const t = titles[lang];

// Get score color class based on score value
function getScoreBadgeClasses(rawScore: number): string {
  const score = roundForDisplay(rawScore, 1); // band on the displayed 1-decimal value
  if (score >= 7) return 'bg-sky-100 text-sky-800 dark:bg-sky-900/30 dark:text-sky-300';
  if (score >= 5) return 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300';
  return 'bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300';
}

// Same-region list: the three nearest places in the UN M49 sub-region (Southern Asia,
// Northern Africa, ...), shown by score. Similar-risk-profile list: closest pillar profile.
// Both skip countries the comparison table already shows and countries below the data
// floor. For a subject below the floor the whole block is withheld: its score and pillars
// are prior-driven (src/lib/comparisons.ts). The section renders nothing when both lists
// are empty.
const geo = { proximity: countryProximity, coords: countryCoords };
const comparison = selectComparison(country, allCountries, geo);
const { sameRegion, similarProfile } = selectRelated(country, allCountries, comparison, geo);

const r = routes[lang];
function countryUrl(iso3: string): string {
  return `/${lang}/${r.country}/${iso3.toLowerCase()}/`;
}

// Link to the region hub for this country's region (internal-linking + crawl depth).
// Use the locale-specific region leaf from routes (fr: 'asie', de: 'asien', etc.).
// routes uses 'middle-east' as the lookup key, but getRegion returns 'middle_east'.
const currentRegion = getRegion(country.iso3);
const regionLookupKey = currentRegion === 'middle_east' ? 'middle-east' : currentRegion;
const regionLeaf = currentRegion !== 'other' ? (r as Record<string, string>)[regionLookupKey] : null;
const regionsParent = (r as Record<string, string>).regions ?? 'regions';
const regionUrl = regionLeaf ? `/${lang}/${regionsParent}/${regionLeaf}/` : null;
---

{(sameRegion.length > 0 || similarProfile.length > 0) && (
  <section class="py-6 px-4 max-w-2xl mx-auto">
    <h2 class="text-xl md:text-2xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-5">
      {t.heading}
    </h2>

    {sameRegion.length > 0 && (
      <div class="mb-5">
        <h3 class="text-sm font-semibold text-sand-600 dark:text-sand-400 uppercase tracking-wide mb-3">
          {t.region}
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {sameRegion.map((c) => (
            <a
              href={countryUrl(c.iso3)}
              class="flex items-center justify-between gap-2 rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-800 px-4 py-3 hover:border-terracotta-400 dark:hover:border-terracotta-500 transition-colors"
            >
              <span class="text-sm font-medium text-sand-800 dark:text-sand-100 truncate">
                {getLocalizedCountryName(c, lang)}
              </span>
              <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold whitespace-nowrap ${getScoreBadgeClasses(c.score)}`}>
                {formatTenths(c.score, lang)}
              </span>
            </a>
          ))}
        </div>
        {regionUrl && (
          <a
            href={regionUrl}
            class="inline-flex items-center gap-1 mt-3 text-sm font-medium text-terracotta-600 dark:text-terracotta-400 hover:underline"
          >
            {t.seeAll}
            <span aria-hidden="true">&rarr;</span>
          </a>
        )}
      </div>
    )}

    {similarProfile.length > 0 && (
      <div>
        <h3 class="text-sm font-semibold text-sand-600 dark:text-sand-400 uppercase tracking-wide mb-3">
          {t.similar}
        </h3>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {similarProfile.map((c) => (
            <a
              href={countryUrl(c.iso3)}
              class="flex items-center justify-between gap-2 rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-800 px-4 py-3 hover:border-terracotta-400 dark:hover:border-terracotta-500 transition-colors"
            >
              <span class="text-sm font-medium text-sand-800 dark:text-sand-100 truncate">
                {getLocalizedCountryName(c, lang)}
              </span>
              <span class={`inline-flex items-center px-2 py-0.5 rounded-full text-xs font-bold whitespace-nowrap ${getScoreBadgeClasses(c.score)}`}>
                {formatTenths(c.score, lang)}
              </span>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
)}
