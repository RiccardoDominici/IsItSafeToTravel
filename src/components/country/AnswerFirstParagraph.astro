---
import type { ScoredCountry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import { getLocalizedCountryName } from '../../lib/scores';
import { MIN_PILLAR_COVERAGE } from '../../pipeline/scoring/engine';

interface Props {
  country: ScoredCountry;
  rank: number;
  totalCountries: number;
  lang: Lang;
}

const { country, rank, totalCountries, lang } = Astro.props;
const t = useTranslations(lang);

// Per-language ordinal for the global ranking (en 78th, it 78°, fr 78e, pt 78º;
// es/de/zh read naturally with the plain number given the sentence templates)
function ordinal(n: number, l: Lang): string {
  if (l === 'en') {
    const s = ['th', 'st', 'nd', 'rd'];
    const v = n % 100;
    return n + (s[(v - 20) % 10] || s[v] || s[0]);
  }
  if (l === 'fr') return n + (n === 1 ? 'er' : 'e');
  if (l === 'it') return n + '°';
  if (l === 'pt') return n + 'º';
  return String(n);
}

const localeMap: Record<Lang, string> = { en: 'en-US', it: 'it-IT', es: 'es-ES', fr: 'fr-FR', pt: 'pt-BR', zh: 'zh-CN', de: 'de-DE' };
const pillarLabels: Record<Lang, Record<string, string>> = {
  en: { conflict: 'conflict', crime: 'crime', health: 'health', governance: 'governance', environment: 'environment' },
  it: { conflict: 'conflitto', crime: 'criminalita', health: 'salute', governance: 'governance', environment: 'ambiente' },
  es: { conflict: 'conflicto', crime: 'criminalidad', health: 'salud', governance: 'gobernanza', environment: 'medio ambiente' },
  fr: { conflict: 'conflit', crime: 'criminalite', health: 'sante', governance: 'gouvernance', environment: 'environnement' },
  pt: { conflict: 'conflito', crime: 'criminalidade', health: 'saude', governance: 'governanca', environment: 'meio ambiente' },
  zh: { conflict: '冲突', crime: '犯罪', health: '健康', governance: '治理', environment: '环境' },
  de: { conflict: 'Konflikt', crime: 'Kriminalität', health: 'Gesundheit', governance: 'Regierungsführung', environment: 'Umwelt' },
};

const riskLevels: Record<Lang, [string, string, string]> = {
  en: ['Low risk', 'Moderate risk', 'High risk'],
  it: ['rischio basso', 'rischio moderato', 'rischio alto'],
  es: ['riesgo bajo', 'riesgo moderado', 'riesgo alto'],
  fr: ['risque faible', 'risque modere', 'risque eleve'],
  pt: ['risco baixo', 'risco moderado', 'risco alto'],
  zh: ['低风险', '中等风险', '高风险'],
  de: ['niedriges Risiko', 'mittleres Risiko', 'hohes Risiko'],
};

const score = country.score;
const [low, moderate, high] = riskLevels[lang];
const riskLevel = score >= 7 ? low : score >= 5 ? moderate : high;

// Only pillars with sufficient data coverage are eligible to be named best/worst,
// so a zero-data pillar (e.g. Monaco's crime/governance/environment) never surfaces.
// Falls back to all pillars when none clear the threshold (mirrors seo.ts + engine.ts).
const eligiblePillars = country.pillars.filter((p) => p.dataCompleteness >= MIN_PILLAR_COVERAGE);
const pillarPool = eligiblePillars.length > 0 ? eligiblePillars : country.pillars;
let strongest = pillarPool[0];
let weakest = pillarPool[0];
for (const p of pillarPool) {
  if (p.score > strongest.score) strongest = p;
  if (p.score < weakest.score) weakest = p;
}

const dateStr = new Date().toLocaleDateString(localeMap[lang], { year: 'numeric', month: 'long', day: 'numeric' });
// Fixed site-wide "40+" source framing (matches hub-faq.ts / ApiDocs / CitePage).
const sourceCount = 40;

const text = t('country.answer_first' as any)
  .replace('{name}', getLocalizedCountryName(country, lang))
  .replace('{score}', score.toFixed(1))
  .replace('{date}', dateStr)
  .replace('{riskLevel}', riskLevel)
  .replace('{rank}', ordinal(rank, lang))
  .replace('{total}', String(totalCountries))
  .replace('{weakestPillar}', pillarLabels[lang][weakest.name])
  .replace('{weakestScore}', (weakest.score * 10).toFixed(1))
  .replace('{strongestPillar}', pillarLabels[lang][strongest.name])
  .replace('{strongestScore}', (strongest.score * 10).toFixed(1))
  .replace('{sourceCount}', String(sourceCount));
---

<p class="text-base text-sand-700 dark:text-sand-300 leading-relaxed max-w-2xl mx-auto text-center px-4">
  {text}
</p>
