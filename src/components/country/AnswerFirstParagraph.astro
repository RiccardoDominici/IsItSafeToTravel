---
// Top summary of the country page: score, band and rank; the concrete driver of the weakest
// direct-risk pillar with the source's value, year and source; a strong area only when it is good
// in absolute terms; government advisories by level; provenance. A grey place (formula v10
// insufficient_data) gets one "partial data" sentence plus its advisories, no figure.
// Text built by src/lib/country-summary.ts (pure, unit-tested), copy in
// src/i18n/country-summary-copy.ts.
import type { ScoredCountry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { getLocalizedCountryName } from '../../lib/scores';
import { getLastmodMap } from '../../lib/lastmod';
import { buildCountrySummary } from '../../lib/country-summary';

interface Props {
  country: ScoredCountry;
  /** Rank among countries with an official score (1 = safest); ignored for a grey place. */
  rank: number;
  /** Number of countries with an official score. */
  totalCountries: number;
  lang: Lang;
}

const { country, rank, totalCountries, lang } = Astro.props;

// The snapshot date the page shows in "Last update" (not the build clock).
const text = buildCountrySummary(country, {
  lang,
  name: getLocalizedCountryName(country, lang),
  rank,
  total: totalCountries,
  snapshotDate: getLastmodMap().snapshotDate,
});
---

<p class="text-base text-sand-700 dark:text-sand-300 leading-relaxed max-w-2xl mx-auto text-center px-4">
  {text}
</p>
