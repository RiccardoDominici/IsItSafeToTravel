import type { Lang } from '../i18n/ui';
import { routes } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { loadLatestScores } from '../lib/scores';
import { getLastmodMap } from '../lib/lastmod';
import { buildDatasetJsonLd } from '../lib/seo';
import Base from '../layouts/Base.astro';
import Breadcrumb from './Breadcrumb.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
const countryCount = loadLatestScores().length;
const snapshotDate = getLastmodMap().snapshotDate;

// Page copy is inlined per-language (same pattern as RegionsIndex) to avoid
// threading ~30 more keys through the large i18n/ui.ts table. Technical
// identifiers (endpoint paths, JSON field names) intentionally stay in English.
const copy: Record<
  Lang,
  {
    title: string;
    description: string;
    intro: string;
