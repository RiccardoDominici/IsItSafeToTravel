    epHistory: 'Tägliche Historie des zusammengesetzten Scores eines Landes (ISO3-Code kleingeschrieben), als Array von {date, score}-Punkten.',
    epTrend: 'Historie des zusammengesetzten Scores und der Säulen-Scores eines Landes, als {history, pillars}.',
    epBadge: 'Einbettbares SVG-Abzeichen mit dem aktuellen Sicherheits-Score eines Landes.',
    epLlms: 'KI-lesbare Markdown-Zusammenfassung der gesamten Website (llms.txt) und vollständiger Datensatz pro Land (llms-full.txt).',
    exampleHeading: 'Beispiel',
    exampleCaption: 'Den vollständigen Datensatz laden und den Score eines Landes lesen:',
    fieldsHeading: 'Länderfelder in scores.json',
    fieldsIntro: 'Jeder Eintrag im countries-Array enthält:',
    thField: 'Feld',
    fIso3: 'ISO 3166-1 alpha-3 Ländercode (z. B. "ITA").',
    fName: 'Ländername, lokalisiert in den unterstützten Sprachen.',
    fScore: 'Zusammengesetzter Sicherheits-Score, Skala 1–10 (10 = am sichersten). Unsicherheitsgewichtetes (Bayesian Shrinkage) geometrisches Mittel der 5 Säulen.',
    fScoreDisplay: 'Gerundeter Score für die Anzeige.',
    fConfidence: 'Präzisionsgewichteter Datendichte-Score, 0–1 (höher = mehr und aktuellere zugrunde liegende Daten). Niedrige Konfidenz bedeutet, dass der Score näher an einem vorsichtigen regionalen Richtwert liegt als an harten lokalen Belegen.',
    fPillars: 'Die 5 Risikosäulen (Konflikt, Kriminalität, Gesundheit, Governance, Umwelt) mit Score, Gewicht und zugrunde liegenden Indikatoren. Kriminalität kombiniert die Domäne Sicherheit & Schutz des Global Peace Index mit der Rate vorsätzlicher Tötungsdelikte der Weltbank (nach Bevölkerungs-Zuverlässigkeit skaliert); Konflikt kombiniert den GPI mit einem kalibrierten Reisehinweis-Konsens und der UCDP-Konflikttoten-Zahl; Rechtsstaatlichkeit gehört zu Governance.',
    fAdvisories: 'Reisewarnstufen der Regierungen nach ausstellendem Land (US, UK, CA, AU und 33 weitere).',
    fSources: 'Die für dieses Land verwendeten öffentlichen Quellen mit Abrufdaten.',
    freshness: `Die Daten werden täglich gegen 06:00 UTC neu generiert. Aktueller Snapshot: ${snapshotDate}.`,
    licenseHeading: 'Lizenz & Namensnennung',
    licenseText: 'Alle Daten stehen unter der Lizenz Creative Commons BY-NC 4.0: frei nutzbar, teilbar und anpassbar für nicht-kommerzielle Zwecke.',
    attributionText: 'Bitte nennen Sie "IsItSafeToTravel.org" mit Link, wenn Sie die Daten verwenden. Pipeline und Website sind Open Source auf GitHub.',
  },
};

const c = copy[lang];
const canonicalUrl = `https://isitsafetotravel.org/${lang}/${r['api']}/`;
const localeMap: Record<Lang, string> = { en: 'en-US', it: 'it-IT', es: 'es-ES', fr: 'fr-FR', pt: 'pt-BR', zh: 'zh-CN', de: 'de-DE' };

const endpoints = [
  { path: '/scores.json', href: '/scores.json', desc: c.epScores, size: '~1.4 MB' },
  { path: '/map-data.json', href: '/map-data.json', desc: c.epMapData, size: '~130 KB' },
  { path: '/history/{iso3}.json', href: '/history/ita.json', desc: c.epHistory, size: '~5 KB' },
  { path: '/trend/{iso3}.json', href: '/trend/ita.json', desc: c.epTrend, size: '~20 KB' },
  { path: '/badge/{iso3}.svg', href: '/badge/ita.svg', desc: c.epBadge, size: '~2 KB' },
  { path: '/llms-full.txt', href: '/llms-full.txt', desc: c.epLlms, size: '~250 KB' },
];

const fields = [
  { name: 'iso3', desc: c.fIso3 },
  { name: 'name', desc: c.fName },
  { name: 'score', desc: c.fScore },
  { name: 'scoreDisplay', desc: c.fScoreDisplay },
  { name: 'confidence', desc: c.fConfidence },
  { name: 'pillars', desc: c.fPillars },
  { name: 'advisories', desc: c.fAdvisories },
  { name: 'sources', desc: c.fSources },
];

const exampleCode = `const res = await fetch('https://isitsafetotravel.org/scores.json');
const { date, globalScore, countries } = await res.json();

const italy = countries.find((c) => c.iso3 === 'ITA');
console.log(italy.score); // composite safety score, 1-10
console.log(italy.confidence); // 0-1, how much data backs the score`;

// WebPage + Dataset + BreadcrumbList in one @graph. The Dataset node mirrors the
// homepage Dataset (buildDatasetJsonLd) but points at this page, which is the
// canonical human-readable documentation of the downloadable distribution.
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': canonicalUrl,
      url: canonicalUrl,
      name: c.title,
      description: c.description,
      inLanguage: localeMap[lang],
      datePublished: '2026-06-10',
      dateModified: snapshotDate,
    },
    {
      ...buildDatasetJsonLd(),
      url: canonicalUrl,
      dateModified: snapshotDate,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('nav.home'), item: `https://isitsafetotravel.org/${lang}/` },
        { '@type': 'ListItem', position: 2, name: c.title, item: canonicalUrl },
      ],
    },
  ],
};
---

<Base lang={lang} title={c.title} description={c.description} jsonLd={jsonLd} ogImage="/og/default.png">
  <div class="max-w-4xl mx-auto px-4 py-12">
    <Breadcrumb lang={lang} items={[
      { label: t('nav.home'), href: `/${lang}/` },
      { label: c.title, href: '' },
    ]} />

    <h1 class="text-3xl font-heading font-bold text-sand-900 dark:text-sand-50 mb-6">{c.title}</h1>

    <p class="text-sand-700 dark:text-sand-300 leading-relaxed mb-4">{c.intro}</p>
    <p class="text-sand-700 dark:text-sand-300 leading-relaxed mb-2">{c.noAuth}</p>
    <p class="text-sm text-sand-500 dark:text-sand-400 mb-10">{c.freshness}</p>

    <!-- Endpoints -->
    <section class="mb-10">
      <h2 class="text-xl font-heading font-semibold text-sand-800 dark:text-sand-100 mb-4">{c.endpointsHeading}</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-sand-300 dark:border-sand-600">
              <th class="text-left py-2 pr-4 text-sand-600 dark:text-sand-400 font-medium">{c.thEndpoint}</th>
              <th class="text-left py-2 pr-4 text-sand-600 dark:text-sand-400 font-medium">{c.thDescription}</th>
              <th class="text-left py-2 text-sand-600 dark:text-sand-400 font-medium whitespace-nowrap">{c.thSize}</th>
            </tr>
          </thead>
          <tbody>
            {endpoints.map((ep) => (
              <tr class="border-b border-sand-200 dark:border-sand-700">
                <td class="py-3 pr-4 align-top">
                  <a href={ep.href} class="font-mono text-xs text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline whitespace-nowrap">{ep.path}</a>
                </td>
                <td class="py-3 pr-4 text-sand-600 dark:text-sand-300">{ep.desc}</td>
                <td class="py-3 text-sand-600 dark:text-sand-300 whitespace-nowrap align-top">{ep.size}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Example -->
    <section class="mb-10">
      <h2 class="text-xl font-heading font-semibold text-sand-800 dark:text-sand-100 mb-3">{c.exampleHeading}</h2>
      <p class="text-sand-700 dark:text-sand-300 leading-relaxed mb-4">{c.exampleCaption}</p>
      <pre class="rounded-lg border border-sand-300 dark:border-sand-600 bg-white dark:bg-sand-800 text-sand-800 dark:text-sand-100 font-mono text-xs px-4 py-3 overflow-x-auto"><code>{exampleCode}</code></pre>
    </section>

    <!-- Field reference -->
    <section class="mb-10">
      <h2 class="text-xl font-heading font-semibold text-sand-800 dark:text-sand-100 mb-3">{c.fieldsHeading}</h2>
      <p class="text-sand-700 dark:text-sand-300 leading-relaxed mb-4">{c.fieldsIntro}</p>
      <div class="overflow-x-auto">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b border-sand-300 dark:border-sand-600">
              <th class="text-left py-2 pr-4 text-sand-600 dark:text-sand-400 font-medium">{c.thField}</th>
              <th class="text-left py-2 text-sand-600 dark:text-sand-400 font-medium">{c.thDescription}</th>
            </tr>
          </thead>
          <tbody>
            {fields.map((f) => (
              <tr class="border-b border-sand-200 dark:border-sand-700">
                <td class="py-3 pr-4 font-mono text-xs text-sand-800 dark:text-sand-100 align-top">{f.name}</td>
                <td class="py-3 text-sand-600 dark:text-sand-300">{f.desc}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- License & attribution -->
    <section class="mb-4">
      <h2 class="text-xl font-heading font-semibold text-sand-800 dark:text-sand-100 mb-3">{c.licenseHeading}</h2>
      <p class="text-sand-700 dark:text-sand-300 leading-relaxed mb-2">
        {c.licenseText}
        {' '}
        <a href="https://creativecommons.org/licenses/by-nc/4.0/" target="_blank" rel="noopener noreferrer" class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">CC BY-NC 4.0</a>
      </p>
      <p class="text-sand-700 dark:text-sand-300 leading-relaxed">
        {c.attributionText}
        {' '}
        <a href="https://github.com/RiccardoDominici/IsItSafeToTravel" target="_blank" rel="noopener noreferrer" class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">GitHub</a>
      </p>
    </section>
  </div>
</Base>
