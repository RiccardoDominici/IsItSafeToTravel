---
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { routes } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { navExtraCopy } from '../i18n/nav-extra-copy';
import DarkModeToggle from './DarkModeToggle.astro';
import Search from './Search.astro';

interface Props {
  lang: Lang;
  currentPath: string;
}

const { lang, currentPath } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
const nx = navExtraCopy[lang];
// Shared link classes -- desktop dropdown items and mobile menu items reuse
// the same look so the two never drift apart (2026-09-26 restructure).
const itemClass = 'rounded px-2.5 py-1.5 text-sm text-sand-700 dark:text-sand-200 hover:bg-sand-100 dark:hover:bg-sand-700';
const emphasisedItemClass = 'rounded px-2.5 py-1.5 text-sm font-semibold text-sand-800 dark:text-sand-100 hover:bg-sand-100 dark:hover:bg-sand-700';
// Contrast fix (2026-09-26, contrast agent's measurement pass): sand-400/500
// on these backgrounds fails WCAG AA for small text (2.5-2.7:1 light,
// 3.4-4.4:1 dark) -- sand-600 light / sand-400 dark clears it in both modes.
const groupHeadingClass = 'px-2.5 pb-1 text-[11px] font-semibold uppercase tracking-wide text-sand-600 dark:text-sand-400';
const mobileItemClass = 'block px-4 py-2 text-sm text-sand-700 dark:text-sand-200 hover:bg-sand-100 dark:hover:bg-sand-700';
const mobileGroupHeadingClass = 'block px-4 py-1 text-xs font-semibold text-sand-600 dark:text-sand-400 uppercase';
---

<header class="bg-sand-50/80 dark:bg-sand-900/80 backdrop-blur-sm border-b border-sand-200 dark:border-sand-700 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
    <!-- Logo / Site name -->
    <a
      href={`/${lang}/`}
      class="font-heading text-xl font-bold text-sand-800 dark:text-sand-100 tracking-tight hover:text-terracotta-500 dark:hover:text-terracotta-400 transition-colors inline-flex items-center min-h-[44px]"
    >
      IsItSafeToTravel
    </a>

    <!-- Desktop nav -->
    <nav class="hidden md:flex items-center gap-2" aria-label="Main navigation">
      <a
        href={`/${lang}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-sand-900 dark:hover:text-sand-50 transition-colors inline-flex items-center min-h-[44px] px-2"
      >
        {t('nav.home')}
      </a>
      <a
        href={`/${lang}/${r.methodology}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-sand-900 dark:hover:text-sand-50 transition-colors inline-flex items-center min-h-[44px] px-2"
      >
        {t('nav.methodology')}
      </a>
      <a
        href={`/${lang}/${r.compare}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-sand-900 dark:hover:text-sand-50 transition-colors inline-flex items-center min-h-[44px] px-2"
      >
        {t('nav.compare')}
      </a>

      {/* Rankings dropdown -- a compact two-column panel (2026-09-26 restructure,
          owner feedback: the old single-column list mixing long SEO titles with
          short labels had grown too cluttered). Opens on hover AND on keyboard
          focus (group-focus-within, not just group-hover -- the previous
          hover-only version was unreachable by keyboard, since a `hidden`
          (display:none) panel can't itself receive focus). aria-expanded is
          kept in sync by the tiny script below, mirroring Search.astro's own
          toggle pattern elsewhere in this file. */}
      <div class="relative group" id="rankings-dropdown">
        <button
          id="rankings-trigger"
          aria-expanded="false"
          aria-controls="rankings-panel"
          class="text-sm text-sand-600 dark:text-sand-300 hover:text-sand-900 dark:hover:text-sand-50 transition-colors inline-flex items-center min-h-[44px] px-2 gap-1"
        >
          {t('nav.rankings' as any)}
          <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M19 9l-7 7-7-7"></path></svg>
        </button>
        <div
          id="rankings-panel"
          class="absolute left-0 top-full pt-1 hidden group-hover:block group-focus-within:block z-50"
        >
          <div class="w-[27rem] max-w-[90vw] bg-sand-50 dark:bg-sand-800 border border-sand-200 dark:border-sand-700 rounded-lg shadow-lg p-3 grid grid-cols-2 gap-x-4">
            {/* Column 1 -- Rankings (7 items, "Full ranking" first + emphasised) */}
            <div class="flex flex-col">
              <span class={groupHeadingClass}>{t('nav.rankings' as any)}</span>
              <a href={`/${lang}/${r['travel-safety-index']}/`} class={emphasisedItemClass}>{nx.fullRanking}</a>
              <a href={`/${lang}/${r['safest-countries']}/`} class={itemClass}>{nx.safestCountries}</a>
              <a href={`/${lang}/${r['most-dangerous-countries']}/`} class={itemClass}>{nx.mostDangerousCountries}</a>
              <a href={`/${lang}/${r['countries-to-avoid']}/`} class={itemClass}>{nx.countriesToAvoid}</a>
              <a href={`/${lang}/${r['regions']}/`} class={itemClass}>{nx.byRegion}</a>
              <a href={`/${lang}/${r['safest-for-solo-travelers']}/`} class={itemClass}>{nx.forSoloTravelers}</a>
              <a href={`/${lang}/${r['safest-for-families']}/`} class={itemClass}>{nx.forFamilies}</a>
            </div>
            {/* Column 2 -- Government advisories, then Travelers */}
            <div class="flex flex-col gap-3">
              <div class="flex flex-col">
                <span class={groupHeadingClass}>{nx.governmentGroup}</span>
                <a href={`/${lang}/${r['government-advisories']}/`} class={itemClass}>{nx.allGovernmentsCompared}</a>
                <a href={`/${lang}/${r['governments-disagree']}/`} class={itemClass}>{nx.whereTheyDisagree}</a>
              </div>
              <div class="flex flex-col">
                <span class={groupHeadingClass}>{nx.travelersGroup}</span>
                <a href={`/${lang}/${r['community-vs-data']}/`} class={itemClass}>{nx.whatTravelersSay}</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <a
        href={`/${lang}/${r.about}/`}
        class="text-sm text-sand-600 dark:text-sand-300 hover:text-sand-900 dark:hover:text-sand-50 transition-colors inline-flex items-center min-h-[44px] px-2"
      >
        {t('nav.about')}
      </a>
    </nav>

    <!-- Actions -->
    <div class="flex items-center gap-2">
      <Search lang={lang} />
      <LanguageSwitcher lang={lang} currentPath={currentPath} />
      <DarkModeToggle lang={lang} />

      <!-- Mobile menu (details/summary pattern - no JS) -->
      <details class="md:hidden relative">
        <summary
          class="list-none cursor-pointer min-w-[44px] min-h-[44px] w-11 h-11 flex items-center justify-center rounded-lg text-sand-600 dark:text-sand-300 hover:bg-sand-200 dark:hover:bg-sand-700 transition-colors"
          aria-label="Menu"
        >
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </summary>
        <nav
          class="absolute right-0 top-12 w-56 max-w-[90vw] max-h-[75vh] overflow-y-auto bg-sand-50 dark:bg-sand-800 border border-sand-200 dark:border-sand-700 rounded-lg shadow-lg py-2"
          aria-label="Mobile navigation"
        >
          <a href={`/${lang}/`} class={mobileItemClass}>{t('nav.home')}</a>
          <a href={`/${lang}/${r.methodology}/`} class={mobileItemClass}>{t('nav.methodology')}</a>
          <a href={`/${lang}/${r.compare}/`} class={mobileItemClass}>{t('nav.compare')}</a>

          <hr class="my-1 border-sand-200 dark:border-sand-700" />
          <span class={mobileGroupHeadingClass}>{t('nav.rankings' as any)}</span>
          <a href={`/${lang}/${r['travel-safety-index']}/`} class={`${mobileItemClass} font-semibold`}>{nx.fullRanking}</a>
          <a href={`/${lang}/${r['safest-countries']}/`} class={mobileItemClass}>{nx.safestCountries}</a>
          <a href={`/${lang}/${r['most-dangerous-countries']}/`} class={mobileItemClass}>{nx.mostDangerousCountries}</a>
          <a href={`/${lang}/${r['countries-to-avoid']}/`} class={mobileItemClass}>{nx.countriesToAvoid}</a>
          <a href={`/${lang}/${r['regions']}/`} class={mobileItemClass}>{nx.byRegion}</a>
          <a href={`/${lang}/${r['safest-for-solo-travelers']}/`} class={mobileItemClass}>{nx.forSoloTravelers}</a>
          <a href={`/${lang}/${r['safest-for-families']}/`} class={mobileItemClass}>{nx.forFamilies}</a>

          <hr class="my-1 border-sand-200 dark:border-sand-700" />
          <span class={mobileGroupHeadingClass}>{nx.governmentGroup}</span>
          <a href={`/${lang}/${r['government-advisories']}/`} class={mobileItemClass}>{nx.allGovernmentsCompared}</a>
          <a href={`/${lang}/${r['governments-disagree']}/`} class={mobileItemClass}>{nx.whereTheyDisagree}</a>

          <hr class="my-1 border-sand-200 dark:border-sand-700" />
          <span class={mobileGroupHeadingClass}>{nx.travelersGroup}</span>
          <a href={`/${lang}/${r['community-vs-data']}/`} class={mobileItemClass}>{nx.whatTravelersSay}</a>

          <hr class="my-1 border-sand-200 dark:border-sand-700" />
          <a href={`/${lang}/${r.about}/`} class={mobileItemClass}>{t('nav.about')}</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  // Keeps the Rankings trigger's aria-expanded in sync with the CSS-driven
  // open state (group-hover / group-focus-within in the markup above), so
  // assistive tech gets an accurate announcement even though no JS is
  // required for the panel to actually open/close (same
  // dataset.jsInit + astro:after-swap guard pattern as Footer.astro's
  // cookie-prefs-link script).
  function initRankingsMenuA11y() {
    const wrapper = document.getElementById('rankings-dropdown');
    const trigger = document.getElementById('rankings-trigger');
    if (!wrapper || !trigger || (wrapper as HTMLElement).dataset.jsInit === '1') return;
    (wrapper as HTMLElement).dataset.jsInit = '1';

    let hovering = false;
    let focused = false;
    function sync() {
      trigger!.setAttribute('aria-expanded', hovering || focused ? 'true' : 'false');
    }
    wrapper.addEventListener('pointerenter', () => { hovering = true; sync(); });
    wrapper.addEventListener('pointerleave', () => { hovering = false; sync(); });
    wrapper.addEventListener('focusin', () => { focused = true; sync(); });
    wrapper.addEventListener('focusout', (e) => {
      if (!wrapper.contains((e as FocusEvent).relatedTarget as Node)) {
        focused = false;
        sync();
      }
    });
  }

  initRankingsMenuA11y();
  document.addEventListener('astro:after-swap', initRankingsMenuA11y);
</script>
