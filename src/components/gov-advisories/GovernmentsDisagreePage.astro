---
// "Where governments disagree" (VISIBILITY-BRIEF Task B): ranks countries by
// how much travel advisories diverge across governments. All the underlying
// numbers (spread, median, standard deviation, outliers, headline facts) come
// from src/lib/advisory-views.ts — this component is presentation only.
import type { ScoredCountry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import { routes } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../Breadcrumb.astro';
import LevelBadge from './LevelBadge.astro';
import LevelDistributionBars from './LevelDistributionBars.astro';
import { getLocalizedCountryName } from '../../lib/scores';
import { getLastmodMap } from '../../lib/lastmod';
import {
  buildWebPageJsonLd,
  buildItemListJsonLd, VISIBILITY_PAGES_PUBLISHED } from '../../lib/seo';
import {
  getDisagreementRanking,
  getMostDivergentIssuer,
  countFullConsensus,
  getLevelExtremes,
  getIssuerCountry,
  type DisagreementRow,
  type Level,
} from '../../lib/advisory-views';
import { governmentsDisagreeCopy } from '../../i18n/governments-disagree-copy';
import { governmentAdvisoriesCopy } from '../../i18n/government-advisories-copy';
import { listConnector } from '../../lib/country-faq-copy';

interface Props {
  lang: Lang;
  countries: ScoredCountry[];
}

const { lang, countries } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
const copy = governmentsDisagreeCopy[lang];
const govCopy = governmentAdvisoriesCopy[lang]; // for the cross-link to the sister page and shared methodology link text

const allRows = getDisagreementRanking(countries); // full qualifying set, for headline stats
const TOP_N = 30;
const topRows = allRows.slice(0, TOP_N);
const mostDivergent = getMostDivergentIssuer(allRows);
const fullConsensusCount = countFullConsensus(allRows);
const [mostContested] = allRows;

function resolveGovName(code: string): string {
  const c = getIssuerCountry(countries, code);
  return c ? getLocalizedCountryName(c, lang) : code.toUpperCase();
}

function countsByLevel(row: DisagreementRow): Record<Level, number> {
  const counts: Record<Level, number> = { 1: 0, 2: 0, 3: 0, 4: 0 };
  for (const l of row.levels) counts[l.level]++;
  return counts;
}

/** "{governments} {clause}" for one side of the per-card sentence, e.g. "Italy and Spain advise against all travel" — same up-to-2-names join as src/lib/seo.ts's getCountryFaqData Q3. */
function sideClauseParts(codes: string[], level: Level): string {
  const names = codes.map(resolveGovName);
  const joined = names.length <= 1 ? names[0] ?? '' : names.join(listConnector[lang]);
  return `${joined} ${copy.levelClauses[level - 1]}`;
}

const lm = getLastmodMap();
const snapshotDate = lm.snapshotDate.slice(0, 10);
const countryHref = (c: ScoredCountry) => `/${lang}/${r.country}/${c.iso3.toLowerCase()}/`;
const methodologyUrl = `/${lang}/${r.methodology}/`;
const hubUrl = `/${lang}/${r['government-advisories']}/`;

const title = copy.title;
const description = copy.description.replace('{count}', String(allRows.length));
const canonicalUrl = `https://isitsafetotravel.org/${lang}/${r['governments-disagree']}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPageJsonLd(title, description, canonicalUrl, lang, snapshotDate, VISIBILITY_PAGES_PUBLISHED),
    // BreadcrumbList is NOT duplicated here -- <Breadcrumb> below already
    // emits its own, same convention as HubPageLayout.astro and the country page.
    buildItemListJsonLd(
      title,
      description,
      canonicalUrl,
      topRows.map((row) => ({
        name: getLocalizedCountryName(row.country, lang),
        url: `https://isitsafetotravel.org${countryHref(row.country)}`,
      })),
    ),
  ],
};

const mostContestedExtremes = mostContested ? getLevelExtremes(mostContested) : null;
---

<Base lang={lang} title={title} description={description} jsonLd={jsonLd} ogImage="/og/default.png">
  <div class="max-w-4xl mx-auto px-4 py-8 space-y-8">
    <Breadcrumb lang={lang} items={[
      { label: t('nav.home'), href: `/${lang}/` },
      { label: copy.breadcrumbLabel, href: '' },
    ]} />

    <header class="text-center space-y-3">
      <h1 class="text-3xl md:text-4xl font-heading font-bold text-sand-800 dark:text-sand-100">
        {title}
      </h1>
      <p class="max-w-2xl mx-auto text-base text-sand-700 dark:text-sand-300 leading-relaxed">
        {copy.intro}
      </p>
      <p class="text-xs text-sand-400 dark:text-sand-500 italic max-w-2xl mx-auto">
        {copy.measureExplainer}
      </p>
    </header>

    {/* Headline facts (computed) */}
    <section class="grid grid-cols-1 sm:grid-cols-3 gap-3 max-w-3xl mx-auto">
      {mostContested && mostContestedExtremes && (
        <div class="rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-800 px-4 py-3 text-sm text-sand-700 dark:text-sand-300">
          {copy.factMostContested
            .replace('{country}', getLocalizedCountryName(mostContested.country, lang))
            .replace('{min}', String(mostContestedExtremes.minLevel))
            .replace('{max}', String(mostContestedExtremes.maxLevel))}
        </div>
      )}
      <div class="rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-800 px-4 py-3 text-sm text-sand-700 dark:text-sand-300">
        {mostDivergent
          ? copy.factMostDivergent.replace('{government}', resolveGovName(mostDivergent.code)).replace('{pct}', (mostDivergent.rate * 100).toFixed(1))
          : copy.factInsufficientDivergentData}
      </div>
      <div class="rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-800 px-4 py-3 text-sm text-sand-700 dark:text-sand-300">
        {copy.factFullConsensus.replace('{n}', String(fullConsensusCount)).replace('{total}', String(allRows.length))}
      </div>
    </section>

    <p class="text-center text-sm font-medium text-sand-600 dark:text-sand-300">{copy.listIntro}</p>

    {/* Top 30, as a semantic ordered list of cards (not a <table> -- see brief Task B: "Top 30 with cards") */}
    <ol class="space-y-4 list-none p-0 m-0">
      {topRows.map((row, i) => {
        const extremes = getLevelExtremes(row);
        const maxSide = sideClauseParts(extremes.maxCodes, extremes.maxLevel);
        const minSide = sideClauseParts(extremes.minCodes, extremes.minLevel);
        const sentence = `${maxSide}${copy.clauseSeparator}${minSide}.`;
        const counts = countsByLevel(row);
        const groupLabel = copy.labelGovernmentsRating.replace('{n}', String(row.n));
        return (
          <li class="rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-800 px-4 py-4">
            <div class="flex items-start gap-3">
              <span class="text-sm font-bold text-sand-400 dark:text-sand-500 w-6 text-right shrink-0 pt-0.5">{i + 1}</span>
              <div class="flex-1 min-w-0 space-y-2">
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <a href={countryHref(row.country)} class="font-heading font-bold text-sand-800 dark:text-sand-100 hover:text-terracotta-500 dark:hover:text-terracotta-400 underline decoration-sand-300 dark:decoration-sand-600 underline-offset-2">
                    {getLocalizedCountryName(row.country, lang)}
                  </a>
                  <span class="text-xs text-sand-500 dark:text-sand-400 whitespace-nowrap">
                    {copy.labelSpread} {row.spread} · {copy.labelMedian} {row.median}
                  </span>
                </div>
                <LevelDistributionBars counts={counts} total={row.n} shortLabels={copy.levelShortLabels} groupLabel={groupLabel} />
                <p class="text-sm text-sand-700 dark:text-sand-300 leading-relaxed">{sentence}</p>
                {row.outliers.length > 0 && (
                  <p class="text-xs text-sand-500 dark:text-sand-400 flex flex-wrap items-center gap-1.5">
                    <span class="font-medium text-sand-600 dark:text-sand-300">{copy.labelOutliers}:</span>
                    {row.outliers.map((o) => (
                      <span class="inline-flex items-center gap-1">
                        <LevelBadge level={o.level} lang={lang} compact />
                        {resolveGovName(o.code)}
                      </span>
                    ))}
                  </p>
                )}
                {row.outliers.length === 0 && (
                  <p class="text-xs text-sand-400 dark:text-sand-500 italic">{copy.noOutliers}</p>
                )}
              </div>
            </div>
          </li>
        );
      })}
    </ol>

    <section class="max-w-2xl mx-auto space-y-3 pt-4">
      <h2 class="text-xl font-heading font-bold text-sand-800 dark:text-sand-100">{copy.whyTitle}</h2>
      {copy.whyParagraphs.map((p) => (
        <p class="text-base text-sand-700 dark:text-sand-300 leading-relaxed">{p}</p>
      ))}
    </section>

    <p class="max-w-2xl mx-auto text-sm text-sand-500 dark:text-sand-400 text-center">
      {copy.methodologyNote.split('{link}')[0]}<a href={methodologyUrl} class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">{copy.methodologyLinkText}</a>{copy.methodologyNote.split('{link}')[1]}
    </p>

    <section class="pt-6 border-t border-sand-200 dark:border-sand-700 max-w-2xl mx-auto text-center">
      <a href={hubUrl} class="text-sm font-medium text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">
        {govCopy.breadcrumbLabel}
      </a>
    </section>
  </div>
</Base>
