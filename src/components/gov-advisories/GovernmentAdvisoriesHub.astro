---
// Hub page for the government-advisories feature (VISIBILITY-BRIEF Task A.1):
// one row per issuing government that clears the coverage floor, computed
// live from today's snapshot — see src/lib/advisory-views.ts for why the
// "most/least restrictive" comparison is NOT a raw average of each
// government's own published levels (that would just reward governments that
// only publish escalated countries).
import type { ScoredCountry } from '../../pipeline/types';
import type { Lang } from '../../i18n/ui';
import type { AdvisoryCode } from '../../pipeline/scoring/engine';
import { routes } from '../../i18n/ui';
import { useTranslations } from '../../i18n/utils';
import Base from '../../layouts/Base.astro';
import Breadcrumb from '../Breadcrumb.astro';
import { getLocalizedCountryName } from '../../lib/scores';
import { getLastmodMap } from '../../lib/lastmod';
import {
  buildWebPageJsonLd,
  buildItemListJsonLd, VISIBILITY_PAGES_PUBLISHED } from '../../lib/seo';
import {
  getEligibleIssuers,
  getIssuerCountry,
  getIssuerIso3,
  getIssuerLatestUpdateDate,
  getMostAndLeastRestrictiveIssuers,
} from '../../lib/advisory-views';
import { governmentAdvisoriesCopy } from '../../i18n/government-advisories-copy';
import { governmentsDisagreeCopy } from '../../i18n/governments-disagree-copy';
import { ADVISORY_LEVEL_COLOR } from '../../lib/advisory-level-colors';

interface Props {
  lang: Lang;
  countries: ScoredCountry[];
}

const { lang, countries } = Astro.props;
const t = useTranslations(lang);
const r = routes[lang];
const copy = governmentAdvisoriesCopy[lang];
const disagreeCopy = governmentsDisagreeCopy[lang]; // for the cross-link to the sister page only

const eligible = getEligibleIssuers(countries);
const eligibleCodes = eligible.map((e) => e.code);
const { mostRestrictive, leastRestrictive } = getMostAndLeastRestrictiveIssuers(countries, eligibleCodes);

const lm = getLastmodMap();
const snapshotDate = lm.snapshotDate.slice(0, 10);
const dateFormatter = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'long', day: 'numeric' });
const shortDateFormatter = new Intl.DateTimeFormat(lang, { year: 'numeric', month: 'short', day: 'numeric' });

interface Row {
  code: AdvisoryCode;
  govName: string;
  agencyName: string;
  iso3: string;
  href: string;
  coverage: number;
  byLevel: Record<1 | 2 | 3 | 4, number>;
  latestUpdate: string | null;
}

const rows: Row[] = eligible
  .map((issuer) => {
    const issuerCountry = getIssuerCountry(countries, issuer.code);
    const iso3 = getIssuerIso3(issuer.code);
    if (!issuerCountry || !iso3) return null; // defensive: every eligible issuer resolves in the live dataset
    return {
      code: issuer.code,
      govName: getLocalizedCountryName(issuerCountry, lang),
      agencyName: t(`country.advisory.${issuer.code}` as any),
      iso3: iso3.toLowerCase(),
      href: `/${lang}/${r['government-advisories']}/${iso3.toLowerCase()}/`,
      coverage: issuer.total,
      byLevel: issuer.byLevel,
      latestUpdate: getIssuerLatestUpdateDate(countries, issuer.code),
    };
  })
  .filter((row): row is Row => row !== null);

function resolveGovName(code: string): string {
  const c = getIssuerCountry(countries, code);
  return c ? getLocalizedCountryName(c, lang) : code.toUpperCase();
}

const title = copy.hub.title.replace('{count}', String(rows.length));
const description = copy.hub.description.replace('{count}', String(rows.length));
const canonicalUrl = `https://isitsafetotravel.org/${lang}/${r['government-advisories']}/`;
const disagreeUrl = `/${lang}/${r['governments-disagree']}/`;
const methodologyUrl = `/${lang}/${r.methodology}/`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    buildWebPageJsonLd(title, description, canonicalUrl, lang, snapshotDate, VISIBILITY_PAGES_PUBLISHED),
    // BreadcrumbList is NOT duplicated here: <Breadcrumb> below already emits
    // its own standalone BreadcrumbList JSON-LD script (see Breadcrumb.astro)
    // -- same convention as HubPageLayout.astro and the country page, neither
    // of which re-declares it in their own @graph.
    buildItemListJsonLd(
      title,
      description,
      canonicalUrl,
      rows.map((row) => ({ name: `${row.govName} — ${row.agencyName}`, url: `https://isitsafetotravel.org${row.href}` })),
      'descending', // by coverage, the row order already reflects
    ),
  ],
};

const LEVEL_COLS: Array<{ level: 1 | 2 | 3 | 4; label: string }> = [
  { level: 4, label: copy.hub.colLevel4 },
  { level: 3, label: copy.hub.colLevel3 },
  { level: 2, label: copy.hub.colLevel2 },
  { level: 1, label: copy.hub.colLevel1 },
];
---

<Base lang={lang} title={title} description={description} jsonLd={jsonLd} ogImage="/og/default.png">
  <div class="max-w-5xl mx-auto px-4 py-8 space-y-8">
    <Breadcrumb lang={lang} items={[
      { label: t('nav.home'), href: `/${lang}/` },
      { label: copy.breadcrumbLabel, href: '' },
    ]} />

    <header class="text-center space-y-3">
      <h1 class="text-3xl md:text-4xl font-heading font-bold text-sand-800 dark:text-sand-100">
        {title}
      </h1>
      <p class="text-sm text-sand-600 dark:text-sand-400">
        {copy.hub.updatedDaily.replace('{count}', String(rows.length)).replace('{date}', dateFormatter.format(new Date(snapshotDate)))}
      </p>
    </header>

    <div class="max-w-2xl mx-auto space-y-4 text-base text-sand-700 dark:text-sand-300 leading-relaxed">
      <p>{copy.hub.intro1}</p>
      <p>
        {copy.hub.intro2.split('{link}')[0]}<a href={methodologyUrl} class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">{copy.methodologyLinkText}</a>{copy.hub.intro2.split('{link}')[1]}
      </p>
    </div>

    {(mostRestrictive || leastRestrictive) && (
      <section class="max-w-2xl mx-auto rounded-lg border border-sand-200 dark:border-sand-700 bg-white dark:bg-sand-800 px-5 py-4 space-y-2 text-sm text-sand-700 dark:text-sand-300">
        {mostRestrictive ? (
          <p>{copy.hub.mostRestrictive.replace('{government}', resolveGovName(mostRestrictive.code))}</p>
        ) : (
          <p>{copy.hub.insufficientRestrictivenessData}</p>
        )}
        {leastRestrictive && leastRestrictive.code !== mostRestrictive?.code && (
          <p>{copy.hub.leastRestrictive.replace('{government}', resolveGovName(leastRestrictive.code))}</p>
        )}
      </section>
    )}

    <section class="overflow-x-auto rounded-lg border border-sand-200 dark:border-sand-700">
      <table class="w-full min-w-[720px] text-sm border-collapse">
        <caption class="sr-only">{copy.hub.tableCaption}</caption>
        <thead>
          <tr class="bg-sand-100 dark:bg-sand-800 text-left">
            <th scope="col" class="px-3 py-2 font-semibold text-sand-700 dark:text-sand-200">{copy.hub.colGovernment}</th>
            <th scope="col" class="px-3 py-2 font-semibold text-sand-700 dark:text-sand-200">{copy.hub.colAgency}</th>
            {LEVEL_COLS.map((col) => (
              <th scope="col" class="px-3 py-2 font-semibold text-sand-700 dark:text-sand-200 text-right whitespace-nowrap">
                <span class="inline-block w-2 h-2 rounded-full mr-1 align-middle" style={`background-color: ${ADVISORY_LEVEL_COLOR[col.level]};`} aria-hidden="true" />
                {col.label}
              </th>
            ))}
            <th scope="col" class="px-3 py-2 font-semibold text-sand-700 dark:text-sand-200 text-right whitespace-nowrap">{copy.hub.colCoverage}</th>
            <th scope="col" class="px-3 py-2 font-semibold text-sand-700 dark:text-sand-200 whitespace-nowrap">{copy.hub.colUpdated}</th>
            <th scope="col" class="px-3 py-2 font-semibold text-sand-700 dark:text-sand-200">
              <span class="sr-only">{copy.hub.colAction}</span>
            </th>
          </tr>
        </thead>
        <tbody>
          {rows.map((row, i) => (
            <tr class={`border-t border-sand-200 dark:border-sand-700 ${i % 2 === 1 ? 'bg-sand-50/60 dark:bg-sand-900/40' : ''}`}>
              <th scope="row" class="px-3 py-2 font-medium text-sand-800 dark:text-sand-100 whitespace-nowrap">
                <a href={row.href} class="hover:text-terracotta-500 dark:hover:text-terracotta-400 underline decoration-sand-300 dark:decoration-sand-600 underline-offset-2">
                  {row.govName}
                </a>
              </th>
              <td class="px-3 py-2 text-sand-600 dark:text-sand-300">{row.agencyName}</td>
              {LEVEL_COLS.map((col) => (
                <td class="px-3 py-2 text-right tabular-nums text-sand-700 dark:text-sand-300">{row.byLevel[col.level]}</td>
              ))}
              <td class="px-3 py-2 text-right tabular-nums font-semibold text-sand-800 dark:text-sand-100">{row.coverage}</td>
              <td class="px-3 py-2 text-sand-600 dark:text-sand-400 whitespace-nowrap">
                {row.latestUpdate ? shortDateFormatter.format(new Date(row.latestUpdate)) : copy.hub.noDate}
              </td>
              <td class="px-3 py-2 text-right whitespace-nowrap">
                <a href={row.href} class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline text-xs font-medium">
                  {copy.hub.colAction}
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>

    <p class="max-w-2xl mx-auto text-sm text-sand-600 dark:text-sand-400 text-center">
      {copy.methodologyNote.split('{link}')[0]}<a href={methodologyUrl} class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">{copy.methodologyLinkText}</a>{copy.methodologyNote.split('{link}')[1]}
    </p>

    <section class="pt-6 border-t border-sand-200 dark:border-sand-700 max-w-2xl mx-auto text-center">
      <a href={disagreeUrl} class="text-sm font-medium text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">
        {disagreeCopy.title}
      </a>
    </section>
  </div>
</Base>
