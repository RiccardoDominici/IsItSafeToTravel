---
import type { Lang } from '../i18n/ui';
import { useTranslations, getAlternateLinks, getLocalizedPath } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/fonts.css';
import '../styles/global.css';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
}

const { lang, title, description, jsonLd, ogImage, ogType, noindex } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ? `${title} | IsItSafeToTravel` : t('site.title');
const pageDescription = description || t('site.description');
const currentPath = Astro.url.pathname;
const alternateLinks = getAlternateLinks(currentPath);
const canonicalUrl = new URL(currentPath, Astro.site);
const xDefaultHref = new URL(getLocalizedPath(currentPath, 'en'), Astro.site);
const resolvedOgImage = ogImage ? new URL(ogImage, Astro.site).href : null;
const resolvedOgType = ogType || 'website';
---

<!doctype html>
<html lang={lang} class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f8f5ee" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#190f0a" />
    <meta name="yandex-verification" content="d3ec07bc73fe3dcf" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl.href} />

    <!-- hreflang tags for i18n SEO -->
    {alternateLinks.map(({ lang: altLang, href }) => (
      <link
        rel="alternate"
        hreflang={altLang}
        href={new URL(href, Astro.site).href}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {resolvedOgImage && (
      <>
        <meta property="og:image" content={resolvedOgImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:alt" content={pageTitle} />
      </>
    )}
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:locale" content={{ en: 'en_US', it: 'it_IT', es: 'es_ES', fr: 'fr_FR', pt: 'pt_BR', zh: 'zh_CN', de: 'de_DE' }[lang]} />
    <meta property="og:site_name" content="IsItSafeToTravel" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content={resolvedOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {resolvedOgImage && (
      <>
        <meta name="twitter:image" content={resolvedOgImage} />
        <meta name="twitter:image:alt" content={pageTitle} />
      </>
    )}

    <!-- Search engine directives -->
    {noindex
      ? <meta name="robots" content="noindex, follow" />
      : <meta name="robots" content="max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

    <!-- Resource hints: warm up DNS for deferred third-party origins -->
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://storage.ko-fi.com" />

    <!-- Preload critical assets -->
    <link rel="preload" href="/favicon.svg" as="image" type="image/svg+xml" />
    <link rel="preload" href={interLatinWoff2} as="font" type="font/woff2" crossorigin />

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Dark mode detection (inline to prevent FOUC) -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (stored === 'light') {
          document.documentElement.classList.add('light');
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>

    <!-- Speculation Rules: prefetch internal links on hover/pointerdown (Chrome-only progressive enhancement) -->
    <script type="speculationrules" is:inline set:html={JSON.stringify({ prefetch: [{ where: { and: [{ href_matches: '/*' }] }, eagerness: 'moderate' }] })} />
  </head>
  <body class="bg-sand-50 text-sand-900 dark:bg-sand-900 dark:text-sand-50 font-sans min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-terracotta-500 focus:text-white focus:px-4 focus:py-2 focus:rounded focus:text-sm focus:font-semibold">
      Skip to content
    </a>
    <Header lang={lang} currentPath={currentPath} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <!--
      Deferred third-party loader: Microsoft Clarity + Ko-fi.
      Fires on the first user interaction OR when the main thread goes idle
      (whichever comes first), keeping both off the critical render path.
      NOTE: the Travelpayouts sitewide script (tp-em.com) was intentionally
      removed — it injected a dashboard-controlled floating "cheap flights"
      promo banner we don't want. Affiliate attribution still works via the
      ?marker= param on every link (see src/config/affiliate.ts).
    -->
    <script is:inline define:vars={{ donateButtonText: t('nav.donate') }}>
      (function () {
        var loaded = false;
        function loadThirdParty() {
          if (loaded) return;
          loaded = true;

          // Microsoft Clarity (privacy-first analytics)
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1; t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, "clarity", "script", "w2va23mnes");

          // Ko-fi floating donate button (defensive guard against blocked CDN)
          var kofi = document.createElement('script');
          kofi.src = 'https://storage.ko-fi.com/cdn/scripts/overlay-widget.js';
          function initKofi() {
            if (typeof kofiWidgetOverlay !== 'undefined' && typeof kofiWidgetOverlay.draw === 'function') {
              try {
                kofiWidgetOverlay.draw('isitsafetotravel', {
                  'type': 'floating-chat',
                  'floating-chat.donateButton.text': donateButtonText,
                  'floating-chat.donateButton.background-color': '#ffffff',
                  'floating-chat.donateButton.text-color': '#323842'
                });
              } catch (_) {
                /* no-op: ko-fi widget failed to initialize */
              }
            }
          }
          kofi.addEventListener('load', initKofi);
          kofi.addEventListener('error', function () {
            /* silent no-op: ko-fi CDN blocked or failed to load */
          });
          document.head.appendChild(kofi);
        }

        var events = ['pointerdown', 'keydown', 'touchstart', 'scroll'];
        var opts = { once: true, passive: true, capture: true };
        function onFirstInteraction() {
          events.forEach(function (e) { window.removeEventListener(e, onFirstInteraction, opts); });
          loadThirdParty();
        }
        events.forEach(function (e) { window.addEventListener(e, onFirstInteraction, opts); });

        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadThirdParty, { timeout: 5000 });
        } else {
          setTimeout(loadThirdParty, 3000);
        }
      })();
    </script>
    <script>
      import '../scripts/pillar-coverage-tip';
    </script>
  </body>
</html>
