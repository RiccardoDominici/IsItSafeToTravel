---
import type { Lang } from '../i18n/ui';
import { useTranslations, getAlternateLinks, getLocalizedPath } from '../i18n/utils';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '@fontsource-variable/inter';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  jsonLd?: Record<string, unknown>;
  ogImage?: string;
  ogType?: string;
}

const { lang, title, description, jsonLd, ogImage, ogType } = Astro.props;
const t = useTranslations(lang);

const pageTitle = title ? `${title} | IsItSafeToTravel` : t('site.title');
const pageDescription = description || t('site.description');
const currentPath = Astro.url.pathname;
const alternateLinks = getAlternateLinks(currentPath);
const canonicalUrl = new URL(currentPath, Astro.site);
const xDefaultHref = new URL(getLocalizedPath(currentPath, 'en'), Astro.site);
const resolvedOgImage = ogImage ? new URL(ogImage, Astro.site).href : null;
const resolvedOgType = ogType || 'website';
---

<!doctype html>
<html lang={lang} class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1a1a2e" />
    <meta name="yandex-verification" content="d3ec07bc73fe3dcf" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl.href} />

    <!-- hreflang tags for i18n SEO -->
    {alternateLinks.map(({ lang: altLang, href }) => (
      <link
        rel="alternate"
        hreflang={altLang}
        href={new URL(href, Astro.site).href}
      />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref.href} />

    <!-- Open Graph -->
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}
    <meta property="og:url" content={canonicalUrl.href} />
    <meta property="og:type" content={resolvedOgType} />
    <meta property="og:locale" content={{ en: 'en_US', it: 'it_IT', es: 'es_ES', fr: 'fr_FR', pt: 'pt_BR', zh: 'zh_CN', de: 'de_DE' }[lang]} />
    <meta property="og:site_name" content="IsItSafeToTravel" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content={resolvedOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

    <!-- Search engine directives -->
    <meta name="robots" content="max-snippet:-1, max-image-preview:large, max-video-preview:-1" />

    <!-- Preload critical assets -->
    <link rel="preload" href="/favicon.svg" as="image" type="image/svg+xml" />

    <!-- Resource hints: warm DNS for third-party origins that are loaded lazily
         (analytics, monetization, donate widget) without blocking the critical path -->
    <link rel="dns-prefetch" href="https://www.clarity.ms" />
    <link rel="dns-prefetch" href="https://tp-em.com" />
    <link rel="dns-prefetch" href="https://tp.media" />
    <link rel="dns-prefetch" href="https://storage.ko-fi.com" />

    <!-- JSON-LD Structured Data -->
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <!-- Dark mode detection (inline to prevent FOUC) -->
    <script is:inline>
      (function() {
        const stored = localStorage.getItem('theme');
        if (stored === 'dark') {
          document.documentElement.classList.add('dark');
        } else if (stored === 'light') {
          document.documentElement.classList.add('light');
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-sand-50 text-sand-900 dark:bg-sand-900 dark:text-sand-50 font-sans min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-terracotta-500 focus:text-white focus:px-4 focus:py-2 focus:rounded focus:text-sm focus:font-semibold">
      Skip to content
    </a>
    <Header lang={lang} currentPath={currentPath} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer lang={lang} />
    <!-- Deferred third-party scripts (analytics + monetization + donate widget).
         Loaded on browser idle or first user interaction — whichever comes first —
         to keep them off the critical rendering path and protect Core Web Vitals. -->
    <script is:inline define:vars={{ donateButtonText: t('nav.donate') }}>
      (function () {
        var loaded = false;
        function loadThirdParty() {
          if (loaded) return;
          loaded = true;

          // Microsoft Clarity analytics
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "w2va23mnes");

          // Travelpayouts
          var tp = document.createElement('script');
          tp.async = 1;
          tp.src = 'https://tp-em.com/NTI2MDkz.js?t=526093';
          document.head.appendChild(tp);

          // Ko-fi floating donate widget (guarded against blocked/failed CDN load)
          var kofi = document.createElement('script');
          kofi.async = 1;
          kofi.src = 'https://storage.ko-fi.com/cdn/scripts/overlay-widget.js';
          kofi.addEventListener('load', function () {
            if (typeof kofiWidgetOverlay !== 'undefined' && typeof kofiWidgetOverlay.draw === 'function') {
              try {
                kofiWidgetOverlay.draw('isitsafetotravel', {
                  'type': 'floating-chat',
                  'floating-chat.donateButton.text': donateButtonText,
                  'floating-chat.donateButton.background-color': '#ffffff',
                  'floating-chat.donateButton.text-color': '#323842'
                });
              } catch (_) {
                /* no-op: ko-fi widget failed to initialize */
              }
            }
          });
          kofi.addEventListener('error', function () {
            /* silent no-op: ko-fi CDN blocked or failed to load */
          });
          document.head.appendChild(kofi);
        }

        // Trigger on first interaction (whichever event fires first)...
        var events = ['scroll', 'pointerdown', 'keydown', 'touchstart'];
        function onInteraction() {
          loadThirdParty();
          events.forEach(function (e) { window.removeEventListener(e, onInteraction); });
        }
        events.forEach(function (e) { window.addEventListener(e, onInteraction, { passive: true }); });

        // ...or when the browser goes idle, with a safety-net timeout.
        if ('requestIdleCallback' in window) {
          requestIdleCallback(loadThirdParty, { timeout: 5000 });
        } else {
          setTimeout(loadThirdParty, 3000);
        }
      })();
    </script>
    <script>
      import '../scripts/pillar-coverage-tip';
    </script>
  </body>
</html>
