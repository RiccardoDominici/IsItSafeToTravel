---
export const prerender = true;

// Country page (fr). Data and body are shared by the 7 localized routes
// (src/lib/country-page.ts, src/components/country/CountryPageBody.astro); this file keeps only
// what is per-locale: the <title>.
import type { GetStaticPaths } from 'astro';
import Base from '../../../layouts/Base.astro';
import CountryPageBody from '../../../components/country/CountryPageBody.astro';
import { buildCountryPagePaths, type CountryPageProps } from '../../../lib/country-page';
import { getLocalizedCountryName } from '../../../lib/scores';
import { buildCountryJsonLd, buildCountryMetaDescription } from '../../../lib/seo';
import { getLastmodMap } from '../../../lib/lastmod';
import { officialScore } from '../../../lib/score-status';
import { getCountryPageTitle } from '../../../i18n/country-title';
import { greyTitleSuffix } from '../../../i18n/grey-copy';
import type { Lang } from '../../../i18n/ui';

const lang: Lang = 'fr';

export const getStaticPaths: GetStaticPaths = async () => {
  return buildCountryPagePaths();
};

// getStaticPaths props are not inferred by astro check — cast once to the declared
// props type so every downstream component receives properly typed values.
const props = Astro.props as unknown as CountryPageProps;
const { country } = props;
const name = getLocalizedCountryName(country, lang);
const description = buildCountryMetaDescription(country, lang);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
// JSON-LD dateModified must match the visible "Last update" line, which renders
// lm.snapshotDate (the daily pipeline recompute date). The per-country smart
// lastmod (lm.countries) is a crawl hint that stays sitemap-only (2026-08 SEO audit).
const dateModified = getLastmodMap().snapshotDate.slice(0, 10);
const jsonLd = buildCountryJsonLd(country, lang, canonicalUrl, dateModified);
// Title per locale (article, preposition and verb agreement for every place) — built and tested in
// src/i18n/country-title.ts, so all 248 x 7 titles can be proofread at once.
const title = getCountryPageTitle(lang, country.iso3, name, officialScore(country), greyTitleSuffix(lang, country));
---
<Base lang={lang} title={title} brandSuffix={false} description={description} jsonLd={jsonLd} ogImage={`/og/country-${country.iso3.toLowerCase()}.png`} >
  <CountryPageBody {...props} lang={lang} canonicalUrl={canonicalUrl} />
</Base>
