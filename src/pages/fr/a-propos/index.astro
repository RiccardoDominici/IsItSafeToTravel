---
export const prerender = true;
import Base from '../../../layouts/Base.astro';
import { useTranslations } from '../../../i18n/utils';
import type { Lang } from '../../../i18n/ui';
import { routes } from '../../../i18n/ui';
import { aboutCopy } from '../../../i18n/about-copy';
import { buildWebPageJsonLd, buildPersonJsonLd, buildBreadcrumbJsonLd } from '../../../lib/seo';
import { CONTACT_EMAIL } from '../../../lib/contact';

const lang: Lang = 'fr';
const t = useTranslations(lang);
const r = routes[lang];
const c = aboutCopy[lang];
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const siteUrl = 'https://isitsafetotravel.org';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { ...buildWebPageJsonLd(c.title, c.description, canonicalUrl, lang), '@context': undefined },
    { ...buildPersonJsonLd(), '@context': undefined },
    { ...buildBreadcrumbJsonLd([
      { name: t('nav.home'), url: `${siteUrl}/${lang}/` },
      { name: t('nav.about'), url: canonicalUrl },
    ]), '@context': undefined },
  ],
};

// {link}-token paragraphs (see about-copy.ts), pre-split so the markup below
// stays a thin render with no string logic in the template body.
const [sourcesBefore, sourcesAfter] = c.sourcesText.split('{link}');
const [dataCodeBefore, dataCodeAfter] = c.dataCodeText.split('{link}');
const [whoRunsBefore, whoRunsAfter] = c.whoRunsItText.split('{link}');
const [contactBefore, contactAfter] = c.contactText.split('{link}');
const [feedbackBefore, feedbackAfter] = c.contactFeedback.split('{link}');
---
<Base lang={lang} title={c.title} description={c.description} jsonLd={jsonLd} ogImage="/og/default.png">
  <div class="max-w-3xl mx-auto px-4 py-8 space-y-6">
    <h1 class="text-3xl font-heading font-bold text-sand-900 dark:text-sand-50 mb-8">{c.heading}</h1>

    <section>
      <h2 class="text-xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">{c.projectTitle}</h2>
      <p class="text-sand-600 dark:text-sand-300 leading-relaxed">{c.projectText}</p>
    </section>

    <section>
      <h2 class="text-xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">{c.missionTitle}</h2>
      <p class="text-sand-600 dark:text-sand-300 leading-relaxed">{c.missionText}</p>
    </section>

    <section>
      <h2 class="text-xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">{c.howItWorksTitle}</h2>
      <p class="text-sand-600 dark:text-sand-300 leading-relaxed">{c.howItWorksText}</p>
    </section>

    <section>
      <h2 class="text-xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">{c.sourcesTitle}</h2>
      <p class="text-sand-600 dark:text-sand-300 leading-relaxed">
        {sourcesBefore}<a href={`/${lang}/${r.methodology}/`} class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">{c.methodologyLinkText}</a>{sourcesAfter}
      </p>
    </section>

    <section>
      <h2 class="text-xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">{c.dataCodeTitle}</h2>
      <p class="text-sand-600 dark:text-sand-300 leading-relaxed">
        {dataCodeBefore}<a href="https://github.com/RiccardoDominici/IsItSafeToTravel" target="_blank" rel="noopener noreferrer" class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">GitHub</a>{dataCodeAfter}
      </p>
    </section>

    <section>
      <h2 class="text-xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">{c.correctionsTitle}</h2>
      <p class="text-sand-600 dark:text-sand-300 leading-relaxed">{c.correctionsText}</p>
    </section>

    <section>
      <h2 class="text-xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">{c.whoRunsItTitle}</h2>
      <p class="text-sand-600 dark:text-sand-300 leading-relaxed">
        {whoRunsBefore}<a href="https://github.com/RiccardoDominici" target="_blank" rel="noopener noreferrer" class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">{c.authorName}</a>{whoRunsAfter}
      </p>
    </section>

    <section>
      <h2 class="text-xl font-heading font-bold text-sand-800 dark:text-sand-100 mb-3">{c.contactTitle}</h2>
      <p class="text-sand-600 dark:text-sand-300 leading-relaxed mb-3">
        {contactBefore}<a href="https://github.com/RiccardoDominici/IsItSafeToTravel/issues" target="_blank" rel="noopener noreferrer" class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">{c.githubIssuesText}</a>{contactAfter}
      </p>
      <p class="text-sand-600 dark:text-sand-300 leading-relaxed">
        {feedbackBefore}<a href={`/${lang}/${r.feedback}/`} class="text-terracotta-500 hover:text-terracotta-600 dark:text-terracotta-400 underline">{c.feedbackLinkText}</a>{feedbackAfter}
      </p>
      <p class="text-xs text-sand-600 dark:text-sand-400">{c.contactEmailLabel}: <a href={`mailto:${CONTACT_EMAIL}`} class="hover:underline">{CONTACT_EMAIL}</a></p>
    </section>
  </div>
</Base>
