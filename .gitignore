# Dependencies
node_modules/

# Build output
dist/

# Astro generated types
.astro/

# Environment variables
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Cloudflare
.wrangler/
.dev.vars

# IndexNow URL->hash manifest (scripts/indexnow/submit-changed.sh) — a CI
# working file persisted across runs via actions/cache, never committed.
.indexnow/

# Monthly data-release assets (scripts/generate-data-release.ts /
# .github/workflows/data-release.yml) — built fresh each run, attached to a
# GitHub Release, never committed to the repo itself.
release-assets/

# Logs
*.log
npm-debug.log*

# Pipeline raw data temp files
data/raw/**/*.tmp
data/raw/**/*.partial
# V-Dem raw CSV downloads (we cache parsed JSON only; never commit raw CSV)
data/raw/**/*.csv
# INFORM workbook: stored once under data/raw/inform/ (formula v10). The per-date
# copies were 757 identical 2.2 MB files; this rule keeps them from coming back.
data/raw/*/inform.xlsx

# Legal research (local only, not published)
.legal-research/

# Claude Code: share settings.json + hooks, keep local/runtime state out
.claude/worktrees/
.claude/scheduled_tasks.lock
.claude/settings.local.json

# Generated OG images (built at deploy time)
public/og/

# Search engine indexing debug data (local only)
Indicizzazione Google/
Indicizzazione Bing/

# Playwright MCP scratch output
.playwright-mcp/

# SEO working notes (local only — GSC data, audit, backlink/outreach strategy; not for the public repo)
SEO-*.md
