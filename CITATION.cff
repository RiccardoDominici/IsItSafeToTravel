# This CITATION.cff follows the Citation File Format (https://citation-file-format.github.io/).
# GitHub renders it as a "Cite this repository" widget on the repo's main page.
# It is hand-maintained (like LICENSE), not generated by the pipeline — the
# `preferred-citation` below intentionally has no pinned data-revision number,
# since that value changes almost every day (see src/pipeline/config/data-revision.ts);
# cite the access date instead, as the notes field says.
cff-version: 1.2.0
message: "If you use this software, please cite it as below. If you use the travel-safety dataset it publishes, please use the preferred-citation entry instead."
type: software
title: "IsItSafeToTravel"
version: "0.0.1"
date-released: "2026-09-26"
license: MIT
repository-code: "https://github.com/RiccardoDominici/IsItSafeToTravel"
url: "https://isitsafetotravel.org"
abstract: >-
  Free, open-source travel-safety platform. Daily-updated safety scores for
  248 countries, computed from government travel advisories and public
  indices (Global Peace Index, World Bank, INFORM, UCDP), across five
  weighted pillars: conflict, crime, health, governance, and environment.
keywords:
  - travel-safety
  - open-data
  - dataset
  - travel-advisories
  - astro
authors:
  - family-names: "Dominici"
    given-names: "Riccardo"
preferred-citation:
  type: data
  title: "IsItSafeToTravel: Global Travel Safety Scores"
  authors:
    - family-names: "Dominici"
      given-names: "Riccardo"
  date-released: "2026-09-26"
  license: "CC-BY-NC-4.0"
  url: "https://isitsafetotravel.org/scores.json"
  repository: "https://isitsafetotravel.org/en/api/"
  notes: >-
    Updated daily; cite the date you accessed the data, not this file's
    date-released. Machine-readable formats: JSON at
    https://isitsafetotravel.org/scores.json, CSV at
    https://isitsafetotravel.org/scores.csv. Ready-made citation strings
    (plain text, HTML, Markdown, APA, MLA, BibTeX) for the whole dataset or a
    single country: https://isitsafetotravel.org/en/cite-this-data/.
